# --- Database --------------------------------------------------------------
# DB_DATABASE and DB_USERNAME MUST stay `loghq`. config/cloud.ts hardcodes
# `name: 'loghq', username: 'loghq'` when it provisions Postgres, and only the
# password is read from this file. Change these and the app connects to a
# database that was never created.
#
# DB_PASSWORD is authoritative: ts-cloud runs CREATE ROLE ... LOGIN PASSWORD on
# a new box and ALTER ROLE ... LOGIN PASSWORD on an existing one, so whatever
# you put here becomes the real Postgres password, and changing it later plus
# redeploying updates Postgres rather than drifting from it.
#
# Postgres runs on the same box, so the host is loopback.
DB_CONNECTION="encrypted:v2:eyJ2IjoyLCJlcGsiOiJNQ293QlFZREsyVnVBeUVBOG15c0JNenVrZVNuV0FlQkpMQUY3bVpkMzRnYnloV1RWeDhQNkFlbGVBVSIsInNhbHQiOiJqbFVyN3Byemd6dEw3VjdTSVp6X0h3Iiwibm9uY2UiOiIwY1hOTnc3MnlJek1NQjZYIiwiY2lwaGVydGV4dCI6Ik45SnpuRUZyIiwidGFnIjoiY0NZMUNzWjY4QTZTZXZyeEw2S1M2QSJ9"
