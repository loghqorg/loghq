#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/       versioned X25519 encryption for .env files         /
#/       [how it works](https://stacksjs.com/encryption)   /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_PRODUCTION="x25519-public:MCowBQYDK2VuAyEA3wjw-YxEXCK9pl5uME9QD_cEabMDARd1e0wSdRxbC2o"

# ---------------------------------------------------------------------------
# loghq — production environment
#
# HOW THIS FILE WORKS
#   1. Fill in every REPLACE_ME below with a real value.
#   2. ./buddy key:generate                       (writes a real APP_KEY)
#   3. ./buddy env:encrypt --file .env.production (encrypts every value here,
#      adds DOTENV_PUBLIC_KEY_PRODUCTION, and appends the private half to
#      .env.keys)
#   4. Commit this file. It is deliberately un-ignored in .gitignore, and it is
#      safe to commit ONLY once step 3 has encrypted it.
#   5. Never commit .env.keys. Copy DOTENV_PRIVATE_KEY_PRODUCTION out of it into
#      the GitHub `production` environment secret of the same name.
#
# ./buddy env:check --file .env.production --strict  fails if anything here is
# still plaintext once the file is committed.
# ---------------------------------------------------------------------------

