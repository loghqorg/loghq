<script server>
// Static imports — see login.stx for why a dynamic one inside the action loads
// a sibling project's package. `db as __db` per ch.5.8: it is an object, so
// without the prefix it is a server→client bridge candidate.
import { Auth } from '@stacksjs/auth'
import { db as __db } from '@stacksjs/database'
// Shared with routes/projects.ts so the two callers cannot drift on how an id
// or an ingest key is minted.
import { newIngestKey, newProjectId } from '../../../app/Support/projects'
useSeoMeta({
  title: 'New app - loghq',
  description: 'Create an app to get an ingest key and start streaming logs.',
  robots: 'noindex, nofollow',
})

// Server-side session check, replacing a client guard that navigated away
// after hydration. A logged-out visitor now gets an honest prompt in the first
// response instead of a create form that flashes and disappears.
const authed = !!cookies.loghq_token

// Resting values for what the action merges back.
let formError = ''
let values: { name?: string, platform?: string } = {}

// The page handles its own POST (stx#1847).
//
// Authenticates from the cookie the action is handed, rather than trusting the
// page render: a POST is its own request, and the session could have expired
// between drawing the form and submitting it.
const action = async ({ form, cookies: reqCookies }: { form: Record<string, string | string[]>, cookies: Record<string, string> }) => {
  const token = reqCookies.loghq_token || ''
  const user = token ? await Auth.getUserFromToken(token) : null
  if (!user)
    return { redirect: '/login' }

  const name = String(form.name ?? '').trim()
  const platform = String(form.platform ?? 'javascript').slice(0, 60)
  const kept = { name, platform }

  if (!name)
    return { formError: 'Give your app a name.', values: kept }
  if (name.length > 255)
    return { formError: 'That name is too long.', values: kept }

  // Two apps with the same name in one account is never what anyone meant, and
  // it is silently destructive: both render identically in every list, so the
  // key you paste into a config is a coin flip. Compared with lower() rather
  // than ILIKE, which is Postgres-only and this app also runs on SQLite (see
  // routes/logs.ts for the same reason).
  //
  // Scoped to the owner, not global: two accounts may both have an app called
  // "api" without either being wrong.
  const clash = (await __db.unsafe(
    'SELECT id FROM projects WHERE owner_id = $1 AND lower(name) = lower($2) LIMIT 1',
    [Number(user.id), name],
  ))?.[0]
  if (clash)
    return { formError: `You already have an app called "${name}".`, values: kept }

  const id = newProjectId(name)

  await __db.insertInto('projects').values({
    id,
    name,
    platform,
    ingest_key: newIngestKey(),
    owner_id: Number(user.id),
    is_active: true,
  }).execute()

  // Straight to the new project's settings, which is where the ingest key and
  // the install snippet are — the next thing you need after creating an app.
  return { redirect: `/settings?project=${encodeURIComponent(id)}` }
}
</script>

{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-md w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
    </div>

    <div class="mb-8 text-center">
      <h1 class="font-semibold text-xl tracking-tight">Create your first app</h1>
      <p class="mt-2 text-sm text-subtle">Each app gets its own log stream and ingest key.</p>
    </div>

    @if (!authed)
      {{-- Reached without a session. The client guard this replaces navigated
          away after hydration, so a logged-out visitor saw the form flash
          first; this is the honest answer in the first response. --}}
      <div class="px-3 py-3 text-sm rounded-lg err-box">You need to be signed in to create an app.</div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Go to sign in</StxLink>
      </p>
    @else
    {{-- Posts to itself; the action is in the server block. --}}
    <form action="/projects/new" method="POST" class="space-y-4">
      @if (formError)
        <div class="px-3 py-2 text-sm rounded-lg err-box">{{ formError }}</div>
      @endif

      <div>
        <label for="newapp-name" class="block mb-1.5 font-medium text-muted text-xs">App name</label>
        <input id="newapp-name" name="name" type="text" required autofocus placeholder="Acme Web" value="{{ values?.name || '' }}" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label for="newapp-platform" class="block mb-1.5 font-medium text-muted text-xs">Platform</label>
        <select id="newapp-platform" name="platform" class="px-3.5 py-2.5 w-full text-sm field">
          <option value="javascript">JavaScript / Browser</option>
          <option value="node">Node.js</option>
          <option value="react">React</option>
          <option value="vue">Vue</option>
          <option value="nuxt">Nuxt</option>
          <option value="stacks">Stacks</option>
          <option value="laravel">Laravel</option>
          <option value="php">PHP</option>
          <option value="other">Other</option>
        </select>
      </div>

      {{-- A plain button; no client mutation to bind a loading state to. --}}
      <button type="submit" class="py-2.5 w-full font-semibold text-sm btn-solid">Create app</button>
    </form>
    @endif
  </div>
</div>
@endsection
