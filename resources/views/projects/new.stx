<script server>
useSeoMeta({
  title: 'New app - loghq',
  description: 'Create an app to get an ingest key and start streaming logs.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Create-app screen. New users land here after signup. Creates a project via
// the authenticated API (bearer from localStorage), then drops into that
// project's dashboard, where the ingest snippet + key are shown.
const error = state('')
const loading = state(false)

function ensureAuthed(): void {
  // No mirror step any more: the cookie IS the session, so if the store has no
  // token there is nothing to copy from and nothing to reload for.
  if (!useStore('session').token())
    (navigate as StxNavigate)('/login', true)
}
ensureAuthed()

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  const name = form.elements.name.value.trim()
  if (!name) {
    error.set('Give your app a name.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/api/projects', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${useStore('session').token()}`,
      },
      body: JSON.stringify({ name, platform: form.elements.platform.value }),
    })
    const data = await res.json().catch(() => ({}))
    if (res.status === 401) {
      ;(navigate as StxNavigate)('/login', true)
      return
    }
    if (!res.ok) {
      error.set(data.error || 'Could not create the app.')
      loading.set(false)
      return
    }
    // Straight into the new project's Settings → Install, where the setup snippet lives.
    ;(navigate as StxNavigate)(`/settings?project=${encodeURIComponent(data.project.id)}`, true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>

<style>
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.field { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text); }
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.6; cursor: default; }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
</style>

<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-md w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
    </div>

    <div class="mb-8 text-center">
      <h1 class="font-semibold text-xl tracking-tight">Create your first app</h1>
      <p class="mt-2 text-sm text-subtle">Each app gets its own log stream and ingest key.</p>
    </div>

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
      @endif

      <div>
        <label class="block mb-1.5 font-medium text-muted text-xs">App name</label>
        <input name="name" type="text" required autofocus placeholder="Acme Web" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label class="block mb-1.5 font-medium text-muted text-xs">Platform</label>
        <select name="platform" class="px-3.5 py-2.5 w-full text-sm field">
          <option value="javascript">JavaScript / Browser</option>
          <option value="node">Node.js</option>
          <option value="react">React</option>
          <option value="vue">Vue</option>
          <option value="nuxt">Nuxt</option>
          <option value="laravel">Laravel</option>
          <option value="php">PHP</option>
          <option value="other">Other</option>
        </select>
      </div>

      <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
        {{ loading() ? 'Creating…' : 'Create app' }}
      </button>
    </form>
  </div>
</div>
