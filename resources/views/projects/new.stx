<script server>
useSeoMeta({
  title: 'New app - loghq',
  description: 'Create an app to get an ingest key and start streaming logs.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Create-app screen. New users land here after signup. Creates a project via
// the authenticated API, then drops into that
// project's dashboard, where the ingest snippet + key are shown.
const error = state('')

function ensureAuthed(): void {
  // No mirror step any more: the cookie IS the session, so if the store has no
  // token there is nothing to copy from and nothing to reload for.
  if (!useStore('session').token())
    navigate('/login', { reload: true })
}
ensureAuthed()

// No Authorization header here. The session store's configureFetch attaches the
// bearer to every data-primitive request, and its onResponseError owns the 401
// case — which is what the hand-written `if (res.status === 401) navigate(…)`
// branch used to do, once, in this file only.
//
// See login.stx for why `error` is a page signal and not the primitive's own.
const createProject = useMutation('/api/projects', {
  onError(err: { status?: number, data?: { error?: string } }) {
    // A 401 has already been handled by the interceptor, which clears the
    // session and leaves; saying anything here would paint over that.
    if (err.status === 401)
      return
    error.set(err.data?.error || 'Could not create the app.')
  },
  onSuccess(data: { project: { id: string } }) {
    // Straight into the new project's Settings → Install, where the setup
    // snippet lives.
    navigate(`/settings?project=${encodeURIComponent(data.project.id)}`, { reload: true })
  },
})

// The controls this handler reads. `platform` is a <select>, not an <input> —
// the distinction the compiler can now hold for us. See login.stx for why the
// type is declared inline rather than in types/app.d.ts.
interface NewProjectForm extends HTMLFormElement {
  elements: HTMLFormControlsCollection & {
    name: HTMLInputElement
    platform: HTMLSelectElement
  }
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (createProject.loading())
    return
  const form = e.target as NewProjectForm
  const name = form.elements.name.value.trim()
  if (!name) {
    error.set('Give your app a name.')
    return
  }
  error.set('')
  await createProject.mutate({ name, platform: form.elements.platform.value }).catch(() => {})
}
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-md w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
    </div>

    <div class="mb-8 text-center">
      <h1 class="font-semibold text-xl tracking-tight">Create your first app</h1>
      <p class="mt-2 text-sm text-subtle">Each app gets its own log stream and ingest key.</p>
    </div>

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="px-3 py-2 text-sm rounded-lg err-box">{{ error() }}</div>
      @endif

      <div>
        <label for="newapp-name" class="block mb-1.5 font-medium text-muted text-xs">App name</label>
        <input id="newapp-name" name="name" type="text" required autofocus placeholder="Acme Web" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label for="newapp-platform" class="block mb-1.5 font-medium text-muted text-xs">Platform</label>
        <select id="newapp-platform" name="platform" class="px-3.5 py-2.5 w-full text-sm field">
          <option value="javascript">JavaScript / Browser</option>
          <option value="node">Node.js</option>
          <option value="react">React</option>
          <option value="vue">Vue</option>
          <option value="nuxt">Nuxt</option>
          <option value="laravel">Laravel</option>
          <option value="php">PHP</option>
          <option value="other">Other</option>
        </select>
      </div>

      {{-- Static label + `:text`, never `{{ }}` in the body — see login.stx. --}}
      <button type="submit" :disabled="createProject.loading()" :text="createProject.loading() ? 'Creating…' : 'Create app'" class="py-2.5 w-full font-semibold text-sm btn-solid">Create app</button>
    </form>
  </div>
</div>
@endsection
