<script server>
// Projects list. Server-authenticates from the token cookie and shows the
// user's own apps; each links into its dashboard. New users (or logged-out
// visitors) are handled by the client guard at the bottom.
const { db } = await import('@stacksjs/database')

const token = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('loghq_token')) || ''
let user: AuthUser | null = null
if (token) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    user = await Auth.getUserFromToken(token)
  }
  catch { user = null }
}

let projects: ProjectRow[] = []
if (user) {
  projects = (await db.unsafe(
    'SELECT id, name, platform, ingest_key, created_at FROM projects WHERE owner_id = $1 ORDER BY created_at DESC NULLS LAST, id',
    [Number(user.id)],
  )) ?? []
}

function fromNow(iso: string | null | undefined): string {
  if (!iso) return ''
  const s = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000))
  if (s < 60) return 'just now'
  if (s < 3600) return Math.floor(s / 60) + 'm ago'
  if (s < 86400) return Math.floor(s / 3600) + 'h ago'
  return Math.floor(s / 86400) + 'd ago'
}

useSeoMeta({
  title: 'Your apps - loghq',
  description: 'Every app you are streaming logs from, in one place.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Theme + logout. The lookup-and-listener wiring these used is gone; the button
// state is a binding now.
//
// `theme` is a MIRROR of the root element's data-theme, not the source of truth:
// no component owns the root element, and the pre-paint script below sets it
// before hydration to avoid a flash of the wrong theme. The signal exists so the
// button's own state can be a binding (:data-t) instead of a manual repaint.
const theme = state(
  document.documentElement.getAttribute('data-theme')
  || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'),
)

function toggleTheme(): void {
  // The theme store owns persistence, the prefers-color-scheme listener, the
  // cross-tab storage listener and the dark-class write. This used to do the
  // first of those by hand and none of the rest, in three separate files.
  const next = theme() === 'dark' ? 'light' : 'dark'
  useStore('theme').toggle()
  theme.set(next)
}

// Navigation side effect, not rendering — clears credentials and leaves.
function logout(): void {
  // One call. The store owns the token cookie and the cached viewer, and the
  // revoke request is fire-and-forget inside it: the credentials are being
  // discarded either way, so a failed revoke must not strand someone on a page
  // they have already logged out of.
  useStore('session').signOut()
}
</script>

<style>
.mono { font-family: var(--mono); }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; }
.card { transition: border-color 0.15s ease, transform 0.12s ease; }
.card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); transform: translateY(-1px); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn-ghost { border: 1px solid var(--border); color: var(--text); border-radius: 10px; }
.btn-ghost:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--border); border-radius: 10px; color: var(--text-3); background: var(--panel); cursor: pointer; transition: color .15s ease, border-color .15s ease; }
.icon-btn:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.icon-btn svg { width: 18px; height: 18px; }
.theme-btn .ic-sun, .theme-btn .ic-moon { display: none; }
.theme-btn[data-t="light"] .ic-sun { display: block; }
.theme-btn[data-t="dark"] .ic-moon { display: block; }
</style>

{{-- Apply the saved theme before first paint (no flash of the wrong theme). --}}
<script>(function(){try{var t=localStorage.getItem('loghq_theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>

<div class="px-5 py-10 md:px-10 min-h-[100dvh]">
  <div class="mx-auto max-w-4xl">

    <header class="flex gap-4 items-center justify-between mb-9">
      <div>
        <h1 class="leading-none text-2xl md:text-[28px] wordmark">Your apps</h1>
        <p class="mt-2 text-sm text-subtle">Pick an app to track, or create a new one.</p>
      </div>
      <div class="flex gap-2.5 items-center">
        <button class="icon-btn theme-btn" :data-t="theme()" @click="toggleTheme" title="Toggle theme" aria-label="Toggle theme">
          <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <StxLink to="/projects/new" class="px-4 py-2 font-semibold text-sm btn">+ New app</StxLink>
        <button @click="logout" class="px-3.5 py-2 font-medium text-sm bg-panel btn-ghost">Log out</button>
      </div>
    </header>

    @if (!user)
      <div class="py-24 text-center text-sm text-subtle">Loading…</div>
    @endif

    @if (user)
      @forelse (projects as p)
        <StxLink to="/dashboard?project={{ p.id }}" class="flex gap-4 items-center mb-3 px-5 py-4 card panel">
          <span class="flex items-center justify-center shrink-0 h-9 w-9 font-semibold text-accent rounded-lg" style="background: color-mix(in srgb, var(--accent) 14%, var(--panel))">{{ (p.name || '?').charAt(0).toUpperCase() }}</span>
          <div class="flex-1 min-w-0">
            <div class="font-semibold truncate">{{ p.name }}</div>
            <div class="flex gap-2 items-center mt-0.5 text-subtle text-xs">
              <span class="mono">{{ p.platform || 'app' }}</span>
              <span aria-hidden="true">·</span>
              <span class="truncate mono">{{ p.id }}</span>
            </div>
          </div>
          <span class="shrink-0 text-subtle text-xs">{{ fromNow(p.created_at) }}</span>
        </StxLink>
      @empty
        <div class="px-5 py-16 text-center panel">
          <div class="mb-1 font-medium text-base">No apps yet</div>
          <div class="mb-5 text-sm text-subtle">Create your first app to start capturing errors.</div>
          <StxLink to="/projects/new" class="inline-block px-4 py-2.5 font-semibold text-sm btn">Create an app</StxLink>
        </div>
      @endforelse
    @endif

    <footer class="mt-12 text-center text-subtle text-xs">
      Log management on Stacks and Postgres. <span class="mono">loghq.org</span>
    </footer>

  </div>
</div>

@include('AuthGuard')
