<script server>
// Projects list. Server-authenticates from the token cookie and shows the
// user's own apps; each links into its dashboard. New users (or logged-out
// visitors) are handled by the client guard at the bottom.
const { db } = await import('@stacksjs/database')

// `__`-prefixed so the server→client bridge cannot publish it — see the note in
// settings.stx. This page does not leak today only because the word "token"
// happens not to appear in its client block; that is an accident, not a design.
const __token = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('loghq_token')) || ''
let user: AuthUser | null = null
if (__token) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    user = await Auth.getUserFromToken(__token)
  }
  catch { user = null }
}

let projects: ProjectRow[] = []
// A failed lookup is not an empty list. Without this flag the page would say
// "no apps yet" and offer to create one, which is the wrong thing to tell
// someone whose apps exist and whose database is briefly unreachable.
let projectsUnavailable = false
if (user) {
  try {
    projects = (await db.unsafe(
      // ingest_key is not selected: nothing on this page renders it, and
      // `projects` is a server→client bridge candidate.
      'SELECT id, name, platform, created_at FROM projects WHERE owner_id = $1 ORDER BY created_at DESC NULLS LAST, id',
      [Number(user.id)],
    )) ?? []
  }
  catch {
    projectsUnavailable = true
    projects = []
  }
}

function fromNow(iso: string | null | undefined): string {
  if (!iso) return ''
  const s = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000))
  if (s < 60) return 'just now'
  if (s < 3600) return Math.floor(s / 60) + 'm ago'
  if (s < 86400) return Math.floor(s / 3600) + 'h ago'
  return Math.floor(s / 86400) + 'd ago'
}

useSeoMeta({
  title: 'Your apps - loghq',
  description: 'Every app you are streaming logs from, in one place.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Theme + logout. The lookup-and-listener wiring these used is gone; the button
// state is a binding now.
//
// `theme` is a MIRROR of the root element's data-theme, not the source of truth:
// no component owns the root element, and stx's color-mode boot script — emitted
// from app.colorMode in config/ui.ts — sets it before hydration to avoid a flash
// of the wrong theme. The signal exists so the
// button's own state can be a binding (:data-t) instead of a manual repaint.
const theme = state(
  document.documentElement.getAttribute('data-theme')
  || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'),
)

function toggleTheme(): void {
  // The theme store owns persistence, the prefers-color-scheme listener, the
  // cross-tab storage listener and the dark-class write. This used to do the
  // first of those by hand and none of the rest, in three separate files.
  const next = theme() === 'dark' ? 'light' : 'dark'
  useStore('theme').toggle()
  theme.set(next)
}

// Navigation side effect, not rendering — clears credentials and leaves.
function logout(): void {
  // One call. The store owns the token cookie and the cached viewer, and the
  // revoke request is fire-and-forget inside it: the credentials are being
  // discarded either way, so a failed revoke must not strand someone on a page
  // they have already logged out of.
  useStore('session').signOut()
}
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
{{-- No hand-written theme guard here. config/ui.ts declares app.colorMode, and
    stx emits the pre-paint boot script from that one declaration — first inside
    <head>, above every stylesheet, reading the same loghq_theme key and setting
    the same data-theme attribute this script used to set by hand. The generated
    one is strictly better: it also resolves 'auto' against
    prefers-color-scheme, which the three copies here never did. --}}

<div class="px-5 py-10 md:px-10 min-h-[100dvh]">
  <div class="mx-auto max-w-4xl">

    <header class="flex gap-4 items-center justify-between mb-9">
      <div>
        <h1 class="leading-none text-2xl md:text-[28px] wordmark">Your apps</h1>
        <p class="mt-2 text-sm text-subtle">Pick an app to track, or create a new one.</p>
      </div>
      <div class="flex gap-2.5 items-center">
        <button class="inline-flex items-center justify-center h-9 w-9 border border-line rounded-[10px] text-subtle bg-panel cursor-pointer [transition:color_0.15s_ease,border-color_0.15s_ease] hover:text-ink hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] theme-btn" :data-t="theme()" @click="toggleTheme" x-tooltip="Toggle theme" aria-label="Toggle theme">
          <Icon name="lucide:sun" size="18" class="h-[18px] w-[18px] ic-sun" />
          <Icon name="lucide:moon" size="18" class="h-[18px] w-[18px] ic-moon" />
        </button>
        <StxLink to="/projects/new" class="px-4 py-2 font-semibold text-sm bg-accent text-white rounded-[10px] hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)]">+ New app</StxLink>
        <button @click="logout" class="px-3.5 py-2 font-medium text-sm bg-panel border border-line text-ink rounded-[10px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))]">Log out</button>
      </div>
    </header>

    @if (!user)
      <div class="py-24 text-center text-sm text-subtle">Loading…</div>
    @endif

    @if (user)
      @forelse (projects as p)
        <StxLink to="/dashboard?project={{ p.id }}" class="flex gap-4 items-center mb-3 px-5 py-4 bg-panel border border-line rounded-xl [transition:border-color_0.15s_ease,transform_0.12s_ease] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] hover:-translate-y-px">
          <span class="flex items-center justify-center shrink-0 h-9 w-9 font-semibold text-accent rounded-lg bg-[color-mix(in_srgb,var(--accent)_14%,var(--panel))]">{{ (p.name || '?').charAt(0).toUpperCase() }}</span>
          <div class="flex-1 min-w-0">
            <div class="font-semibold truncate">{{ p.name }}</div>
            <div class="flex gap-2 items-center mt-0.5 text-subtle text-xs">
              <span class="font-mono">{{ p.platform || 'app' }}</span>
              <span aria-hidden="true">·</span>
              <span class="truncate font-mono">{{ p.id }}</span>
            </div>
          </div>
          <span class="shrink-0 text-subtle text-xs">{{ fromNow(p.created_at) }}</span>
        </StxLink>
      @empty
        {{-- Two different empty states. "No apps yet" is a fact about the
             account; projectsUnavailable is a fact about the database. Showing
             the first when the second is true tells someone their apps are gone
             and invites them to recreate one. --}}
        @if (projectsUnavailable)
        <div class="px-5 py-16 text-center bg-panel border border-line rounded-xl">
          <div class="mb-1 font-medium text-base">Can't reach your apps right now</div>
          <div class="text-sm text-subtle">Make sure Postgres is provisioned. Nothing has been lost — reload once the database is back.</div>
        </div>
        @else
        <div class="px-5 py-16 text-center bg-panel border border-line rounded-xl">
          <div class="mb-1 font-medium text-base">No apps yet</div>
          <div class="mb-5 text-sm text-subtle">Create your first app to start capturing errors.</div>
          <StxLink to="/projects/new" class="inline-block px-4 py-2.5 font-semibold text-sm bg-accent text-white rounded-[10px] hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)]">Create an app</StxLink>
        </div>
        @endif
      @endforelse
    @endif

    <footer class="mt-12 text-center text-subtle text-xs">
      Log management on Stacks and Postgres. <span class="font-mono">loghq.org</span>
    </footer>

  </div>
</div>

@include('AuthGuard')
@endsection
