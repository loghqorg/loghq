<script server>
// Per-project settings (owner-only admin surface): the ingest key, team members,
// Slack/Discord alerts, and deletion. Authenticates from the loghq_token cookie
// and resolves the active project from the loghq_project cookie (same browsing
// preference the dashboard uses), scoped to projects the user OWNS — members can
// read the log stream but only an owner administers a project. Reads happen here
// server-side; mutations go client-side to the owner-scoped /api endpoints.
const { db } = await import('@stacksjs/database')
const { appUrl, ingestUrl } = await import('../../app/Support/urls')
// APP_BASE is the web app (join links); INGEST_BASE is where /logs is served
// (a separate host in local dev). Both are absolute and env-driven, falling
// back to the local servers. See app/Support/urls.ts.
const APP_BASE = appUrl()
const INGEST_BASE = ingestUrl()

const query = new URLSearchParams((typeof globalThis !== 'undefined' && globalThis.__stxServeSearch) || '')
const requestedProject = query.get('project')
const cookieProject = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('loghq_project')) || ''

const token = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('loghq_token')) || ''
let user: AuthUser | null = null
if (token) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    user = await Auth.getUserFromToken(token)
  }
  catch { user = null }
}

let projects: ProjectRow[] = []
let activeProject: ProjectRow | null = null
let needsOnboarding = false
let channels: AlertChannelRow[] = []
let members: MemberRow[] = []
let invites: InviteRow[] = []
if (user) {
  // Owned projects only — settings is the owner's admin surface.
  projects = (await db.unsafe(
    'SELECT id, name, platform, ingest_key, is_active FROM projects WHERE owner_id = $1 ORDER BY created_at DESC NULLS LAST, id',
    [Number(user.id)],
  )) ?? []
  if (projects.length === 0)
    needsOnboarding = true
  else
    activeProject = projects.find(p => p.id === requestedProject) || projects.find(p => p.id === cookieProject) || projects[0]

  if (activeProject) {
    channels = (await db.unsafe(
      `SELECT id, type, label, webhook_url, enabled, created_at
      FROM alert_channels WHERE project_id = $1 ORDER BY created_at DESC NULLS LAST, id`,
      [activeProject.id],
    )) ?? []
    members = (await db.unsafe(
      `SELECT m.id, m.email, m.role FROM project_members m
      WHERE m.project_id = $1 ORDER BY m.created_at ASC NULLS LAST, m.email`,
      [activeProject.id],
    )) ?? []
    invites = (await db.unsafe(
      `SELECT i.id, i.email, i.token, (u.id IS NOT NULL) AS registered
      FROM project_invites i LEFT JOIN users u ON lower(u.email) = lower(i.email)
      WHERE i.project_id = $1 ORDER BY i.created_at ASC NULLS LAST, i.email`,
      [activeProject.id],
    )) ?? []
  }
}
const projectId = activeProject?.id || null
const ownerEmail = (user && user.email) || ''

function maskWebhook(url: string): string {
  try {
    const u = new URL(url)
    return u.host + '/…' + String(url).slice(-4)
  }
  catch { return '…' }
}
function maskKey(k: string | null | undefined): string {
  const s = String(k || '')
  return s.length > 16 ? s.slice(0, 10) + '……' + s.slice(-4) : s
}
const channelView = channels.map(c => ({
  id: c.id,
  type: c.type,
  label: c.label || (c.type === 'slack' ? 'Slack' : 'Discord'),
  enabled: !!c.enabled,
  mask: maskWebhook(c.webhook_url),
}))
const JOIN_BASE = `${APP_BASE}/join/`
const memberView = members.map(m => ({ id: m.id, email: m.email }))
const inviteView = invites.map(i => ({ id: i.id, email: i.email, registered: !!i.registered, join: JOIN_BASE + i.token }))
const keyFull = activeProject ? String(activeProject.ingest_key || '') : ''
const keyMask = maskKey(keyFull)

// Framework-specific install snippet, keyed off the project's platform. Key-only
// (Flare-style): the ingest key alone identifies the project — no project id, no DSN.
//
// Every snippet below is plain HTTP against POST /logs, because that is the only
// integration path that exists today. Native SDKs are in progress and NOT
// published: do not put `bun add @loghq/*` or `composer require loghq/*` back
// here until the package is actually installable, and do not reference a
// `/sdk.js` loader until a route serves it. Handing someone an install command
// that 404s is worse than handing them ten lines of fetch.
//
// The wire contract these snippets implement is docs/ingest.md.
const INGEST_ENDPOINT = `${INGEST_BASE}/logs`

function installGuide(platform: string | null | undefined, key: string): { label: string, install: string, code: string } {
  const p = String(platform || 'javascript').toLowerCase()

  // Shared JS transport. Deliberately fire-and-forget and un-awaited: logging
  // must never block, and never reject into the caller's code path.
  const jsSend = `async function loghq(message, level = 'info', context) {\n`
    + `  try {\n`
    + `    await fetch('${INGEST_ENDPOINT}', {\n`
    + `      method: 'POST',\n`
    + `      headers: { 'Content-Type': 'application/json', 'X-LogHQ-Key': '${key}' },\n`
    + `      body: JSON.stringify({ logs: [{ message, level, context }] }),\n`
    + `    })\n`
    + `  }\n`
    + `  catch {} // never let logging break the app\n`
    + `}`

  const browserCapture = `${jsSend}\n\n`
    + `// uncaught errors and rejections\n`
    + `addEventListener('error', e => loghq(e.message, 'error', { stack: e.error?.stack }))\n`
    + `addEventListener('unhandledrejection', e => loghq(String(e.reason), 'error'))\n\n`
    + `// or explicitly\n`
    + `loghq('checkout failed', 'error', { cartId: 'cart_123' })`

  if (p === 'vue') {
    return {
      label: 'Vue',
      install: '',
      code: `${jsSend}\n\n`
        + `// main.ts — route Vue's error handler into loghq\n`
        + `app.config.errorHandler = (err, _instance, info) =>\n`
        + `  loghq(String(err), 'error', { info, stack: err?.stack })`,
    }
  }
  if (p === 'nuxt') {
    return {
      label: 'Nuxt',
      install: '',
      code: `// plugins/loghq.client.ts\n`
        + `${jsSend}\n\n`
        + `export default defineNuxtPlugin((nuxtApp) => {\n`
        + `  nuxtApp.hook('vue:error', err => loghq(String(err), 'error', { stack: err?.stack }))\n`
        + `})`,
    }
  }
  if (p === 'node') {
    return {
      label: 'Node.js',
      install: '',
      code: `${jsSend}\n\n`
        + `process.on('uncaughtException', e => loghq(e.message, 'critical', { stack: e.stack }))\n`
        + `process.on('unhandledRejection', r => loghq(String(r), 'error'))\n\n`
        + `await loghq('service started', 'info', { pid: process.pid })`,
    }
  }
  if (p === 'react') {
    return {
      label: 'React',
      install: '',
      code: `${browserCapture}\n\n`
        + `// render errors need an ErrorBoundary — call loghq() from componentDidCatch`,
    }
  }
  if (p === 'javascript' || p === 'browser')
    return { label: 'JavaScript', install: '', code: browserCapture }

  if (p === 'laravel') {
    return {
      label: 'Laravel',
      install: '',
      code: `// app/Logging/LogHQHandler.php\n`
        + `use Illuminate\\Support\\Facades\\Http;\n`
        + `use Monolog\\Handler\\AbstractProcessingHandler;\n`
        + `use Monolog\\LogRecord;\n\n`
        + `class LogHQHandler extends AbstractProcessingHandler\n`
        + `{\n`
        + `    protected function write(LogRecord $record): void\n`
        + `    {\n`
        + `        Http::withHeaders(['X-LogHQ-Key' => '${key}'])\n`
        + `            ->post('${INGEST_ENDPOINT}', ['logs' => [[\n`
        + `                'message' => $record->message,\n`
        + `                'level'   => strtolower($record->level->getName()),\n`
        + `                'channel' => $record->channel,\n`
        + `                'context' => $record->context,\n`
        + `            ]]]);\n`
        + `    }\n`
        + `}\n\n`
        + `// config/logging.php — Monolog levels are RFC 5424, so they map 1:1\n`
        + `'loghq' => ['driver' => 'monolog', 'handler' => App\\Logging\\LogHQHandler::class],`,
    }
  }
  if (p === 'php') {
    return {
      label: 'PHP',
      install: '',
      code: `function loghq(string $message, string $level = 'info', array $context = []): void\n`
        + `{\n`
        + `    $ch = curl_init('${INGEST_ENDPOINT}');\n`
        + `    curl_setopt_array($ch, [\n`
        + `        CURLOPT_POST           => true,\n`
        + `        CURLOPT_RETURNTRANSFER => true,\n`
        + `        CURLOPT_TIMEOUT        => 2,\n`
        + `        CURLOPT_HTTPHEADER     => ['Content-Type: application/json', 'X-LogHQ-Key: ${key}'],\n`
        + `        CURLOPT_POSTFIELDS     => json_encode(['logs' => [compact('message', 'level', 'context')]]),\n`
        + `    ]);\n`
        + `    curl_exec($ch);\n`
        + `    curl_close($ch);\n`
        + `}`,
    }
  }
  return { label: 'HTML', install: '', code: browserCapture }
}
const guide = activeProject ? installGuide(activeProject.platform, keyFull) : { label: '', install: '', code: '' }

// Values the client block needs verbatim. JSON-encoded on purpose: stx renders a
// bare `{{ str }}` inside a script as a BACKTICK template literal, which a
// backtick or `${` in the payload would break out of. `JSON.parse({{ json }})`
// survives any content.
const guideInstallJson = JSON.stringify(guide.install)
const guideCodeJson = JSON.stringify(guide.code)
const keyFullJson = JSON.stringify(keyFull)
const keyMaskJson = JSON.stringify(keyMask)
const projectIdJson = JSON.stringify(projectId)
const projectNameJson = JSON.stringify(activeProject?.name || '')
const projectActiveJson = JSON.stringify(activeProject ? activeProject.is_active !== false : true)

useSeoMeta({
  title: 'Settings - loghq',
  description: 'Project settings: ingest key, team members, and alert channels.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Settings page. Replaces ~295 lines of imperative DOM work: element lookups,
// delegated listeners doing className sniffing, manual button-label swaps, and
// row.remove() calls. Every one of those is now state plus a binding.
//
// Server values arrive JSON-encoded (see the server block) because stx renders a
// bare {{ str }} inside a script as a backtick template literal, which a backtick
// or ${ in the payload would escape from.
const projectId = JSON.parse({{ projectIdJson }})
const projectName = JSON.parse({{ projectNameJson }})
const projectActive = JSON.parse({{ projectActiveJson }})
const installText = JSON.parse({{ guideInstallJson }})
const codeText = JSON.parse({{ guideCodeJson }})

// ---- theme (mirrors the root element; the pre-paint script owns the truth) ----
const theme = state(
  document.documentElement.getAttribute('data-theme')
  || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'),
)
function toggleTheme(): void {
  // The theme store owns persistence, the prefers-color-scheme listener, the
  // cross-tab storage listener and the dark-class write. This used to do the
  // first of those by hand and none of the rest, in three separate files.
  const next = theme() === 'dark' ? 'light' : 'dark'
  useStore('theme').toggle()
  theme.set(next)
}

const authHeaders = (): Record<string, string> => ({
  'Authorization': `Bearer ${useStore('session').token()}`,
  'Content-Type': 'application/json',
})
const projUrl = `/api/projects/${encodeURIComponent(projectId || '')}`
const chBase = `${projUrl}/channels`

/** Read a JSON body without throwing on an empty or non-JSON response. */
async function readJson(res: Response): Promise<any> {
  try { return await res.json() }
  catch { return {} }
}

// ---- copy buttons ----
const copiedInstall = state(false)
const copiedCode = state(false)
const copiedKey = state(false)

async function copyText(text: string, flag: StxSignal<boolean>): Promise<void> {
  try { await navigator.clipboard.writeText(text) }
  catch {}
  flag.set(true)
  setTimeout(() => flag.set(false), 1400)
}

// ---- project switcher ----
function switchProject(e: Event): void {
  useStore('session').project.set(e.target.value)
  window.location.href = '/settings'
}

// ---- ingest key ----
const keyFull = state(JSON.parse({{ keyFullJson }}))
const keyMask = state(JSON.parse({{ keyMaskJson }}))
const keyRevealed = state(false)
const rotating = state(false)
const keyNote = state('')
const keyNoteOk = state(true)

const keyShown = (): string => (keyRevealed() ? keyFull() : keyMask())

function note(msgSig: StxSignal<string>, okSig: StxSignal<boolean>, msg: string, ok: boolean): void {
  msgSig.set(msg)
  okSig.set(ok)
}

async function rotateKey(): Promise<void> {
  const ask = window.stxConfirm
    ? window.stxConfirm('The current key stops working immediately — anything still sending it will get 401 until you update it. Continue?', { title: 'Rotate ingest key?', confirmText: 'Rotate key', cancelText: 'Cancel', type: 'warning' })
    : Promise.resolve(window.confirm('Rotate the ingest key? The current key stops working immediately.'))
  if (!(await Promise.resolve(ask)))
    return
  rotating.set(true)
  try {
    const res = await fetch(`${projUrl}/rotate-key`, { method: 'POST', headers: authHeaders() })
    const body = await readJson(res)
    rotating.set(false)
    if (!res.ok) {
      note(keyNote, keyNoteOk, body.error || 'Rotate failed.', false)
      return
    }
    keyFull.set(body.ingest_key)
    keyRevealed.set(true)
    note(keyNote, keyNoteOk, 'New key generated. Update anything sending the old one.', true)
  }
  catch {
    rotating.set(false)
    note(keyNote, keyNoteOk, 'Network error.', false)
  }
}

// ---- members and invites ----
const inviteEmail = state('')
const inviting = state(false)
const inviteNote = state('')
const inviteNoteOk = state(true)
const removedMembers: StxSignal<string[]> = state([])
const removingMember = state('')
const copiedJoin = state('')

const isMemberRemoved = id => removedMembers().includes(id)
const memberBtnLabel = id => (removingMember() === id ? 'Removing…' : 'Remove')
const joinBtnLabel = id => (copiedJoin() === id ? 'Copied ✓' : 'Copy link')

async function copyJoin(id: string, link: string): Promise<void> {
  try { await navigator.clipboard.writeText(link) }
  catch {}
  copiedJoin.set(id)
  setTimeout(() => copiedJoin.set(''), 1600)
}

async function addInvite(): Promise<void> {
  const email = inviteEmail().trim()
  if (!email) {
    note(inviteNote, inviteNoteOk, 'Enter an email address.', false)
    return
  }
  inviting.set(true)
  try {
    const res = await fetch(`${projUrl}/members`, { method: 'POST', headers: authHeaders(), body: JSON.stringify({ email }) })
    const body = await readJson(res)
    inviting.set(false)
    if (!res.ok) {
      note(inviteNote, inviteNoteOk, body.error || 'Could not invite.', false)
      return
    }
    window.location.reload()
  }
  catch {
    inviting.set(false)
    note(inviteNote, inviteNoteOk, 'Network error.', false)
  }
}

async function removeMember(id: string): Promise<void> {
  if (removingMember())
    return
  removingMember.set(id)
  try {
    const res = await fetch(`${projUrl}/members/${encodeURIComponent(id)}`, { method: 'DELETE', headers: authHeaders() })
    removingMember.set('')
    if (res.ok)
      removedMembers.set([...removedMembers(), id])
  }
  catch {
    removingMember.set('')
  }
}

// ---- alert channels ----
const chType = state('slack')
const whUrl = state('')
const whLabel = state('')
const adding = state(false)
const whNote = state('')
const whNoteOk = state(true)
const removedChannels: StxSignal<string[]> = state([])
const channelBusy: StxSignal<Record<string, string>> = state({})
const channelOn: StxSignal<Record<string, boolean>> = state({})

const PLACEHOLDERS = { slack: 'https://hooks.slack.com/services/…', discord: 'https://discord.com/api/webhooks/…' }
const HELPS = {
  slack: 'In Slack: Apps → Incoming Webhooks → Add to a channel, then paste the hooks.slack.com/services/… URL.',
  discord: 'In Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.',
}
const whPlaceholder = (): string => PLACEHOLDERS[chType()]
const whHelp = (): string => HELPS[chType()]

const isChannelRemoved = id => removedChannels().includes(id)
const testLabel = id => channelBusy()[id] || 'Test'
const deleteLabel = id => (channelBusy()[id] === 'Removing…' ? 'Removing…' : 'Remove')
/** Enabled state, defaulting to the server-rendered value until toggled. */
const isChannelOn = (id: string, initial: boolean): boolean => (id in channelOn() ? channelOn()[id] : initial)

function setBusy(id: string, value: string): void {
  channelBusy.set({ ...channelBusy(), [id]: value })
}

async function addChannel(): Promise<void> {
  const url = whUrl().trim()
  if (!url) {
    note(whNote, whNoteOk, 'Paste a webhook URL first.', false)
    return
  }
  adding.set(true)
  note(whNote, whNoteOk, 'Adding…', true)
  try {
    const res = await fetch(chBase, { method: 'POST', headers: authHeaders(), body: JSON.stringify({ type: chType(), webhook_url: url, label: whLabel().trim() }) })
    const body = await readJson(res)
    if (!res.ok) {
      adding.set(false)
      note(whNote, whNoteOk, body.error || 'Could not add that channel.', false)
      return
    }
    window.location.reload()
  }
  catch {
    adding.set(false)
    note(whNote, whNoteOk, 'Network error. Try again.', false)
  }
}

async function testChannel(id: string): Promise<void> {
  if (channelBusy()[id])
    return
  setBusy(id, 'Sending…')
  try {
    const res = await fetch(`${chBase}/${encodeURIComponent(id)}/test`, { method: 'POST', headers: authHeaders() })
    setBusy(id, res.ok ? 'Sent ✓' : 'Failed')
  }
  catch {
    setBusy(id, 'Failed')
  }
  setTimeout(() => setBusy(id, ''), 2400)
}

async function toggleChannel(id: string, initial: boolean): Promise<void> {
  const next = !isChannelOn(id, initial)
  channelOn.set({ ...channelOn(), [id]: next })
  try {
    const res = await fetch(`${chBase}/${encodeURIComponent(id)}`, { method: 'PATCH', headers: authHeaders(), body: JSON.stringify({ enabled: next }) })
    if (!res.ok)
      channelOn.set({ ...channelOn(), [id]: !next })
  }
  catch {
    // Roll back so the switch never claims a state the server rejected.
    channelOn.set({ ...channelOn(), [id]: !next })
  }
}

async function deleteChannel(id: string): Promise<void> {
  if (channelBusy()[id])
    return
  setBusy(id, 'Removing…')
  try {
    const res = await fetch(`${chBase}/${encodeURIComponent(id)}`, { method: 'DELETE', headers: authHeaders() })
    setBusy(id, '')
    if (res.ok)
      removedChannels.set([...removedChannels(), id])
  }
  catch {
    setBusy(id, '')
  }
}

// ---- danger zone: type-to-confirm modal ----
const modalKind = state('')
const modalInput = state('')
const modalBusy = state(false)
const modalNote = state('')
const archiving = state(false)

const modalOpen = (): boolean => modalKind() !== ''
const modalTitle = (): string => (modalKind() === 'delete' ? `Delete ${projectName}?` : `Archive ${projectName}?`)
const modalDesc = (): string => (modalKind() === 'delete'
  ? 'This permanently deletes the project and all of its log entries, alert channels, members, and invites. This cannot be undone.'
  : 'loghq will stop accepting new log entries for this project. Everything already stored is kept, and you can unarchive anytime.')
const modalConfirmLabel = (): string => {
  if (modalBusy())
    return modalKind() === 'delete' ? 'Deleting…' : 'Archiving…'
  return modalKind() === 'delete' ? 'Delete project' : 'Archive project'
}
/** The type-to-confirm gate: the typed name must match exactly. */
const modalReady = (): boolean => modalInput().trim() === projectName && !modalBusy()

function closeModal(): void {
  modalKind.set('')
  modalInput.set('')
  modalNote.set('')
  modalBusy.set(false)
}

function openArchive(): void {
  // Unarchiving is non-destructive, so it skips the confirm entirely.
  if (!projectActive) {
    unarchive()
    return
  }
  modalInput.set('')
  modalNote.set('')
  modalKind.set('archive')
}

function openDelete(): void {
  modalInput.set('')
  modalNote.set('')
  modalKind.set('delete')
}

async function unarchive(): Promise<void> {
  archiving.set(true)
  try {
    const res = await fetch(`${projUrl}/archive`, { method: 'POST', headers: authHeaders(), body: JSON.stringify({ archived: false }) })
    if (res.ok) {
      window.location.reload()
      return
    }
    archiving.set(false)
  }
  catch {
    archiving.set(false)
  }
}

async function confirmModal(): Promise<void> {
  if (!modalReady())
    return
  modalBusy.set(true)
  const kind = modalKind()
  try {
    const res = kind === 'delete'
      ? await fetch(projUrl, { method: 'DELETE', headers: authHeaders() })
      : await fetch(`${projUrl}/archive`, { method: 'POST', headers: authHeaders(), body: JSON.stringify({ archived: true }) })
    if (!res.ok) {
      modalBusy.set(false)
      modalNote.set(kind === 'delete' ? 'Delete failed.' : 'Archive failed.')
      return
    }
    if (kind === 'delete') {
      useStore('session').project.set('')
      window.location.assign('/projects')
    }
    else {
      window.location.reload()
    }
  }
  catch {
    modalBusy.set(false)
    modalNote.set('Network error.')
  }
}

// Escape closes the modal. Bound to the document because no element owns the
// keyboard globally — this is a listener on a thing no component owns, not
// render wiring.
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && modalOpen())
    closeModal()
})
</script>

<style>
:root {
  --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48;
  --slack: #611f69; --discord: #5865f2; --ok: #16a34a; --warn: #b91c1c;
  --sans: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
    --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185;
    --discord: #818cf8; --ok: #4ade80; --warn: #f87171; }
}
:root[data-theme="dark"] { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
  --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; --discord: #818cf8; --ok: #4ade80; --warn: #f87171; }
:root[data-theme="light"] { --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48; --discord: #5865f2; --ok: #16a34a; --warn: #b91c1c; }
html { scroll-behavior: smooth; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.mono { font-family: var(--mono); }
.lnk { color: var(--text-2); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--border); transition: color 0.15s ease, text-decoration-color 0.15s ease; }
.lnk:hover { color: var(--text); text-decoration-color: currentColor; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.wordmark-link { color: inherit; text-decoration: none; transition: opacity 0.15s ease; }
.wordmark-link:hover { opacity: 0.75; }
.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; }
.sec { scroll-margin-top: 84px; }
.sec-title { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-3); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; transition: background 0.15s ease, opacity 0.15s ease; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn:disabled { opacity: 0.55; cursor: default; }
.btn-ghost { border: 1px solid var(--border); color: var(--text-2); border-radius: 9px; background: var(--panel); transition: color 0.15s ease, border-color 0.15s ease; }
.btn-ghost:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.btn-danger { border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--border)); color: var(--warn); border-radius: 9px; background: var(--panel); transition: all 0.15s ease; }
.btn-danger:hover { color: #fff; background: var(--warn); border-color: var(--warn); }
.field { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text); }
.field:focus { outline: none; border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
.badge { border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; padding: 2px 9px; }
.badge-slack { color: #fff; background: var(--slack); }
.badge-discord { color: #fff; background: var(--discord); }
.badge-soft { background: color-mix(in srgb, var(--accent) 14%, var(--panel)); color: var(--accent); }
.badge-owner { background: color-mix(in srgb, var(--accent) 16%, var(--panel)); color: var(--accent); }
.badge-pending { background: color-mix(in srgb, var(--text-3) 18%, var(--panel)); color: var(--text-2); }
.tgl { width: 38px; height: 22px; border-radius: 999px; background: var(--border); position: relative; transition: background 0.15s ease; cursor: pointer; flex: none; }
.tgl::after { content: ''; position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 999px; background: #fff; transition: transform 0.15s ease; }
.tgl[data-on="1"] { background: var(--ok); }
.tgl[data-on="1"]::after { transform: translateX(16px); }
.seg { border: 1px solid var(--border); border-radius: 10px; color: var(--text-2); background: var(--panel); transition: all 0.12s ease; }
.seg[data-sel="1"] { color: #fff; border-color: transparent; }
.seg-slack[data-sel="1"] { background: var(--slack); }
.seg-discord[data-sel="1"] { background: var(--discord); }
.note { display: none; }
.note.show { display: block; }
.icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 9px; color: var(--text-2); background: var(--panel); cursor: pointer; transition: color .15s ease, border-color .15s ease; }
.icon-btn:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.icon-btn svg { width: 17px; height: 17px; }
.theme-btn .ic-sun, .theme-btn .ic-moon { display: none; }
.theme-btn[data-t="light"] .ic-sun { display: block; }
.theme-btn[data-t="dark"] .ic-moon { display: block; }
.tabnav a { color: var(--text-2); border: 1px solid var(--border); border-radius: 999px; transition: color .15s ease, border-color .15s ease; }
.tabnav a:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.danger-panel { border-color: color-mix(in srgb, var(--warn) 40%, var(--border)); }
.code-block { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text-2); font-family: var(--mono); font-size: 12px; line-height: 1.5; padding: 12px 16px; padding-right: 64px; overflow-x: auto; }
.copy-btn { position: absolute; top: 8px; right: 8px; font: 500 11px/1 var(--sans); padding: 5px 9px; border-radius: 7px; border: 1px solid var(--border); background: var(--panel); color: var(--text-3); cursor: pointer; transition: color .15s ease, border-color .15s ease; }
.copy-btn:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.dz-div { height: 1px; background: color-mix(in srgb, var(--warn) 20%, var(--border)); }
.dz-overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(2,4,10,0.62); backdrop-filter: blur(3px); animation: dz-fade 0.12s ease; }
.dz-overlay[hidden] { display: none; }
.dz-card { width: 100%; max-width: 440px; padding: 22px; box-shadow: 0 24px 70px rgba(0,0,0,0.5); animation: dz-pop 0.14s cubic-bezier(0.2,0.8,0.3,1); }
@keyframes dz-fade { from { opacity: 0 } to { opacity: 1 } }
@keyframes dz-pop { from { opacity: 0; transform: translateY(6px) scale(0.98) } to { opacity: 1; transform: none } }
</style>

{{-- Apply the saved theme before first paint (no flash of the wrong theme). --}}
<script>(function(){try{var t=localStorage.getItem('loghq_theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>

<div class="px-5 py-10 md:px-10 min-h-[100dvh]">
  <div class="mx-auto max-w-2xl">

    <header class="flex gap-4 items-center justify-between mb-7">
      <StxLink to="/projects" class="wordmark-link"><h1 class="leading-none text-2xl wordmark">loghq</h1></StxLink>
      <div class="flex gap-2 items-center">
        <button :data-t="theme()" @click="toggleTheme" class="icon-btn theme-btn" title="Toggle theme" aria-label="Toggle theme">
          <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <StxLink to="/dashboard" class="px-3.5 py-2 font-medium text-sm btn-ghost">← Dashboard</StxLink>
      </div>
    </header>

    @if (!user)
      <div class="py-24 text-center text-sm text-subtle">Loading…</div>
    @endif

    @if (needsOnboarding)
      <script>window.location.replace('/projects/new')</script>
    @endif

    @if (user && activeProject)
      <div class="mb-6">
        <div class="flex flex-wrap gap-3 items-center">
          <h2 class="font-semibold text-xl" style="letter-spacing:-0.02em">Settings</h2>
          @if (projects.length > 1)
            <select @change="switchProject" class="px-3 py-1.5 text-muted text-sm mono panel">
              @foreach (projects as p)
                <option value="{{ p.id }}" {{ p.id === projectId ? 'selected' : '' }}>{{ p.name }}</option>
              @endforeach
            </select>
          @else
            <span class="text-muted text-sm mono">{{ activeProject.name }}</span>
          @endif
        </div>
        <p class="mt-1.5 text-sm text-subtle">Manage the API key, team, alerts, and deletion for this project.</p>
      </div>

      <nav class="flex gap-2 items-center mb-8 text-sm tabnav">
        <a href="#install" class="px-3 py-1.5 font-medium">Install</a>
        <a href="#keys" class="px-3 py-1.5 font-medium">Keys</a>
        <a href="#members" class="px-3 py-1.5 font-medium">Members</a>
        <a href="#alerts" class="px-3 py-1.5 font-medium">Alerts</a>
        <a href="#danger" class="px-3 py-1.5 font-medium">Danger</a>
      </nav>

      {{-- ============================ INSTALL ============================ --}}
      <section id="install" class="mb-10 sec">
        <div class="mb-3 sec-title">Install</div>
        <div class="px-5 py-5 panel">
          <div class="flex gap-3 items-center justify-between mb-3.5">
            <p class="text-sm text-subtle">Send logs to <span class="text-muted mono">{{ activeProject.name }}</span> over plain HTTP. Nothing to install — every entry lands in your stream, searchable and correlatable.</p>
            <span class="shrink-0 badge badge-soft">{{ guide.label }}</span>
          </div>
          @if (guide.install)
            <div class="relative mb-2">
              <div class="code-block">{{ guide.install }}</div>
              <button type="button" @click="copyText(installText, copiedInstall)" class="copy-btn" :text="copiedInstall() ? 'Copied' : 'Copy'">Copy</button>
            </div>
          @endif
          <div class="relative">
            <div class="code-block" style="white-space: pre">{{ guide.code }}</div>
            <button type="button" @click="copyText(codeText, copiedCode)" class="copy-btn" :text="copiedCode() ? 'Copied' : 'Copy'">Copy</button>
          </div>
          <p class="mt-3.5 leading-relaxed text-subtle text-xs">
            Native SDKs are in progress. Until then this is the whole integration — the
            <a href="https://github.com/stacksjs/loghq/blob/main/docs/ingest.md" class="lnk" target="_blank" rel="noreferrer">ingest spec</a>
            documents every field, limit, and retry rule if you want batching or backoff.
          </p>
        </div>
      </section>

      {{-- ============================ KEYS ============================ --}}
      <section id="keys" class="mb-10 sec">
        <div class="mb-3 sec-title">API key</div>
        <div class="px-5 py-5 panel">
          <p class="mb-4 text-sm text-subtle">
            This key authorizes log ingest for <span class="text-muted mono">{{ activeProject.name }}</span>.
            It's a public identifier (safe to ship in client code), not a secret — it says <em>which</em> project an entry belongs to, and grants no read access.
          </p>
          <div class="flex flex-wrap gap-2 items-center">
            <code class="flex-1 px-3.5 py-2.5 min-w-[220px] text-sm truncate field mono" style="letter-spacing:0.01em" :text="keyShown()">{{ keyMask }}</code>
            <button @click="keyRevealed.set(!keyRevealed())" class="px-3 py-2 font-medium text-sm btn-ghost" :text="keyRevealed() ? 'Hide' : 'Reveal'">Reveal</button>
            <button @click="copyText(keyFull(), copiedKey)" class="px-3 py-2 font-medium text-sm btn-ghost" :text="copiedKey() ? 'Copied' : 'Copy'">Copy</button>
            <button @click="rotateKey" :disabled="rotating()" class="px-3 py-2 font-medium text-sm btn-danger">Rotate</button>
          </div>
          <p class="mt-3.5 leading-relaxed text-subtle text-xs">
            Rotating generates a new key and <span style="color: var(--warn)">invalidates the current one immediately</span> — anything still sending the old key will get 401 until you update it (<span class="mono">X-LogHQ-Key</span>).
          </p>
          <span class="mt-2 text-xs note show" :show="!!keyNote()" :style="keyNoteOk() ? 'color: var(--ok)' : 'color: var(--accent)'">{{ keyNote() }}</span>
        </div>
      </section>

      {{-- ============================ MEMBERS ============================ --}}
      <section id="members" class="mb-10 sec">
        <div class="mb-3 sec-title">Members</div>
        <div class="flex flex-col gap-2.5 mb-4">
          {{-- Owner (always first, not removable) --}}
          <div class="flex gap-3.5 items-center px-4 py-3.5 panel">
            <span class="grid place-items-center shrink-0 h-8 w-8 font-semibold rounded-lg badge-owner">{{ (ownerEmail || '?').charAt(0).toUpperCase() }}</span>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm truncate">{{ ownerEmail }}</div>
              <div class="mt-0.5 text-subtle text-xs">Full access</div>
            </div>
            <span class="badge badge-owner">Owner</span>
          </div>
          @foreach (memberView as m)
            <div class="flex gap-3.5 items-center px-4 py-3.5 panel" :show="!isMemberRemoved('{{ m.id }}')">
              <span class="grid place-items-center shrink-0 h-8 w-8 font-semibold text-muted rounded-lg" style="background: color-mix(in srgb, var(--text-3) 16%, var(--panel))">{{ (m.email || '?').charAt(0).toUpperCase() }}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{{ m.email }}</div>
                <div class="mt-0.5 text-subtle text-xs">Can read the log stream</div>
              </div>
              <span class="badge badge-soft">Member</span>
              <button @click="removeMember('{{ m.id }}')" :disabled="removingMember() === '{{ m.id }}'" :text="memberBtnLabel('{{ m.id }}')" class="px-2.5 py-1.5 font-medium text-xs btn-danger" title="Remove">Remove</button>
            </div>
          @endforeach
          @foreach (inviteView as i)
            <div class="flex gap-3.5 items-center px-4 py-3.5 panel" :show="!isMemberRemoved('{{ i.id }}')">
              <span class="grid place-items-center shrink-0 h-8 w-8 font-semibold text-subtle rounded-lg" style="background: color-mix(in srgb, var(--text-3) 12%, var(--panel))">{{ (i.email || '?').charAt(0).toUpperCase() }}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{{ i.email }}</div>
                <div class="mt-0.5 text-subtle text-xs">{{ i.registered ? 'Has an account — pending accept' : 'Invite sent — awaiting sign-up' }}</div>
              </div>
              <span class="badge badge-pending" title="Pending — becomes a member once they accept">Invited</span>
              <button @click="copyJoin('{{ i.id }}', '{{ i.join }}')" :text="joinBtnLabel('{{ i.id }}')" class="px-2.5 py-1.5 font-medium text-xs btn-ghost" title="Copy join link">Copy link</button>
              <button @click="removeMember('{{ i.id }}')" :disabled="removingMember() === '{{ i.id }}'" :text="memberBtnLabel('{{ i.id }}')" class="px-2.5 py-1.5 font-medium text-xs btn-danger" title="Revoke invite">Remove</button>
            </div>
          @endforeach
        </div>
        <div class="px-5 py-5 panel">
          <div class="mb-3 font-semibold text-sm">Invite a teammate</div>
          <div class="flex flex-wrap gap-2 items-center">
            <input :model="inviteEmail" type="email" class="flex-1 px-3.5 py-2.5 min-w-[220px] text-sm field" placeholder="teammate@company.com" autocomplete="off">
            <button @click="addInvite" :disabled="inviting()" class="px-4 py-2.5 font-semibold text-sm btn" :text="inviting() ? 'Inviting…' : 'Invite'">Invite</button>
          </div>
          <span class="mt-2.5 text-xs note show" :show="!!inviteNote()" :style="inviteNoteOk() ? 'color: var(--ok)' : 'color: var(--accent)'">{{ inviteNote() }}</span>
          <p class="mt-3.5 leading-relaxed text-subtle text-xs">
            We email them a join link. They sign up (or log in) with that email, then accept from a banner in the app. Members can read the log stream; only you can manage keys, members, and deletion.
          </p>
        </div>
      </section>

      {{-- ============================ ALERTS ============================ --}}
      <section id="alerts" class="mb-10 sec">
        <div class="mb-3 sec-title">Alerts</div>
        <p class="mb-4 text-sm text-subtle">
          Add a Slack or Discord webhook and send a test to verify it. Automatic delivery isn't live yet —
          channels you add here are saved and testable, but loghq won't fire on its own until log-based alert rules ship.
        </p>
        <div class="flex flex-col gap-2.5 mb-4">
          @forelse (channelView as c)
            <div class="flex gap-3.5 items-center px-4 py-3.5 panel" :show="!isChannelRemoved('{{ c.id }}')">
              <span class="badge badge-{{ c.type }}">{{ c.type === 'slack' ? 'Slack' : 'Discord' }}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{{ c.label }}</div>
                <div class="mt-0.5 text-subtle text-xs truncate mono">{{ c.mask }}</div>
              </div>
              <button @click="testChannel('{{ c.id }}')" :text="testLabel('{{ c.id }}')" class="px-2.5 py-1.5 font-medium text-xs btn-ghost" title="Send a test message">Test</button>
              <div class="tgl" @click="toggleChannel('{{ c.id }}', {{ c.enabled ? 'true' : 'false' }})" :data-on="isChannelOn('{{ c.id }}', {{ c.enabled ? 'true' : 'false' }}) ? '1' : '0'" :aria-checked="isChannelOn('{{ c.id }}', {{ c.enabled ? 'true' : 'false' }}) ? 'true' : 'false'" role="switch" title="Enable / disable"></div>
              <button @click="deleteChannel('{{ c.id }}')" :text="deleteLabel('{{ c.id }}')" class="px-2.5 py-1.5 font-medium text-xs btn-danger" title="Remove">Remove</button>
            </div>
          @empty
            <div class="px-5 py-8 text-center panel">
              <div class="mb-1 font-medium text-sm">No chat alerts yet</div>
              <div class="text-subtle text-xs">Add a Slack or Discord webhook below to start getting pinged.</div>
            </div>
          @endforelse
        </div>
        <div class="px-5 py-5 panel">
          <div class="mb-3.5 font-semibold text-sm">Add a channel</div>
          <div class="grid gap-2 grid-cols-2 mb-3">
            <button type="button" @click="chType.set('slack')" :data-sel="chType() === 'slack' ? '1' : '0'" class="px-3 py-2.5 font-medium text-sm seg seg-slack">Slack</button>
            <button type="button" @click="chType.set('discord')" :data-sel="chType() === 'discord' ? '1' : '0'" class="px-3 py-2.5 font-medium text-sm seg seg-discord">Discord</button>
          </div>
          <input :model="whUrl" :placeholder="whPlaceholder()" type="url" class="mb-2 px-3.5 py-2.5 w-full text-sm field mono" placeholder="https://hooks.slack.com/services/…" autocomplete="off" spellcheck="false">
          <input :model="whLabel" type="text" class="mb-3 px-3.5 py-2.5 w-full text-sm field" placeholder="Label (optional) — e.g. #alerts" maxlength="255">
          <div class="flex gap-3 items-center">
            <button @click="addChannel" :disabled="adding()" class="px-4 py-2.5 font-semibold text-sm btn" :text="adding() ? 'Adding…' : 'Add channel'">Add channel</button>
            <span class="text-xs note show" :show="!!whNote()" :style="whNoteOk() ? 'color: var(--ok)' : 'color: var(--accent)'">{{ whNote() }}</span>
          </div>
          <p :text="whHelp()" class="mt-3.5 leading-relaxed text-subtle text-xs">
            In Slack: <span class="text-muted">Apps → Incoming Webhooks → Add to a channel</span>, then paste the <span class="mono">hooks.slack.com/services/…</span> URL.
          </p>
        </div>
      </section>

      {{-- ============================ DANGER ============================ --}}
      <section id="danger" class="mb-6 sec">
        <div class="mb-3 sec-title" style="color: var(--warn)">Danger zone</div>
        <div class="danger-panel panel" data-project-name="{{ activeProject.name }}" data-active="{{ activeProject.is_active === false ? '0' : '1' }}">
          {{-- Archive / Unarchive --}}
          <div class="flex gap-4 items-center justify-between px-5 py-4">
            <div class="min-w-0">
              @if (activeProject.is_active === false)
                <div class="mb-0.5 font-semibold text-sm">Unarchive this project</div>
                <p class="text-sm text-subtle"><span class="text-muted mono">{{ activeProject.name }}</span> is archived and isn’t accepting new logs. Unarchiving resumes ingestion right away.</p>
              @else
                <div class="mb-0.5 font-semibold text-sm">Archive this project</div>
                <p class="text-sm text-subtle">Rejects new log entries for <span class="text-muted mono">{{ activeProject.name }}</span> with a 403. Everything already stored is kept — you can unarchive anytime.</p>
              @endif
            </div>
            <button @click="openArchive" :disabled="archiving()" class="flex-none px-4 py-2.5 font-semibold text-sm whitespace-nowrap btn-danger">{{ activeProject.is_active === false ? 'Unarchive' : 'Archive' }}</button>
          </div>
          <div class="dz-div"></div>
          {{-- Delete --}}
          <div class="flex gap-4 items-center justify-between px-5 py-4">
            <div class="min-w-0">
              <div class="mb-0.5 font-semibold text-sm">Delete this project</div>
              <p class="text-sm text-subtle">Permanently deletes <span class="text-muted mono">{{ activeProject.name }}</span> and all of its log entries, alert channels, members, and invites. This cannot be undone.</p>
            </div>
            <button @click="openDelete" class="flex-none px-4 py-2.5 font-semibold text-sm whitespace-nowrap btn-danger">Delete</button>
          </div>
        </div>
      </section>

      {{-- Type-to-confirm modal (archive / delete). Was built by hand: toggling
          the hidden attribute, writing title/desc/label text, and flipping a
          disabled flag on input. It is one modalKind signal now — '' means
          closed.

          This is an stx comment rather than an HTML one, deliberately. An HTML
          comment ships to the browser verbatim and is then re-read by four
          separate consumers: a backtick in one flips the merged setup function
          into template-literal mode, and the name of the root element or of a
          script tag in one silently disables the document shell. Describe
          syntax in prose here; never quote it. --}}
      <div class="dz-overlay" :show="modalOpen()" @click="closeModal">
        <div class="dz-card panel" role="dialog" aria-modal="true" @click.stop>
          <div class="mb-1 font-semibold text-base">{{ modalTitle() }}</div>
          <p class="mb-4 text-muted text-sm">{{ modalDesc() }}</p>
          <label class="block mb-1.5 text-subtle text-xs">Type <span class="text-muted mono">{{ projectName }}</span> to confirm</label>
          <input :model="modalInput" type="text" class="mb-4 px-3.5 py-2.5 w-full text-sm field mono" autocomplete="off" autocapitalize="off" spellcheck="false">
          <div class="flex gap-2 items-center justify-end">
            <button @click="closeModal" type="button" class="px-4 py-2.5 font-medium text-sm btn-ghost">Cancel</button>
            <button @click="confirmModal" :disabled="!modalReady()" :text="modalConfirmLabel()" type="button" class="px-4 py-2.5 font-semibold text-sm btn-danger"></button>
          </div>
          <span class="mt-2.5 text-xs note show" :show="!!modalNote()" style="color: var(--accent)">{{ modalNote() }}</span>
        </div>
      </div>
    @endif

  </div>
</div>

{{-- Auth guard. Navigation only, renders nothing, and must run before the page
    is usable — a directive would hydrate too late and flash the settings UI to
    a signed-out visitor. --}}

@include('AuthGuard')
