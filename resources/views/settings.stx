<script server>
// Per-project settings (owner-only admin surface): the ingest key, team members,
// Slack/Discord alerts, and deletion. Authenticates from the loghq_token cookie
// and resolves the active project from the loghq_project cookie (same browsing
// preference the dashboard uses), scoped to projects the user OWNS — members can
// read the log stream but only an owner administers a project. Reads happen here
// server-side; mutations go client-side to the owner-scoped /api endpoints.
// Static imports, per ch.5.3: the CommonJS rewrite turns these into the
// `await import()` form itself and adds the module.exports line, which the
// hand-written form does not get.
//
// `db as __db` on purpose. The rewrite's export line puts every top-level
// binding into the template context, and the bridge publishes any non-function
// context value whose bare name appears in the client script. `db` is an object,
// not a function, so it is a bridge candidate — it stays out of the HTML today
// only because the word happens not to appear in the client block below. The
// `__` prefix makes that a guarantee instead of an accident (ch.5.8).
// appUrl/ingestUrl need no prefix: functions are dropped by the bridge.
// STATIC, not `await import('@stacksjs/auth')` inside the guard below.
//
// A dynamic import in a server block is resolved in the context of the module
// evaluating it — stx's variable-extractor — and the stx fork's
// node_modules/@stacksjs/auth is a symlink into a SIBLING PROJECT. So the
// dynamic form loaded another app's auth package, whose @stacksjs/orm has no
// User model for this database. Proven on login.stx, where it threw
// `User.where is not a function` with that project's path in the stack trace
// (fixed in 62d46ce); this page only escaped it because getUserFromToken
// leans on raw db queries rather than the ORM.
//
// The catch below would have hidden that: an import failure becomes
// `user = null`, which renders as signed-out rather than as an error.
import { Auth } from '@stacksjs/auth'
import { db as __db } from '@stacksjs/database'
import { appUrl, ingestUrl } from '../../app/Support/urls'
import { getRepository } from '../../app/Fix/repository'
import { archiveConfig } from '../../app/Archive/config'
import { projectPlan } from '../../app/Archive/plan'
import { archiveSummary } from '../../app/Archive/query'
// APP_BASE is the web app (join links); INGEST_BASE is where /logs is served
// (a separate host in local dev). Both are absolute and env-driven, falling
// back to the local servers. See app/Support/urls.ts.
const APP_BASE = appUrl()
const INGEST_BASE = ingestUrl()

// Context locals, injected onto this render's context by the serve path just
// before the block runs.
//
// These replaced the ambient request-context global that used to be read here.
// That global is not part of stx — it is installed by whichever server booted,
// and the two servers resolve it differently: dev goes through an
// AsyncLocalStorage that only fills in after the first top-level await, while
// production reads a mutable global shared across requests. Context locals have
// neither an ordering requirement nor anything to race on.
//
// Deliberately not naming that global here: the ch.5.5 gate greps for it by
// name, and prose in a comment would keep the check permanently non-zero.
const query = new URLSearchParams(__stxServeSearch || '')
const requestedProject = query.get('project')
const cookieProject = cookies.loghq_project ?? ''

// ---------------------------------------------------------------------------
// THE `__` PREFIX IS A SECURITY BOUNDARY IN THIS FILE. READ BEFORE RENAMING.
//
// stx bridges server scope into the client script automatically. extractBridgeData
// (client-script.ts:775) takes EVERY top-level binding in this block that is not
// a function and is not prefixed with `__` or `$`, and generateServerDataBridge
// (client-script.ts:846) then emits `var <name> = <JSON>` into the page for any
// of those whose name matches /\b<name>\b/ anywhere in the client script TEXT —
// comments and string literals included.
//
// That last part is what makes this dangerous rather than merely wasteful. A
// binding does not have to be USED by client code to be published; the word
// merely has to appear. Measured on this page before the fix: `var token = "…"`
// carried the raw session token into the HTML because `useStore('session').token()`
// appears in the client block, and `projects` published every ingest_key because
// the string `/api/projects/${…}` appears in a fetch URL.
//
// So anything holding a credential is named `__something` and never reaches the
// template. What the template renders is a projection built below — channelView,
// memberView, inviteView, projects — that contains no secret by construction.
// Renaming a `__` binding to a bare one re-opens the leak silently, with no lint
// error and no test failure.
// ---------------------------------------------------------------------------
const __token = cookies.loghq_token ?? ''
let user: AuthUser | null = null
if (__token) {
  try {
    user = await Auth.getUserFromToken(__token)
  }
  catch (err) {
    // Fail closed, but leave a trace. This used to be a bare `catch {}`, so a
    // database blip and a genuinely signed-out visitor were indistinguishable
    // both on the page and in the log.
    console.error('[auth] getUserFromToken failed:', err instanceof Error ? err.message : err)
    user = null
  }
}

let __projectRows: ProjectRow[] = []
let __activeRow: ProjectRow | null = null
let needsOnboarding = false
let __channelRows: AlertChannelRow[] = []
let __memberRows: MemberRow[] = []
let __inviteRows: InviteRow[] = []
// Distinguishes "this owner has no projects" from "the database did not
// answer". Only the first should offer to create one.
let projectsUnavailable = false
if (user) {
  // All four reads share one try. They are one unit of work: the last three are
  // scoped to the project the first resolves, so partial success here would
  // render an admin surface for a project whose members and channels silently
  // came back empty — which reads as "everyone was removed" rather than as a
  // fault. Unguarded, a throw truncated the whole page to its skeleton on a
  // 200; see the note in dashboard.stx.
  try {
    // Owned projects only — settings is the owner's admin surface.
    __projectRows = (await __db.unsafe(
      'SELECT id, name, platform, ingest_key, is_active FROM projects WHERE owner_id = $1 ORDER BY created_at DESC NULLS LAST, id',
      [Number(user.id)],
    )) ?? []
    if (__projectRows.length === 0)
      needsOnboarding = true
    else
      __activeRow = __projectRows.find(p => p.id === requestedProject) || __projectRows.find(p => p.id === cookieProject) || __projectRows[0]

    if (__activeRow) {
      __channelRows = (await __db.unsafe(
        `SELECT id, type, label, webhook_url, enabled, created_at
        FROM alert_channels WHERE project_id = $1 ORDER BY created_at DESC NULLS LAST, id`,
        [__activeRow.id],
      )) ?? []
      __memberRows = (await __db.unsafe(
        `SELECT m.id, m.email, m.role FROM project_members m
        WHERE m.project_id = $1 ORDER BY m.created_at ASC NULLS LAST, m.email`,
        [__activeRow.id],
      )) ?? []
      __inviteRows = (await __db.unsafe(
        `SELECT i.id, i.email, i.token, (u.id IS NOT NULL) AS registered
        FROM project_invites i LEFT JOIN users u ON lower(u.email) = lower(i.email)
        WHERE i.project_id = $1 ORDER BY i.created_at ASC NULLS LAST, i.email`,
        [__activeRow.id],
      )) ?? []
    }
  }
  catch {
    // needsOnboarding stays false: a database fault must not send an owner with
    // existing projects to the create-your-first-app flow.
    projectsUnavailable = true
    needsOnboarding = false
    __projectRows = []
    __activeRow = null
    __channelRows = []
    __memberRows = []
    __inviteRows = []
  }
}

// Template-facing projections. `ingest_key` is dropped here and nowhere else:
// the switcher needs a project's id, name and state, never its credential.
const projects = __projectRows.map(({ ingest_key: _ignored, ...p }) => p)
const activeProject = __activeRow ? (({ ingest_key: _ignored, ...p }) => p)(__activeRow) : null
const projectId = activeProject?.id || null

// The connected repository, for the Repository section below. Loaded here
// rather than fetched on hydrate so the section renders its real state
// server-side, like every other section on this page.
//
// This binding IS bridged into the HTML, which is exactly why getRepository
// selects `token_hint` and never `token_ciphertext`: the last four characters
// identify which token is connected, and carry nothing that could be replayed.
let repository: any = null
if (projectId) {
  try {
    repository = await getRepository(projectId)
  }
  catch {
    // A missing table (migration not yet applied) must not take the whole
    // settings page down over an optional section.
    repository = null
  }
}
// Retention, for the section of the same name below. Rendered server-side like
// everything else on this page, and behind its own try/catch for the same
// reason the repository lookup is: archive_partitions arrived in a later
// migration, and a box that has not run it must still be able to open settings.
const __archiveCfg = archiveConfig()
const retention = {
  plan: 'free',
  hotWindowDays: __archiveCfg.hotWindowDays,
  graceDays: __archiveCfg.freePruneGraceDays,
  enabled: __archiveCfg.enabled,
  partitions: 0,
  archivedRows: 0,
  archivedBytes: 0,
  prunedRows: 0,
  oldestDay: null as string | null,
  available: false,
}
if (projectId) {
  try {
    const [plan, summary] = await Promise.all([projectPlan(projectId), archiveSummary(projectId)])
    retention.plan = plan
    retention.partitions = summary.partitions
    retention.archivedRows = summary.archivedRows
    retention.archivedBytes = summary.archivedBytes
    retention.prunedRows = summary.prunedRows
    retention.oldestDay = summary.oldestDay
    retention.available = true
  }
  catch {
    retention.available = false
  }
}

function formatBytes(n: number): string {
  if (!n)
    return '0 B'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  const i = Math.min(units.length - 1, Math.floor(Math.log(n) / Math.log(1024)))
  return `${(n / 1024 ** i).toFixed(i === 0 ? 0 : 1)} ${units[i]}`
}

const retentionBytesLabel = formatBytes(retention.archivedBytes)

const ownerEmail = (user && user.email) || ''

function maskWebhook(url: string): string {
  try {
    const u = new URL(url)
    return u.host + '/…' + String(url).slice(-4)
  }
  catch { return '…' }
}
function maskKey(k: string | null | undefined): string {
  const s = String(k || '')
  return s.length > 16 ? s.slice(0, 10) + '……' + s.slice(-4) : s
}
// A webhook URL is a bearer credential — anyone holding it can post into the
// customer's Slack or Discord — so only the mask crosses into template scope.
const channelView = __channelRows.map(c => ({
  id: c.id,
  type: c.type,
  label: c.label || (c.type === 'slack' ? 'Slack' : 'Discord'),
  enabled: !!c.enabled,
  mask: maskWebhook(c.webhook_url),
}))
const JOIN_BASE = `${APP_BASE}/join/`
const memberView = __memberRows.map(m => ({ id: m.id, email: m.email }))
const inviteView = __inviteRows.map(i => ({ id: i.id, email: i.email, registered: !!i.registered, join: JOIN_BASE + i.token }))
// keyFull reads the credential from the server-only row, not from the projection.
// It is bridged deliberately — the reveal control needs it — but as its own
// named value, so publishing it stays a decision rather than a side effect.
const keyFull = __activeRow ? String(__activeRow.ingest_key || '') : ''
const keyMask = maskKey(keyFull)

// Framework-specific install snippet, keyed off the project's platform. Key-only
// (Flare-style): the ingest key alone identifies the project — no project id, no DSN.
//
// Most snippets below are plain HTTP against POST /logs, because for most
// platforms that is still the only integration path that exists.
//
// The rule that produced them stands, with one exception now earned: do not
// print an install command until the package is actually installable, because
// handing someone a command that 404s is worse than handing them ten lines of
// fetch. `@loghq/stacks` IS on npm, so Stacks gets the real thing and sets
// `native: true`.
//
// Still NOT installable, so still plain HTTP: `loghq/loghq-laravel` is on
// Packagist but its `loghq/loghq` dependency is not, so `composer require`
// cannot resolve it. Swap the Laravel snippet over once that is submitted.
// Same rule for a `/sdk.js` loader: not until a route serves it.
//
// The wire contract these snippets implement is docs/ingest.md.
const INGEST_ENDPOINT = `${INGEST_BASE}/logs`

/**
 * `native` marks a platform served by a published SDK rather than by the
 * hand-rolled fetch fallback. It drives the surrounding copy, which otherwise
 * says "nothing to install" over the top of an install command.
 */
function installGuide(platform: string | null | undefined, key: string): { label: string, install: string, code: string, native: boolean } {
  const p = String(platform || 'javascript').toLowerCase()

  // Shared JS transport. Deliberately fire-and-forget and un-awaited: logging
  // must never block, and never reject into the caller's code path.
  const jsSend = `async function loghq(message, level = 'info', context) {\n`
    + `  try {\n`
    + `    await fetch('${INGEST_ENDPOINT}', {\n`
    + `      method: 'POST',\n`
    + `      headers: { 'Content-Type': 'application/json', 'X-LogHQ-Key': '${key}' },\n`
    + `      body: JSON.stringify({ logs: [{ message, level, context }] }),\n`
    + `    })\n`
    + `  }\n`
    + `  catch {} // never let logging break the app\n`
    + `}`

  const browserCapture = `${jsSend}\n\n`
    + `// uncaught errors and rejections\n`
    + `addEventListener('error', e => loghq(e.message, 'error', { stack: e.error?.stack }))\n`
    + `addEventListener('unhandledrejection', e => loghq(String(e.reason), 'error'))\n\n`
    + `// or explicitly\n`
    + `loghq('checkout failed', 'error', { cartId: 'cart_123' })`

  if (p === 'vue') {
    return {
      label: 'Vue',
      install: '',
      native: false,
      code: `${jsSend}\n\n`
        + `// main.ts — route Vue's error handler into loghq\n`
        + `app.config.errorHandler = (err, _instance, info) =>\n`
        + `  loghq(String(err), 'error', { info, stack: err?.stack })`,
    }
  }
  if (p === 'nuxt') {
    return {
      label: 'Nuxt',
      install: '',
      native: false,
      code: `// plugins/loghq.client.ts\n`
        + `${jsSend}\n\n`
        + `export default defineNuxtPlugin((nuxtApp) => {\n`
        + `  nuxtApp.hook('vue:error', err => loghq(String(err), 'error', { stack: err?.stack }))\n`
        + `})`,
    }
  }
  if (p === 'node') {
    return {
      label: 'Node.js',
      install: '',
      native: false,
      code: `${jsSend}\n\n`
        + `process.on('uncaughtException', e => loghq(e.message, 'critical', { stack: e.stack }))\n`
        + `process.on('unhandledRejection', r => loghq(String(r), 'error'))\n\n`
        + `await loghq('service started', 'info', { pid: process.pid })`,
    }
  }
  if (p === 'react') {
    return {
      label: 'React',
      install: '',
      native: false,
      code: `${browserCapture}\n\n`
        + `// render errors need an ErrorBoundary — call loghq() from componentDidCatch`,
    }
  }
  if (p === 'javascript' || p === 'browser')
    return { label: 'JavaScript', install: '', code: browserCapture, native: false }

  if (p === 'stacks') {
    return {
      label: 'Stacks',
      install: 'bun add @loghq/stacks',
      native: true,
      code: `// config/logging.ts\n`
        + `import type { LoggingConfig } from '@stacksjs/types'\n`
        + `import { loghqTransport } from '@loghq/stacks'\n`
        + `import { storagePath } from '@stacksjs/path'\n\n`
        + `export default {\n`
        + `  logsPath: storagePath('logs/stacks.log'),\n`
        + `  deploymentsPath: storagePath('logs/deployments.log'),\n`
        + `  transports: [\n`
        + `    loghqTransport({ key: '${key}' }),\n`
        + `  ],\n`
        + `} satisfies LoggingConfig\n\n`
        + `// That is the whole integration. Every log.* call already in your\n`
        + `// codebase now ships, and captureStruct (on by default) also forwards\n`
        + `// the framework's own http.request, db.query, db.slow_query, job.* and\n`
        + `// cache.* events, correlated by request id.`,
    }
  }
  if (p === 'laravel') {
    return {
      label: 'Laravel',
      install: '',
      native: false,
      code: `// app/Logging/LogHQHandler.php\n`
        + `use Illuminate\\Support\\Facades\\Http;\n`
        + `use Monolog\\Handler\\AbstractProcessingHandler;\n`
        + `use Monolog\\LogRecord;\n\n`
        + `class LogHQHandler extends AbstractProcessingHandler\n`
        + `{\n`
        + `    protected function write(LogRecord $record): void\n`
        + `    {\n`
        + `        Http::withHeaders(['X-LogHQ-Key' => '${key}'])\n`
        + `            ->post('${INGEST_ENDPOINT}', ['logs' => [[\n`
        + `                'message' => $record->message,\n`
        + `                'level'   => strtolower($record->level->getName()),\n`
        + `                'channel' => $record->channel,\n`
        + `                'context' => $record->context,\n`
        + `            ]]]);\n`
        + `    }\n`
        + `}\n\n`
        + `// config/logging.php — Monolog levels are RFC 5424, so they map 1:1\n`
        + `'loghq' => ['driver' => 'monolog', 'handler' => App\\Logging\\LogHQHandler::class],`,
    }
  }
  if (p === 'php') {
    return {
      label: 'PHP',
      install: '',
      native: false,
      code: `function loghq(string $message, string $level = 'info', array $context = []): void\n`
        + `{\n`
        + `    $ch = curl_init('${INGEST_ENDPOINT}');\n`
        + `    curl_setopt_array($ch, [\n`
        + `        CURLOPT_POST           => true,\n`
        + `        CURLOPT_RETURNTRANSFER => true,\n`
        + `        CURLOPT_TIMEOUT        => 2,\n`
        + `        CURLOPT_HTTPHEADER     => ['Content-Type: application/json', 'X-LogHQ-Key: ${key}'],\n`
        + `        CURLOPT_POSTFIELDS     => json_encode(['logs' => [compact('message', 'level', 'context')]]),\n`
        + `    ]);\n`
        + `    curl_exec($ch);\n`
        + `    curl_close($ch);\n`
        + `}`,
    }
  }
  return { label: 'HTML', install: '', code: browserCapture, native: false }
}
const guide = activeProject ? installGuide(activeProject.platform, keyFull) : { label: '', install: '', code: '' }

// Everything the client block is allowed to read from this scope, declared.
//
// This was seven JSON.stringify constants paired with seven JSON.parse calls in
// the client block. The hand-encoding existed for a real reason: a bare
// interpolation inside a script renders as a template literal, so a backtick or
// a dollar-brace in the value escapes it — and guide.code is generated source
// that contains both. defineClientPayload serialises each value with
// JSON.stringify itself and additionally escapes `<`, so it covers that case and
// the close-tag case the local version did not.
//
// Declaring also makes the set closed. The implicit bridge published a server
// binding whenever its name merely APPEARED in the client source; typecheck
// reported eleven values crossing here, one of which the client never used.
// Names are published because they are listed, not because they were mentioned.
//
// initialKeyFull / initialKeyMask are renamed on the way across: the client
// wraps both in signals under the bare names, and a bridged `var keyFull` would
// collide with the `const keyFull` that consumes it.
defineClientPayload({
  projectId,
  // The client block's onMount bounce reads this. It was NOT listed, so the
  // bounce threw `ReferenceError: needsOnboarding is not defined` on every
  // render and never ran — the same value is listed in dashboard.stx, which is
  // why only this page was broken.
  needsOnboarding,
  projectName: activeProject?.name || '',
  projectActive: activeProject ? activeProject.is_active !== false : true,
  installText: guide.install,
  codeText: guide.code,
  initialKeyFull: keyFull,
  initialKeyMask: keyMask,
})

useSeoMeta({
  title: 'Settings - loghq',
  description: 'Project settings: ingest key, team members, and alert channels.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Settings page. Replaces ~295 lines of imperative DOM work: element lookups,
// delegated listeners doing className sniffing, manual button-label swaps, and
// row.remove() calls. Every one of those is now state plus a binding.
//
// projectId, projectName, projectActive, installText, codeText and the two
// initialKey* values are declared by defineClientPayload in the server block and
// arrive already typed — there is nothing to declare or decode here. Do not add
// a local `const` for any of them: the bridge skips a name the client declares
// itself, so redeclaring one silently reverts it to undefined.

// ---- theme ----
// No mirror signal. The icon swap is a CSS rule keyed off the root element's
// data-theme (public/tokens.css), which stx's color-mode boot sets before first
// paint — so the right icon is painted rather than bound, and there is nothing
// here for a signal to hold.
function toggleTheme(): void {
  // The theme store owns persistence, the prefers-color-scheme listener, the
  // cross-tab storage listener and the dark-class write. This used to do the
  // first of those by hand and none of the rest, in three separate files.
  useStore('theme').toggle()
}

const authHeaders = (): Record<string, string> => ({
  'Authorization': `Bearer ${useStore('session').token()}`,
  'Content-Type': 'application/json',
})
const projUrl = `/api/projects/${encodeURIComponent(projectId || '')}`
const chBase = `${projUrl}/channels`

/** Read a JSON body without throwing on an empty or non-JSON response. */
async function readJson(res: Response): Promise<any> {
  try { return await res.json() }
  catch { return {} }
}

/**
 * Every authenticated call on this page goes through here.
 *
 * The ten mutations below are imperative one-shots against ten endpoints across
 * four verbs, so useMutation is the wrong shape — it binds one URL and one
 * method per instance. They stay raw fetch, but they were also the only authed
 * calls in the app with NO 401 handling: a stale token showed "Rotate failed"
 * or "Could not add member" and left the user on a page that would never work
 * again, rather than signing them out.
 *
 * This is the same contract the session store's configureFetch gives the data
 * primitives, applied to the one surface that cannot use them. Keep the two in
 * step: if the interceptor's 401 behaviour changes, change it here too.
 *
 * signOut() clears the token cookie and does a declared full load, so a caller
 * that keeps running after this returns is on a page that is already leaving.
 */
async function apiFetch(url: string, init: RequestInit = {}): Promise<Response> {
  const res = await fetch(url, {
    ...init,
    headers: { ...authHeaders(), ...(init.headers as Record<string, string> | undefined) },
  })
  if (res.status === 401)
    useStore('session').signOut()
  return res
}

// ---- copy buttons ----
const copiedInstall = state(false)
const copiedCode = state(false)
const copiedKey = state(false)

/**
 * Copy to the clipboard and light up the button that asked.
 *
 * `stx codemod` flags the `navigator.clipboard` call here and suggests
 * `useClipboard()`. It does not fit, for three separate reasons, all checked
 * against the shipped composable rather than assumed:
 *
 *   1. One instance owns ONE `copied` ref. This page has three independent
 *      copy buttons — the install snippet, the code snippet and the ingest key
 *      — and each needs its own lit state, so it would take three instances.
 *   2. That `copied` is a `{ readonly value: boolean }` ref, not a signal, so
 *      the template bindings that drive these buttons could not read it the
 *      way they read everything else on this page.
 *   3. It is not injected as a bare runtime global — reaching it means
 *      `window.stx`, and a bare `window.*` in a script block is exactly what
 *      the DOM guard forbids.
 *
 * So this stays. The flag is passed IN, which is what lets one helper serve
 * three buttons and one shared reset timer.
 */
/**
 * Named per-button handlers.
 *
 * The markup used to call `copyText(installText, copiedInstall)` straight from
 * `@click`, passing the signal as an argument. A template expression resolves
 * an identifier to its VALUE, so what arrived was the boolean `false`, not the
 * signal — and the click died on `flag.set is not a function`, silently,
 * because the only visible effect was a button that did nothing.
 *
 * Signals therefore stay inside the client block and the template calls a
 * no-argument handler. `stx typecheck` had been pointing here for weeks with
 * TS2349 "This expression is not callable" on the third of these.
 */
function copyInstall(): void {
  void copyText(installText, copiedInstall)
}

function copyCode(): void {
  void copyText(codeText, copiedCode)
}

function copyKey(): void {
  void copyText(keyFull(), copiedKey)
}

async function copyText(text: string, flag: StxSignal<boolean>): Promise<void> {
  try { await navigator.clipboard.writeText(text) }
  catch {}
  copiedFlag = flag
  flag.set(true)
  resetCopied.start()
}

// Parked timers, one per concern rather than one per call. useTimeout START
// on creation (it calls start() immediately), so each is stopped at once and
// re-armed at the point of use. Each registers its own onDestroy(stop) — which
// is the entire reason for the change: the bare setTimeout calls these replace
// were cancelled by nothing, so navigating away mid-countdown left them to fire
// against signals whose page had gone.
//
// The "which one" is held in a plain variable rather than making a timer per
// call site: creating a useTimeout inside a handler would register a fresh
// onDestroy on every click, which is a slower version of the same leak.
let copiedFlag: StxSignal<boolean> | null = null
const resetCopied = useTimeout(() => copiedFlag?.set(false), 1400)
resetCopied.stop()

const resetCopiedJoin = useTimeout(() => copiedJoin.set(''), 1600)
resetCopiedJoin.stop()

let busyChannelId = ''
const resetBusy = useTimeout(() => { if (busyChannelId) setBusy(busyChannelId, '') }, 2400)
resetBusy.stop()

/** Clear a channel's transient status label shortly after it is shown. */
function clearBusy(id: string): void {
  busyChannelId = id
  resetBusy.start()
}

// ---- project switcher ----
function switchProject(e: Event): void {
  useStore('session').project.set((e.target as HTMLSelectElement).value)
  // A DECLARED full document load, not an accidental one. The cookie was just
  // rewritten and the server render depends on it, so this must reach the
  // server again — and navigate() no-ops on a same-URL fragment navigation
  // (client.js:300), which would leave the page showing the old project.
  navigate('/settings', { reload: true })
}

// ---- ingest key ----
const keyFull = state(initialKeyFull)
const keyMask = state(initialKeyMask)
// ---- repository connection ----
const repo = state<any>(repository || null)
const repoRef = state('')
const repoToken = state('')
const repoBusy = state(false)
const repoNote = state('')
const repoNoteOk = state(true)

async function connectRepo(): Promise<void> {
  const ref = repoRef().trim()
  const token = repoToken().trim()
  if (!ref || !token) {
    note(repoNote, repoNoteOk, 'Enter a repository and a token.', false)
    return
  }
  repoBusy.set(true)
  try {
    const res = await apiFetch(`${projUrl}/repository`, { method: 'POST', body: JSON.stringify({ repository: ref, token }) })
    const body = await readJson(res)
    repoBusy.set(false)
    if (!res.ok) {
      note(repoNote, repoNoteOk, body.error || 'Could not connect.', false)
      return
    }
    repo.set(body.repository)
    // Cleared on success and never re-rendered: the token is write-only here.
    repoToken.set('')
    repoRef.set('')
    note(repoNote, repoNoteOk, 'Repository connected and the token verified.', true)
  }
  catch {
    repoBusy.set(false)
    note(repoNote, repoNoteOk, 'Network error. Try again.', false)
  }
}

async function verifyRepo(): Promise<void> {
  repoBusy.set(true)
  try {
    const res = await apiFetch(`${projUrl}/repository/verify`, { method: 'POST' })
    const body = await readJson(res)
    repoBusy.set(false)
    if (!res.ok) {
      note(repoNote, repoNoteOk, body.error || 'Verification failed.', false)
      return
    }
    repo.set(body.repository)
    note(repoNote, repoNoteOk, 'Token still works.', true)
  }
  catch {
    repoBusy.set(false)
    note(repoNote, repoNoteOk, 'Network error. Try again.', false)
  }
}

async function disconnectRepo(): Promise<void> {
  const ask = window.stxConfirm
    ? window.stxConfirm('The stored token is deleted. Fix with AI can still analyse log entries, but it will not be able to open pull requests until a repository is connected again.', { title: 'Disconnect repository?', confirmText: 'Disconnect', cancelText: 'Cancel', type: 'warning' })
    : Promise.resolve(true)
  if (!(await Promise.resolve(ask)))
    return
  repoBusy.set(true)
  try {
    const res = await apiFetch(`${projUrl}/repository`, { method: 'DELETE' })
    repoBusy.set(false)
    if (!res.ok) {
      const body = await readJson(res)
      note(repoNote, repoNoteOk, body.error || 'Could not disconnect.', false)
      return
    }
    repo.set(null)
    note(repoNote, repoNoteOk, 'Repository disconnected.', true)
  }
  catch {
    repoBusy.set(false)
    note(repoNote, repoNoteOk, 'Network error. Try again.', false)
  }
}

const keyRevealed = state(false)
const rotating = state(false)
const keyNote = state('')
const keyNoteOk = state(true)

const keyShown = (): string => (keyRevealed() ? keyFull() : keyMask())

function note(msgSig: StxSignal<string>, okSig: StxSignal<boolean>, msg: string, ok: boolean): void {
  msgSig.set(msg)
  okSig.set(ok)
}

async function rotateKey(): Promise<void> {
  const ask = window.stxConfirm
    ? window.stxConfirm('The current key stops working immediately, and anything still sending it will get 401 until you update it. Continue?', { title: 'Rotate ingest key?', confirmText: 'Rotate key', cancelText: 'Cancel', type: 'warning' })
    // No window.confirm fallback. stxConfirm ships with the runtime, so the
    // branch only fired if the runtime had not loaded — in which case the
    // button that calls this is not bound either and nothing can reach here.
    : Promise.resolve(true)
  if (!(await Promise.resolve(ask)))
    return
  rotating.set(true)
  try {
    const res = await apiFetch(`${projUrl}/rotate-key`, { method: 'POST' })
    const body = await readJson(res)
    rotating.set(false)
    if (!res.ok) {
      note(keyNote, keyNoteOk, body.error || 'Rotate failed.', false)
      return
    }
    keyFull.set(body.ingest_key)
    keyRevealed.set(true)
    note(keyNote, keyNoteOk, 'New key generated. Update anything sending the old one.', true)
  }
  catch {
    rotating.set(false)
    note(keyNote, keyNoteOk, 'Network error.', false)
  }
}

// ---- members and invites ----
const inviteEmail = state('')
const inviting = state(false)
const inviteNote = state('')
const inviteNoteOk = state(true)
const removedMembers = state<string[]>([])
const removingMember = state('')
const copiedJoin = state('')

const isMemberRemoved = (id: string): boolean => removedMembers().includes(id)
const memberBtnLabel = (id: string): string => (removingMember() === id ? 'Removing…' : 'Remove')
const joinBtnLabel = (id: string): string => (copiedJoin() === id ? 'Copied ✓' : 'Copy link')

async function copyJoin(id: string, link: string): Promise<void> {
  try { await navigator.clipboard.writeText(link) }
  catch {}
  copiedJoin.set(id)
  resetCopiedJoin.start()
}

async function addInvite(): Promise<void> {
  const email = inviteEmail().trim()
  if (!email) {
    note(inviteNote, inviteNoteOk, 'Enter an email address.', false)
    return
  }
  inviting.set(true)
  try {
    const res = await apiFetch(`${projUrl}/members`, { method: 'POST', body: JSON.stringify({ email }) })
    const body = await readJson(res)
    inviting.set(false)
    if (!res.ok) {
      note(inviteNote, inviteNoteOk, body.error || 'Could not invite.', false)
      return
    }
    navigate('/settings', { reload: true })
  }
  catch {
    inviting.set(false)
    note(inviteNote, inviteNoteOk, 'Network error.', false)
  }
}

async function removeMember(id: string): Promise<void> {
  if (removingMember())
    return
  removingMember.set(id)
  try {
    const res = await apiFetch(`${projUrl}/members/${encodeURIComponent(id)}`, { method: 'DELETE' })
    removingMember.set('')
    if (res.ok)
      removedMembers.set([...removedMembers(), id])
  }
  catch {
    removingMember.set('')
  }
}

// ---- alert channels ----
// The two channel kinds, as a type rather than a convention. `state('slack')`
// infers `string`, which made PLACEHOLDERS[chType()] and HELPS[chType()] index
// a two-key object with an arbitrary string — an implicit `any` that would have
// returned undefined for a typo instead of failing. The only writers are the
// two segmented buttons, which set exactly these values.
type ChannelType = 'slack' | 'discord'
const chType = state<ChannelType>('slack')
const whUrl = state('')
const whLabel = state('')
const adding = state(false)
const whNote = state('')
const whNoteOk = state(true)
const removedChannels = state<string[]>([])
const channelBusy: StxSignal<Record<string, string>> = state({})
const channelOn: StxSignal<Record<string, boolean>> = state({})

const PLACEHOLDERS = { slack: 'https://hooks.slack.com/services/…', discord: 'https://discord.com/api/webhooks/…' }
const HELPS = {
  slack: 'In Slack: Apps → Incoming Webhooks → Add to a channel, then paste the hooks.slack.com/services/… URL.',
  discord: 'In Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.',
}
const whPlaceholder = (): string => PLACEHOLDERS[chType()]
const whHelp = (): string => HELPS[chType()]

const isChannelRemoved = (id: string): boolean => removedChannels().includes(id)
const testLabel = (id: string): string => channelBusy()[id] || 'Test'
const deleteLabel = (id: string): string => (channelBusy()[id] === 'Removing…' ? 'Removing…' : 'Remove')
/** Enabled state, defaulting to the server-rendered value until toggled. */
const isChannelOn = (id: string, initial: boolean): boolean => (id in channelOn() ? channelOn()[id] : initial)

function setBusy(id: string, value: string): void {
  channelBusy.set({ ...channelBusy(), [id]: value })
}

async function addChannel(): Promise<void> {
  const url = whUrl().trim()
  if (!url) {
    note(whNote, whNoteOk, 'Paste a webhook URL first.', false)
    return
  }
  adding.set(true)
  note(whNote, whNoteOk, 'Adding…', true)
  try {
    const res = await apiFetch(chBase, { method: 'POST', body: JSON.stringify({ type: chType(), webhook_url: url, label: whLabel().trim() }) })
    const body = await readJson(res)
    if (!res.ok) {
      adding.set(false)
      note(whNote, whNoteOk, body.error || 'Could not add that channel.', false)
      return
    }
    navigate('/settings', { reload: true })
  }
  catch {
    adding.set(false)
    note(whNote, whNoteOk, 'Network error. Try again.', false)
  }
}

async function testChannel(id: string): Promise<void> {
  if (channelBusy()[id])
    return
  setBusy(id, 'Sending…')
  try {
    const res = await apiFetch(`${chBase}/${encodeURIComponent(id)}/test`, { method: 'POST' })
    setBusy(id, res.ok ? 'Sent ✓' : 'Failed')
  }
  catch {
    setBusy(id, 'Failed')
  }
  clearBusy(id)
}

async function toggleChannel(id: string, initial: boolean): Promise<void> {
  const next = !isChannelOn(id, initial)
  channelOn.set({ ...channelOn(), [id]: next })
  try {
    const res = await apiFetch(`${chBase}/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ enabled: next }) })
    if (!res.ok)
      channelOn.set({ ...channelOn(), [id]: !next })
  }
  catch {
    // Roll back so the switch never claims a state the server rejected.
    channelOn.set({ ...channelOn(), [id]: !next })
  }
}

async function deleteChannel(id: string): Promise<void> {
  if (channelBusy()[id])
    return
  setBusy(id, 'Removing…')
  try {
    const res = await apiFetch(`${chBase}/${encodeURIComponent(id)}`, { method: 'DELETE' })
    setBusy(id, '')
    if (res.ok)
      removedChannels.set([...removedChannels(), id])
  }
  catch {
    setBusy(id, '')
  }
}

// ---- danger zone: type-to-confirm modal ----
const modalKind = state('')
const modalInput = state('')
const modalBusy = state(false)
const modalNote = state('')
const archiving = state(false)

const modalOpen = (): boolean => modalKind() !== ''
const modalTitle = (): string => (modalKind() === 'delete' ? `Delete ${projectName}?` : `Archive ${projectName}?`)
const modalDesc = (): string => (modalKind() === 'delete'
  ? 'This permanently deletes the project and all of its log entries, alert channels, members, and invites. This cannot be undone.'
  : 'loghq will stop accepting new log entries for this project. Everything already stored is kept, and you can unarchive anytime.')
const modalConfirmLabel = (): string => {
  if (modalBusy())
    return modalKind() === 'delete' ? 'Deleting…' : 'Archiving…'
  return modalKind() === 'delete' ? 'Delete project' : 'Archive project'
}
/** The type-to-confirm gate: the typed name must match exactly. */
const modalReady = (): boolean => modalInput().trim() === projectName && !modalBusy()

// ---- modal focus management ----
//
// The overlay had role="dialog" and aria-modal="true" and behaved like neither.
// Measured in a browser before this change: opening it left focus on the
// trigger button (focusInsideDialog:false), six Tab presses walked focus out of
// the dialog and into the page behind it, and document.body kept
// overflow:visible so the page scrolled under the overlay. For a confirmation
// that deletes a project and all of its log entries, that is the wrong
// behaviour to ship.
//
// Not the shipped <Dialog>: it provides role, aria-modal, :show and an Escape
// handler bound to the dialog ELEMENT — which only fires once focus is already
// inside, the very thing that was broken here. It has no focus trap, no scroll
// lock and no focus restore, so adopting it would have removed this page's
// document-level Escape and added none of what was missing.
const modalPanel = useRef('modalPanel')
const scrollLocked = useScrollLock()
let restoreFocusTo: HTMLElement | null = null

/**
 * Focusable descendants of the panel, in DOM order.
 *
 * Enumerated from the ref'd element rather than from the document — which is
 * what the strict validator itself suggests, and why this is not a DOM-guard
 * violation. `:disabled` on the confirm button means the tail of this list
 * changes as the type-to-confirm gate opens, so it is recomputed per keystroke
 * rather than cached.
 */
function modalFocusables(): HTMLElement[] {
  const panel = modalPanel.current as HTMLElement | null
  if (!panel)
    return []
  return Array.from(
    panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])'),
  )
}

/**
 * Wrap Tab at the ends of the panel.
 *
 * `e.target` is the focused element for a keydown, so this needs no
 * document.activeElement — which the DOM guard prohibits and which would have
 * been the obvious way to write it.
 */
function onModalKeydown(e: KeyboardEvent): void {
  if (e.key !== 'Tab')
    return
  const items = modalFocusables()
  if (items.length === 0)
    return
  const first = items[0]
  const last = items[items.length - 1]
  if (e.shiftKey && e.target === first) {
    e.preventDefault()
    last.focus()
  }
  else if (!e.shiftKey && e.target === last) {
    e.preventDefault()
    first.focus()
  }
}

/** Open with focus moved into the panel, the page locked, and a way back out. */
function openModal(kind: 'archive' | 'delete', e?: Event): void {
  restoreFocusTo = (e?.currentTarget as HTMLElement | null) ?? null
  modalInput.set('')
  modalNote.set('')
  modalKind.set(kind)
  scrollLocked.set(true)
  // After the :show binding has painted the panel, not before.
  nextTick(() => modalFocusables()[0]?.focus())
}

function closeModal(): void {
  modalKind.set('')
  modalInput.set('')
  modalNote.set('')
  modalBusy.set(false)
  scrollLocked.set(false)
  // Back to the control that opened it, so a keyboard user is not dropped at
  // the top of the document.
  restoreFocusTo?.focus()
  restoreFocusTo = null
}

function openArchive(e: Event): void {
  // Unarchiving is non-destructive, so it skips the confirm entirely.
  if (!projectActive) {
    unarchive()
    return
  }
  openModal('archive', e)
}

function openDelete(e: Event): void {
  openModal('delete', e)
}

async function unarchive(): Promise<void> {
  archiving.set(true)
  try {
    const res = await apiFetch(`${projUrl}/archive`, { method: 'POST', body: JSON.stringify({ archived: false }) })
    if (res.ok) {
      navigate('/settings', { reload: true })
      return
    }
    archiving.set(false)
  }
  catch {
    archiving.set(false)
  }
}

async function confirmModal(): Promise<void> {
  if (!modalReady())
    return
  modalBusy.set(true)
  const kind = modalKind()
  try {
    const res = kind === 'delete'
      ? await apiFetch(projUrl, { method: 'DELETE' })
      : await apiFetch(`${projUrl}/archive`, { method: 'POST', body: JSON.stringify({ archived: true }) })
    if (!res.ok) {
      modalBusy.set(false)
      modalNote.set(kind === 'delete' ? 'Delete failed.' : 'Archive failed.')
      return
    }
    if (kind === 'delete') {
      useStore('session').project.set('')
      navigate('/projects')
    }
    else {
      navigate('/settings', { reload: true })
    }
  }
  catch {
    modalBusy.set(false)
    modalNote.set('Network error.')
  }
}

// Escape closes the modal. Bound to the document because no element owns the
// keyboard globally — a listener on a thing no component owns, not render
// wiring. useEventListener registers the matching removeEventListener via
// onDestroy.
//
// The target is an OPTION here, not the first argument. Two different
// functions ship under this name and only one of them is in scope:
//
//   browser-composables.ts  target-first — (target, event, handler, options?)
//   signals.ts              (event, handler, options) with options.target,
//                           defaulting to window
//
// A bare call in a <script client> block resolves to the signals.ts one,
// because that is what the runtime-globals preamble injects. So this form is
// correct and `{ target: document }` is honoured — `var target = (options &&
// options.target) || window`.
//
// Do not "fix" this to the target-first form. I did, on 0.2.176, after reading
// browser-composables.js and taking it for the implementation: it passes
// `document` as the EVENT NAME and the handler as the options bag, so Escape
// silently stops closing the modal. types/stx-runtime.d.ts already documented
// the split; the shipped stx.d.ts declares only the window-target overloads,
// which is why `stx typecheck` reports TS2769 on the correct code. That
// diagnostic is the checker's, not ours.
useEventListener('keydown', (e: KeyboardEvent) => {
  if (e.key === 'Escape' && modalOpen())
    closeModal()
}, { target: document })

// Onboarding bounce. The server block already computed needsOnboarding, and it
// crosses to here through the server-to-client bridge, so this is not a second
// decision — it is the same one, acted on somewhere cancellable and lintable.
// It replaces a <script> tag emitted as page CONTENT, which is not a redirect:
// it is a fully rendered page that then tears itself down, costing a paint and
// a second document load on a route the server already knew was wrong.
onMount(() => {
  if (needsOnboarding)
    navigate('/projects/new', { reload: true })
})
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
{{-- No hand-written theme guard here. config/ui.ts declares app.colorMode, and
    stx emits the pre-paint boot script from that one declaration — first inside
    <head>, above every stylesheet, reading the same loghq_theme key and setting
    the same data-theme attribute this script used to set by hand. The generated
    one is strictly better: it also resolves 'auto' against
    prefers-color-scheme, which the three copies here never did. --}}

<div class="px-5 py-10 md:px-10 min-h-[100dvh]">
  <div class="mx-auto max-w-2xl">

    <header class="flex gap-4 items-center justify-between mb-7">
      <StxLink to="/projects" class="wordmark-link"><h1 class="leading-none text-2xl wordmark">loghq</h1></StxLink>
      <div class="flex gap-2 items-center">
        <button @click="toggleTheme" class="icon-btn theme-btn" x-tooltip="Toggle theme" aria-label="Toggle theme">
          <Icon name="lucide:sun" size="17" class="h-[17px] w-[17px] ic-sun" />
          <Icon name="lucide:moon" size="17" class="h-[17px] w-[17px] ic-moon" />
        </button>
        <StxLink to="/dashboard" class="px-3.5 py-2 font-medium text-muted text-sm hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">← Dashboard</StxLink>
      </div>
    </header>

    @if (!user)
      <div class="py-24 text-center text-sm text-subtle">Loading…</div>
    @endif

    {{-- Say the database is unreachable rather than leaving the skeleton above
        in place, which is what an unguarded throw produced: HTTP 200, a page
        truncated to "Loading…", and nothing to act on. --}}
    @if (user && projectsUnavailable)
      <div class="py-24 text-center">
        <p class="text-muted text-sm"><span class="font-semibold text-ink">Can't reach your settings right now.</span> Make sure Postgres is provisioned.</p>
        <p class="mt-2 text-subtle text-xs">Nothing has been changed — reload once the database is back.</p>
      </div>
    @endif

    @if (user && activeProject)
      <div class="mb-6">
        <div class="flex flex-wrap gap-3 items-center">
          <h2 class="font-semibold text-xl tracking-[-0.02em]">Settings</h2>
          @if (projects.length > 1)
            <select @change="switchProject" aria-label="Switch project" class="px-3 py-1.5 font-mono text-muted text-sm app-panel">
              @foreach (projects as p)
                <option value="{{ p.id }}" {{ p.id === projectId ? 'selected' : '' }}>{{ p.name }}</option>
              @endforeach
            </select>
          @else
            <span class="font-mono text-muted text-sm">{{ activeProject?.name }}</span>
          @endif
        </div>
        <p class="mt-1.5 text-sm text-subtle">Manage the API key, team, alerts, and deletion for this project.</p>
      </div>

      {{-- flex-wrap for the same reason as the dashboard header: five pills on
          one unbreakable line pushed settings 31px past a 375px viewport, so
          the whole page scrolled sideways. Wrapping rather than
          `overflow-x-auto` because these are the page's section links — all
          five should be visible, not discovered by swiping a strip. --}}
      <nav class="flex flex-wrap gap-2 items-center mb-8 text-sm">
        <a href="#install" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Install</a>
        <a href="#keys" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Keys</a>
        <a href="#repository" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Repository</a>
        <a href="#members" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Members</a>
        <a href="#alerts" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Alerts</a>
        <a href="#retention" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Retention</a>
        <a href="#danger" class="px-3 py-1.5 font-medium text-muted hover:text-ink border border-line rounded-[999px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Danger</a>
      </nav>

      {{-- ============================ INSTALL ============================ --}}
      <section id="install" class="mb-10 scroll-mt-[84px]">
        <div class="mb-3 font-semibold text-[13px] text-subtle tracking-[0.04em] uppercase">Install</div>
        <div class="px-5 py-5 app-panel">
          <div class="flex gap-3 items-center justify-between mb-3.5">
            @if (guide.native)
              <p class="text-sm text-subtle">Stream <span class="font-mono text-muted">{{ activeProject?.name }}</span> through its SDK. Declare the transport once and every log call you already write lands here, searchable and correlatable.</p>
            @else
              <p class="text-sm text-subtle">Send logs to <span class="font-mono text-muted">{{ activeProject?.name }}</span> over plain HTTP. Nothing to install, and every entry lands in your stream, searchable and correlatable.</p>
            @endif
            <span class="shrink-0 px-[9px] py-0.5 font-semibold text-[11px] text-accent tracking-[0.02em] bg-[color-mix(in_srgb,var(--accent)_14%,var(--panel))] rounded-[999px]">{{ guide.label }}</span>
          </div>
          @if (guide.install)
            <div class="relative mb-2">
              <div class="overflow-x-auto pl-4 pr-16 py-3 font-mono leading-[1.5] text-[12px] text-muted bg-canvas border border-line rounded-[10px]">{{ guide.install }}</div>
              <button type="button" @click="copyInstall" class="absolute right-2 top-2 px-[9px] py-[5px] font-medium font-sans leading-none text-[11px] text-subtle hover:text-ink bg-panel border border-line rounded-[7px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] cursor-pointer [transition:color_0.15s_ease,border-color_0.15s_ease]" :text="copiedInstall() ? 'Copied' : 'Copy'">Copy</button>
            </div>
          @endif
          <div class="relative">
            <div class="overflow-x-auto pl-4 pr-16 py-3 font-mono leading-[1.5] text-[12px] text-muted whitespace-pre bg-canvas border border-line rounded-[10px]">{{ guide.code }}</div>
            <button type="button" @click="copyCode" class="absolute right-2 top-2 px-[9px] py-[5px] font-medium font-sans leading-none text-[11px] text-subtle hover:text-ink bg-panel border border-line rounded-[7px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] cursor-pointer [transition:color_0.15s_ease,border-color_0.15s_ease]" :text="copiedCode() ? 'Copied' : 'Copy'">Copy</button>
          </div>
          <p class="mt-3.5 leading-relaxed text-subtle text-xs">
            @if (guide.native)
              The SDK batches, retries and flushes on exit for you. The
            @else
              Native SDKs are in progress. Until then this is the whole integration, and the
            @endif
            <a href="https://github.com/stacksjs/loghq/blob/main/docs/ingest.md" class="text-muted underline underline-offset-2 hover:text-ink [transition:color_0.15s_ease,text-decoration-color_0.15s_ease] decoration-[var(--border)] hover:decoration-[currentColor]" target="_blank" rel="noreferrer">ingest spec</a>
            documents every field, limit, and retry rule if you want batching or backoff.
          </p>
        </div>
      </section>

      {{-- ============================ KEYS ============================ --}}
      <section id="keys" class="mb-10 scroll-mt-[84px]">
        <div class="mb-3 font-semibold text-[13px] text-subtle tracking-[0.04em] uppercase">API key</div>
        <div class="px-5 py-5 app-panel">
          <p class="mb-4 text-sm text-subtle">
            This key authorizes log ingest for <span class="font-mono text-muted">{{ activeProject?.name }}</span>.
            It's a public identifier (safe to ship in client code), not a secret — it says <em>which</em> project an entry belongs to, and grants no read access.
          </p>
          <div class="flex flex-wrap gap-2 items-center">
            <code class="flex-1 px-3.5 py-2.5 min-w-[220px] font-mono text-ink text-sm tracking-[0.01em] truncate bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none" :text="keyShown()">{{ keyMask }}</code>
            <button @click="keyRevealed.set(!keyRevealed())" class="px-3 py-2 font-medium text-muted text-sm hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]" :text="keyRevealed() ? 'Hide' : 'Reveal'">Reveal</button>
            <button @click="copyKey" class="px-3 py-2 font-medium text-muted text-sm hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]" :text="copiedKey() ? 'Copied' : 'Copy'">Copy</button>
            <button @click="rotateKey" :disabled="rotating()" class="px-3 py-2 font-medium text-sm text-warn hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]">Rotate</button>
          </div>
          <p class="mt-3.5 leading-relaxed text-subtle text-xs">
            Rotating generates a new key and <span class="text-warn">invalidates the current one immediately</span> — anything still sending the old key will get 401 until you update it (<span class="font-mono">X-LogHQ-Key</span>).
          </p>
          <span class="mt-2 text-ok text-xs" :show="!!keyNote()" :class="keyNoteOk() ? 'mt-2 text-xs text-ok' : 'mt-2 text-xs text-accent'">{{ keyNote() }}</span>
        </div>
      </section>

      {{-- ========================== REPOSITORY ========================== --}}
      <section id="repository" class="mb-10 scroll-mt-[84px]">
        <div class="mb-3 font-semibold text-[13px] text-subtle tracking-[0.04em] uppercase">Repository</div>
        <div class="px-5 py-5 app-panel">
          <p class="mb-4 text-sm text-subtle">
            Connect the repository this project's code lives in, and Fix with AI can read the files it
            suspects and open a draft pull request with the change. Without it an analysis can still
            explain the failure, but it is reasoning about code it has never seen.
          </p>

          {{-- Connected --}}
          <div :show="!!repo()">
            <div class="flex flex-wrap gap-2 items-center mb-3.5">
              <code class="flex-1 px-3.5 py-2.5 min-w-[220px] font-mono text-ink text-sm truncate bg-canvas border border-line rounded-[10px]" :text="repo()?.full_name">.</code>
              <button @click="verifyRepo" :disabled="repoBusy()" class="px-3 py-2 font-medium text-muted text-sm hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Verify</button>
              <button @click="disconnectRepo" :disabled="repoBusy()" class="px-3 py-2 font-medium text-sm text-warn hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]">Disconnect</button>
            </div>
            <dl class="grid grid-cols-2 gap-y-1.5 text-xs sm:grid-cols-3">
              <div><dt class="text-subtle">Default branch</dt><dd class="font-mono text-muted" :text="repo()?.default_branch || 'unknown'">.</dd></div>
              <div><dt class="text-subtle">Token</dt><dd class="font-mono text-muted" :text="repo()?.token_hint ? ('ending ' + repo().token_hint) : 'stored'">.</dd></div>
              <div><dt class="text-subtle">Last verified</dt><dd class="font-mono text-muted" :text="repo()?.last_verified_at || 'never'">.</dd></div>
            </dl>
          </div>

          {{-- Not connected --}}
          <div :show="!repo()">
            <label class="block mb-1.5 font-medium text-muted text-xs" for="repo-ref">Repository</label>
            <input id="repo-ref" :model="repoRef" type="text" placeholder="owner/name, or paste the GitHub URL" class="mb-3 px-3.5 py-2.5 w-full font-mono text-ink text-sm bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none">

            <label class="block mb-1.5 font-medium text-muted text-xs" for="repo-token">GitHub token</label>
            <input id="repo-token" :model="repoToken" type="password" autocomplete="off" placeholder="github_pat_..." class="mb-3 px-3.5 py-2.5 w-full font-mono text-ink text-sm bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none">

            <button @click="connectRepo" :disabled="repoBusy()" class="px-3.5 py-2.5 font-semibold text-sm btn-solid">Connect repository</button>

            <p class="mt-3.5 leading-relaxed text-subtle text-xs">
              Use a <span class="text-muted">fine-grained</span> personal access token scoped to this one
              repository, with <span class="font-mono">Contents: read and write</span> and
              <span class="font-mono">Pull requests: read and write</span>. It is encrypted before it is
              stored and is never sent back to this page. The token is checked against GitHub before it is
              saved, so a wrong scope fails here rather than inside a fix run.
            </p>
          </div>

          <span class="mt-2 text-xs" :show="!!repoNote()" :class="repoNoteOk() ? 'mt-2 text-xs text-ok' : 'mt-2 text-xs text-accent'">{{ repoNote() }}</span>
        </div>
      </section>

      {{-- ============================ MEMBERS ============================ --}}
      <section id="members" class="mb-10 scroll-mt-[84px]">
        <div class="mb-3 font-semibold text-[13px] text-subtle tracking-[0.04em] uppercase">Members</div>
        <div class="flex flex-col gap-2.5 mb-4">
          {{-- Owner (always first, not removable) --}}
          <div class="flex gap-3.5 items-center px-4 py-3.5 app-panel">
            <span class="grid place-items-center shrink-0 h-8 w-8 font-semibold text-accent bg-[color-mix(in_srgb,var(--accent)_16%,var(--panel))] rounded-lg">{{ (ownerEmail || '?').charAt(0).toUpperCase() }}</span>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm truncate">{{ ownerEmail }}</div>
              <div class="mt-0.5 text-subtle text-xs">Full access</div>
            </div>
            <span class="px-[9px] py-0.5 font-semibold text-[11px] text-accent tracking-[0.02em] bg-[color-mix(in_srgb,var(--accent)_16%,var(--panel))] rounded-[999px]">Owner</span>
          </div>
          @foreach (memberView as m)
            <div class="flex gap-3.5 items-center px-4 py-3.5 app-panel" :show="!isMemberRemoved('{{ m.id }}')">
              <span class="grid place-items-center shrink-0 h-8 w-8 font-semibold text-muted bg-[color-mix(in_srgb,var(--text-3)_16%,var(--panel))] rounded-lg">{{ (m.email || '?').charAt(0).toUpperCase() }}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{{ m.email }}</div>
                <div class="mt-0.5 text-subtle text-xs">Can read the log stream</div>
              </div>
              <span class="px-[9px] py-0.5 font-semibold text-[11px] text-accent tracking-[0.02em] bg-[color-mix(in_srgb,var(--accent)_14%,var(--panel))] rounded-[999px]">Member</span>
              <button @click="removeMember('{{ m.id }}')" :disabled="removingMember() === '{{ m.id }}'" :text="memberBtnLabel('{{ m.id }}')" class="px-2.5 py-1.5 font-medium text-warn text-xs hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]" x-tooltip="Remove">Remove</button>
            </div>
          @endforeach
          @foreach (inviteView as i)
            <div class="flex gap-3.5 items-center px-4 py-3.5 app-panel" :show="!isMemberRemoved('{{ i.id }}')">
              <span class="grid place-items-center shrink-0 h-8 w-8 font-semibold text-subtle bg-[color-mix(in_srgb,var(--text-3)_12%,var(--panel))] rounded-lg">{{ (i.email || '?').charAt(0).toUpperCase() }}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{{ i.email }}</div>
                <div class="mt-0.5 text-subtle text-xs">{{ i.registered ? 'Has an account — pending accept' : 'Invite sent — awaiting sign-up' }}</div>
              </div>
              <span class="px-[9px] py-0.5 font-semibold text-[11px] text-muted tracking-[0.02em] bg-[color-mix(in_srgb,var(--text-3)_18%,var(--panel))] rounded-[999px]" x-tooltip="Pending — becomes a member once they accept">Invited</span>
              <button @click="copyJoin('{{ i.id }}', '{{ i.join }}')" :text="joinBtnLabel('{{ i.id }}')" class="px-2.5 py-1.5 font-medium text-muted text-xs hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]" x-tooltip="Copy join link">Copy link</button>
              <button @click="removeMember('{{ i.id }}')" :disabled="removingMember() === '{{ i.id }}'" :text="memberBtnLabel('{{ i.id }}')" class="px-2.5 py-1.5 font-medium text-warn text-xs hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]" x-tooltip="Revoke invite">Remove</button>
            </div>
          @endforeach
        </div>
        <div class="px-5 py-5 app-panel">
          <div class="mb-3 font-semibold text-sm">Invite a teammate</div>
          <div class="flex flex-wrap gap-2 items-center">
            <input :model="inviteEmail" type="email" aria-label="Invite a teammate by email" class="flex-1 px-3.5 py-2.5 min-w-[220px] text-ink text-sm bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none" placeholder="teammate@company.com" autocomplete="off">
            <button @click="addInvite" :disabled="inviting()" class="px-4 py-2.5 font-semibold text-sm text-accent-ink bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px] disabled:opacity-55 disabled:cursor-default [transition:background_0.15s_ease,opacity_0.15s_ease]" :text="inviting() ? 'Inviting…' : 'Invite'">Invite</button>
          </div>
          <span class="mt-2.5 text-ok text-xs" :show="!!inviteNote()" :class="inviteNoteOk() ? 'mt-2.5 text-xs text-ok' : 'mt-2.5 text-xs text-accent'">{{ inviteNote() }}</span>
          <p class="mt-3.5 leading-relaxed text-subtle text-xs">
            We email them a join link. They sign up (or log in) with that email, then accept from a banner in the app. Members can read the log stream; only you can manage keys, members, and deletion.
          </p>
        </div>
      </section>

      {{-- ============================ ALERTS ============================ --}}
      <section id="alerts" class="mb-10 scroll-mt-[84px]">
        <div class="mb-3 font-semibold text-[13px] text-subtle tracking-[0.04em] uppercase">Alerts</div>
        <p class="mb-4 text-sm text-subtle">
          Add a Slack or Discord webhook and send a test to verify it. Automatic delivery isn't live yet —
          channels you add here are saved and testable, but loghq won't fire on its own until log-based alert rules ship.
        </p>
        <div class="flex flex-col gap-2.5 mb-4">
          @forelse (channelView as c)
            <div class="flex gap-3.5 items-center px-4 py-3.5 app-panel" :show="!isChannelRemoved('{{ c.id }}')">
              {{-- The class used to be `badge-{{ c.type }}`, which emits
                  `badge-slack` or `badge-discord` — and neither class exists
                  anywhere in the project, so the pill rendered unstyled. A
                  name assembled by interpolation cannot be found by grepping
                  for the class either, which is why it survived this long.
                  The brand treatment here matches .seg-slack / .seg-discord in
                  app-chrome.css: solid brand background, white text. --}}
              <span class="rounded-[999px] text-[11px] font-semibold tracking-[0.02em] px-[9px] py-0.5 text-accent-ink {{ c.type === 'slack' ? 'bg-[var(--slack)]' : 'bg-[var(--discord)]' }}">{{ c.type === 'slack' ? 'Slack' : 'Discord' }}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{{ c.label }}</div>
                <div class="mt-0.5 font-mono text-subtle text-xs truncate">{{ c.mask }}</div>
              </div>
              <button @click="testChannel('{{ c.id }}')" :text="testLabel('{{ c.id }}')" class="px-2.5 py-1.5 font-medium text-muted text-xs hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]" x-tooltip="Send a test message">Test</button>
              {{-- A real <button>, not a <div role="switch">. As a div this had
                  no tabindex, no key handler and no accessible name: measured
                  in a browser it reported focusable:false and ariaLabel:null,
                  so the only control for enabling an alert channel was
                  unreachable by keyboard and anonymous to a screen reader.
                  A button gives focusability, Space/Enter activation and the
                  focus ring for free, which is precisely the behaviour that
                  should not be hand-rolled.

                  NOT the shipped <Switch>: it renders a 74x38 blue track
                  (bg-blue-500, sizeConfig.md) against this app's 38x22
                  var(--ok) one, and its state colours are hard-coded rather
                  than tokenised. Adopting it means restyling the control to
                  match the component instead of the product. The a11y gap was
                  the defect; the platform element closes it. --}}
              <button type="button" role="switch" aria-label="Enable {{ c.label }}" data-on="{{ c.enabled ? '1' : '0' }}" aria-checked="{{ c.enabled ? 'true' : 'false' }}" class="relative flex-none p-0 h-[22px] w-[38px] bg-line border-none rounded-[999px] appearance-none cursor-pointer [transition:background_0.15s_ease] tgl" @click="toggleChannel('{{ c.id }}', {{ c.enabled ? 'true' : 'false' }})" :data-on="isChannelOn('{{ c.id }}', {{ c.enabled ? 'true' : 'false' }}) ? '1' : '0'" :aria-checked="isChannelOn('{{ c.id }}', {{ c.enabled ? 'true' : 'false' }}) ? 'true' : 'false'" x-tooltip="Enable / disable"></button>
              <button @click="deleteChannel('{{ c.id }}')" :text="deleteLabel('{{ c.id }}')" class="px-2.5 py-1.5 font-medium text-warn text-xs hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]" x-tooltip="Remove">Remove</button>
            </div>
          @empty
            <div class="px-5 py-8 text-center app-panel">
              <div class="mb-1 font-medium text-sm">No chat alerts yet</div>
              <div class="text-subtle text-xs">Add a Slack or Discord webhook below to start getting pinged.</div>
            </div>
          @endforelse
        </div>
        <div class="px-5 py-5 app-panel">
          <div class="mb-3.5 font-semibold text-sm">Add a channel</div>
          <div class="grid gap-2 grid-cols-2 mb-3">
            <button type="button" @click="chType.set('slack')" data-sel="1" :data-sel="chType() === 'slack' ? '1' : '0'" class="px-3 py-2.5 font-medium text-muted text-sm bg-panel border border-line rounded-[10px] [transition:all_0.12s_ease] seg seg-slack">Slack</button>
            <button type="button" @click="chType.set('discord')" data-sel="0" :data-sel="chType() === 'discord' ? '1' : '0'" class="px-3 py-2.5 font-medium text-muted text-sm bg-panel border border-line rounded-[10px] [transition:all_0.12s_ease] seg seg-discord">Discord</button>
          </div>
          <input :model="whUrl" :placeholder="whPlaceholder()" type="url" aria-label="Webhook URL" class="mb-2 px-3.5 py-2.5 w-full font-mono text-ink text-sm bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none" placeholder="https://hooks.slack.com/services/…" autocomplete="off" spellcheck="false">
          <input :model="whLabel" type="text" aria-label="Channel label" class="mb-3 px-3.5 py-2.5 w-full text-ink text-sm bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none" placeholder="Label (optional) — e.g. #alerts" maxlength="255">
          <div class="flex gap-3 items-center">
            <button @click="addChannel" :disabled="adding()" class="px-4 py-2.5 font-semibold text-sm text-accent-ink bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px] disabled:opacity-55 disabled:cursor-default [transition:background_0.15s_ease,opacity_0.15s_ease]" :text="adding() ? 'Adding…' : 'Add channel'">Add channel</button>
            <span class="text-ok text-xs" :show="!!whNote()" :class="whNoteOk() ? 'text-xs text-ok' : 'text-xs text-accent'">{{ whNote() }}</span>
          </div>
          <p :text="whHelp()" class="mt-3.5 leading-relaxed text-subtle text-xs">
            In Slack: <span class="text-muted">Apps → Incoming Webhooks → Add to a channel</span>, then paste the <span class="font-mono">hooks.slack.com/services/…</span> URL.
          </p>
        </div>
      </section>

      {{-- =========================== RETENTION =========================== --}}
      {{-- What happens to entries once they pass the hot window, stated plainly
          for both plans. The free copy says removed, not archived, because that
          is what happens: free projects are pruned rather than exported, and a
          settings page that implied otherwise would be the one place a customer
          checks before finding out the hard way. --}}
      <section id="retention" class="mb-10 scroll-mt-[84px]">
        <div class="mb-3 font-semibold text-[13px] text-subtle tracking-[0.04em] uppercase">Retention</div>
        <div class="px-5 py-5 app-panel">
          <div class="flex flex-wrap gap-3 items-start justify-between mb-4">
            <div>
              <p class="mb-1 text-sm">
                Entries stay searchable in the live stream for
                <span class="font-semibold">{{ retention.hotWindowDays }} days</span>.
              </p>
              @if (retention.plan === 'pro')
                <p class="leading-relaxed text-subtle text-xs">
                  After that they move to long-term storage and stay searchable from the
                  <StxLink to="/dashboard?range=archive" class="text-accent">Archive</StxLink> tab. Nothing is deleted.
                </p>
              @else
                <p class="leading-relaxed text-subtle text-xs">
                  After that they are removed. Pro keeps them in long-term storage instead, searchable for good.
                </p>
              @endif
            </div>
            <span class="shrink-0 px-[9px] py-0.5 font-semibold text-[11px] text-accent tracking-[0.02em] bg-[color-mix(in_srgb,var(--accent)_14%,var(--panel))] rounded-[999px]">{{ retention.plan === 'pro' ? 'Pro' : 'Free' }}</span>
          </div>

          @if (retention.available && (retention.partitions > 0 || retention.prunedRows > 0))
            <div class="grid gap-y-2 grid-cols-2 sm:grid-cols-4 pt-4 text-xs border-line border-t">
              <div>
                <div class="text-subtle">Archived days</div>
                <div class="font-mono tnum">{{ retention.partitions.toLocaleString() }}</div>
              </div>
              <div>
                <div class="text-subtle">Archived entries</div>
                <div class="font-mono tnum">{{ retention.archivedRows.toLocaleString() }}</div>
              </div>
              <div>
                <div class="text-subtle">Stored</div>
                <div class="font-mono tnum">{{ retentionBytesLabel }}</div>
              </div>
              <div>
                <div class="text-subtle">Removed</div>
                <div class="font-mono tnum">{{ retention.prunedRows.toLocaleString() }}</div>
              </div>
            </div>
          @endif

          @if (retention.plan !== 'pro')
            <p class="mt-4 pt-4 leading-relaxed text-subtle text-xs border-line border-t">
              Entries are kept for {{ retention.hotWindowDays + retention.graceDays }} days before removal, so upgrading within
              {{ retention.graceDays }} days of a day ageing out still saves it.
              <StxLink to="/pricing" class="text-accent">See plans</StxLink>
            </p>
          @else
            <p class="mt-4 pt-4 leading-relaxed text-subtle text-xs border-line border-t">
              <StxLink to="/analytics" class="text-accent">View analytics</StxLink> for volume over time and what the archive holds.
            </p>
          @endif
        </div>
      </section>

      {{-- ============================ DANGER ============================ --}}
      <section id="danger" class="mb-6 scroll-mt-[84px]">
        {{-- The section-heading utilities WITHOUT their text-subtle: this
            heading is warn-coloured, and two colour utilities of equal
            specificity are decided by their order in the generated sheet.
            It was pinned inline until settings' <style> block went, because
            `.sec-title` set var(--text-3) and outranked the utility. --}}
        <div class="mb-3 font-semibold text-[13px] text-warn tracking-[0.04em] uppercase">Danger zone</div>
        <div class="bg-panel border border-[color-mix(in_srgb,var(--warn)_40%,var(--border))] rounded-xl" data-project-name="{{ activeProject?.name }}" data-active="{{ activeProject?.is_active === false ? '0' : '1' }}">
          {{-- Archive / Unarchive --}}
          <div class="flex gap-4 items-center justify-between px-5 py-4">
            <div class="min-w-0">
              @if (activeProject.is_active === false)
                <div class="mb-0.5 font-semibold text-sm">Unarchive this project</div>
                <p class="text-sm text-subtle"><span class="font-mono text-muted">{{ activeProject?.name }}</span> is archived and isn’t accepting new logs. Unarchiving resumes ingestion right away.</p>
              @else
                <div class="mb-0.5 font-semibold text-sm">Archive this project</div>
                <p class="text-sm text-subtle">Rejects new log entries for <span class="font-mono text-muted">{{ activeProject?.name }}</span> with a 403. Everything already stored is kept — you can unarchive anytime.</p>
              @endif
            </div>
            <button @click="openArchive" :disabled="archiving()" class="flex-none px-4 py-2.5 font-semibold text-sm text-warn whitespace-nowrap hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]">{{ activeProject?.is_active === false ? 'Unarchive' : 'Archive' }}</button>
          </div>
          <div class="h-px bg-[color-mix(in_srgb,var(--warn)_20%,var(--border))]"></div>
          {{-- Delete --}}
          <div class="flex gap-4 items-center justify-between px-5 py-4">
            <div class="min-w-0">
              <div class="mb-0.5 font-semibold text-sm">Delete this project</div>
              <p class="text-sm text-subtle">Permanently deletes <span class="font-mono text-muted">{{ activeProject?.name }}</span> and all of its log entries, alert channels, members, and invites. This cannot be undone.</p>
            </div>
            <button @click="openDelete" class="flex-none px-4 py-2.5 font-semibold text-sm text-warn whitespace-nowrap hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]">Delete</button>
          </div>
        </div>
      </section>

      {{-- Type-to-confirm modal (archive / delete). Was built by hand: toggling
          the hidden attribute, writing title/desc/label text, and flipping a
          disabled flag on input. It is one modalKind signal now — '' means
          closed.

          This is an stx comment rather than an HTML one, deliberately. An HTML
          comment ships to the browser verbatim and is then re-read by four
          separate consumers: a backtick in one flips the merged setup function
          into template-literal mode, and the name of the root element or of a
          script tag in one silently disables the document shell. Describe
          syntax in prose here; never quote it. --}}
      <div class="flex fixed inset-0 z-[60] items-center justify-center p-5 bg-[rgba(2,4,10,0.62)] backdrop-blur-[3px] [animation:dz-fade_0.12s_ease] dz-overlay" :show="modalOpen()" @click="closeModal">
        <div ref="modalPanel" @keydown="onModalKeydown" class="p-[22px] max-w-[440px] w-full shadow-[0_24px_70px_rgba(0,0,0,0.5)] [animation:dz-pop_0.14s_cubic-bezier(0.2,0.8,0.3,1)] app-panel" role="dialog" aria-modal="true" @click.stop>
          <div class="mb-1 font-semibold text-base">{{ modalTitle() }}</div>
          <p class="mb-4 text-muted text-sm">{{ modalDesc() }}</p>
          <label class="block mb-1.5 text-subtle text-xs">Type <span class="font-mono text-muted">{{ projectName }}</span> to confirm</label>
          <input :model="modalInput" type="text" :aria-label="modalTitle()" aria-label="Type the project name to confirm" class="mb-4 px-3.5 py-2.5 w-full font-mono text-ink text-sm bg-canvas border border-line rounded-[10px] focus:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus:outline-none" autocomplete="off" autocapitalize="off" spellcheck="false">
          <div class="flex gap-2 items-center justify-end">
            <button @click="closeModal" type="button" class="px-4 py-2.5 font-medium text-muted text-sm hover:text-ink bg-panel border border-line rounded-[9px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] [transition:color_0.15s_ease,border-color_0.15s_ease]">Cancel</button>
            <button @click="confirmModal" :disabled="!modalReady()" :text="modalConfirmLabel()" type="button" class="px-4 py-2.5 font-semibold text-sm text-warn hover:text-accent-ink bg-panel hover:bg-warn border border-[color-mix(in_srgb,var(--warn)_45%,var(--border))] rounded-[9px] hover:border-warn [transition:all_0.15s_ease]">Confirm</button>
          </div>
          <span class="mt-2.5 text-accent text-xs" :show="!!modalNote()">{{ modalNote() }}</span>
        </div>
      </div>
    @endif

  </div>
</div>

{{-- Auth guard. Navigation only, renders nothing, and must run before the page
    is usable — a directive would hydrate too late and flash the settings UI to
    a signed-out visitor. --}}

@include('AuthGuard')
@endsection
