<script server>
useSeoMeta({
  title: 'Pricing - loghq',
  description: 'Start free and upgrade when you outgrow it, or self-host loghq for free forever on your own Postgres.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/pricing' }] })
</script>

<script client>
// Pricing / upgrade via stx client directives. Interval + state are signals; the
// Upgrade button starts a Stripe Checkout (external redirect via location).
const interval = state('monthly')
const err = state('')
const loading = state(false)

function pick(v) { interval.set(v) }

async function upgrade() {
  const token = localStorage.getItem('token')
  if (!token) { navigate('/login'); return }
  loading.set(true)
  err.set('')
  try {
    const res = await fetch('/payments/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ interval: interval() }),
    })
    const data = await res.json().catch(() => ({}))
    if (res.ok && data.url) { location.assign(data.url); return }
    err.set(data.error || 'Checkout is not available yet.')
  }
  catch {
    err.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<style>
:root { --bg:#fbfbfd; --panel:#ffffff; --border:rgba(15,23,42,0.09); --text:#0b0f19; --text-2:#4b5565; --text-3:#97a1b2; --accent:#e11d48; --sans:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; }
@media (prefers-color-scheme: dark) { :root { --bg:#090b11; --panel:#10131c; --border:rgba(148,163,184,0.12); --text:#f3f5f9; --text-2:#b3bccb; --text-3:#667085; --accent:#fb7185; } }
:root[data-theme="dark"] { --bg:#090b11; --panel:#10131c; --border:rgba(148,163,184,0.12); --text:#f3f5f9; --text-2:#b3bccb; --text-3:#667085; --accent:#fb7185; }
:root[data-theme="light"] { --bg:#fbfbfd; --panel:#ffffff; --border:rgba(15,23,42,0.09); --text:#0b0f19; --text-2:#4b5565; --text-3:#97a1b2; --accent:#e11d48; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 16px; }
.card-pro { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); box-shadow: 0 12px 40px color-mix(in srgb, var(--accent) 12%, transparent); }
.btn { border-radius: 10px; transition: transform .12s ease, opacity .15s ease; font-weight: 600; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:disabled { opacity: .6; cursor: default; }
.btn-ghost { border: 1px solid var(--border); color: var(--text-2); }
.check { color: var(--accent); }
.seg { border: 1px solid var(--border); border-radius: 999px; }
.seg button { border-radius: 999px; cursor: pointer; background: transparent; color: var(--text-2); border: none; }
.seg button.on { background: var(--accent); color: #fff; }
.err { color: #ef4444; }
</style>

<div class="px-5 py-14 md:px-10 min-h-[100dvh]">
  <div class="mx-auto max-w-3xl">
    <header class="mb-10 text-center">
      <a href="/" class="text-2xl wordmark">loghq</a>
      <h1 class="mt-6 text-3xl md:text-4xl wordmark" style="letter-spacing:-0.035em">Simple, honest pricing</h1>
      <p class="mt-3 text-base text-subtle">Start free. Upgrade when you outgrow it. Self-host free forever.</p>
      <div class="inline-flex gap-1 items-center mt-6 p-1 text-sm seg">
        <button @click="pick('monthly')" :class="interval() === 'monthly' ? 'on px-4 py-1.5 font-medium' : 'px-4 py-1.5 font-medium'">Monthly</button>
        <button @click="pick('yearly')" :class="interval() === 'yearly' ? 'on px-4 py-1.5 font-medium' : 'px-4 py-1.5 font-medium'">Yearly <span style="opacity:.8">-17%</span></button>
      </div>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="p-7 card">
        <div class="font-semibold text-sm text-subtle tracking-wider uppercase">Free</div>
        {{-- Plain markup, so the dollar sign needs no escape. It carried a
            leading backslash, which is correct inside the interpolated
            expression on the Pro card below (there it is JS string escaping),
            but here it rendered as a literal backslash on the page. --}}
        <div class="mt-3"><span class="text-4xl wordmark">$0</span><span class="text-sm text-subtle"> / forever</span></div>
        <p class="mt-2 text-muted text-sm">Everything you need to get started.</p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-2 items-center"><span class="check">✓</span> 1 project</li>
          <li class="flex gap-2 items-center"><span class="check">✓</span> 5k errors / mo</li>
          <li class="flex gap-2 items-center"><span class="check">✓</span> 30-day retention</li>
          <li class="flex gap-2 items-center"><span class="check">✓</span> Community support</li>
        </ul>
        <a href="/register" class="block mt-7 py-2.5 w-full text-center text-sm btn btn-ghost">Get started</a>
      </div>

      <div class="p-7 card card-pro">
        <div class="font-semibold text-accent text-sm tracking-wider uppercase">Pro</div>
        <div class="mt-3">
          <span class="text-4xl wordmark">{{ interval() === 'yearly' ? '\$190' : '\$19' }}</span><span class="text-sm text-subtle">{{ interval() === 'yearly' ? ' / year' : ' / month' }}</span>
        </div>
        <p class="mt-2 text-muted text-sm">For teams and sites that are growing.</p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-2 items-center"><span class="check">✓</span> Unlimited projects</li>
          <li class="flex gap-2 items-center"><span class="check">✓</span> Unlimited errors</li>
          <li class="flex gap-2 items-center"><span class="check">✓</span> Full retention</li>
          <li class="flex gap-2 items-center"><span class="check">✓</span> Priority support</li>
        </ul>
        <button @click="upgrade" :disabled="loading()" class="mt-7 py-2.5 w-full text-sm btn btn-primary">{{ loading() ? 'Redirecting…' : 'Upgrade to Pro' }}</button>
        @if (err())
          <p class="mt-3 text-center text-xs err">{{ err() }}</p>
        @endif
      </div>
    </div>
    <p class="mt-10 text-center text-subtle text-xs">Prefer to self-host? loghq is open source and free to run yourself.</p>
  </div>
</div>
