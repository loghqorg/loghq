<script server>
useSeoMeta({
  title: 'Pricing - loghq',
  description: 'Start free and upgrade when you outgrow it, or self-host loghq for free forever on your own Postgres.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/pricing' }] })
</script>

<script client>
// Pricing / upgrade via stx client directives. Interval + state are signals; the
// Upgrade button starts a Stripe Checkout (external redirect via location).
const interval = state('monthly')
const err = state('')
const loading = state(false)

function pick(v: 'monthly' | 'yearly'): void { interval.set(v) }

async function upgrade(): Promise<void> {
  const token = useStore('session').token()
  if (!token) { navigate('/login'); return }
  loading.set(true)
  err.set('')
  try {
    const res = await fetch('/payments/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ interval: interval() }),
    })
    const data = await res.json().catch(() => ({}))
    // Cross-origin Stripe Checkout. navigate() handles the origin switch
    // itself (client.js:285); the second argument declares the full load.
    if (res.ok && data.url) { navigate(data.url, { reload: true }); return }
    err.set(data.error || 'Checkout is not available yet.')
  }
  catch {
    err.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on.

    MARKETING, not default. This page is linked from the marketing nav, so it
    needs the marketing chrome: layouts/default includes neither SiteNav nor
    SiteFooter, and a hard load therefore reached a pricing page with 2 links
    on it and no footer, against 76 and 27 on any /compare page. Someone
    arriving from search had no route into the rest of the site.

    It also renders the same way now however you arrive. Under layouts/default
    the router fragment-swapped this page into whatever shell the previous page
    had, because the layout-GROUP guard is asked before the response that
    carries the group header (stx#1833) — so clicking Pricing from marketing
    showed it WITH nav and footer while a direct hit showed it without. --}}
@extends('layouts/marketing')

@section('content')
<div class="px-5 py-14 md:px-10 min-h-[100dvh]">
  <div class="mx-auto max-w-3xl">
    <header class="mb-10 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      {{-- Deliberately not the `wordmark` shortcut: that carries
           tracking-[-0.03em], and this heading wants -0.035em. Two tracking
           utilities of equal specificity are decided by their order in the
           generated sheet, not by the class attribute, so the winner would be
           whichever Crosswind emitted last. Spelling out font-bold plus the
           one tracking value keeps it unambiguous. --}}
      <h1 class="mt-6 font-bold text-3xl md:text-4xl tracking-[-0.035em]">Simple, honest pricing</h1>
      <p class="mt-3 text-base text-subtle">Start free. Upgrade when you outgrow it. Self-host free forever.</p>
      <div class="inline-flex gap-1 items-center mt-6 p-1 text-sm border border-line rounded-[999px]">
        <button @click="pick('monthly')" :class="interval() === 'monthly' ? 'px-4 py-1.5 font-medium rounded-[999px] cursor-pointer border-none bg-accent text-white' : 'px-4 py-1.5 font-medium rounded-[999px] cursor-pointer border-none bg-transparent text-muted'">Monthly</button>
        <button @click="pick('yearly')" :class="interval() === 'yearly' ? 'px-4 py-1.5 font-medium rounded-[999px] cursor-pointer border-none bg-accent text-white' : 'px-4 py-1.5 font-medium rounded-[999px] cursor-pointer border-none bg-transparent text-muted'">Yearly <span class="opacity-80">-17%</span></button>
      </div>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="p-7 bg-panel border border-line rounded-2xl">
        <div class="font-semibold text-sm text-subtle tracking-wider uppercase">Free</div>
        {{-- Plain markup, so the dollar sign needs no escape. It carried a
            leading backslash, which is correct inside the interpolated
            expression on the Pro card below (there it is JS string escaping),
            but here it rendered as a literal backslash on the page. --}}
        <div class="mt-3"><span class="text-4xl wordmark">$0</span><span class="text-sm text-subtle"> / forever</span></div>
        <p class="mt-2 text-muted text-sm">Everything you need to get started.</p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> 1 project</li>
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> 5k errors / mo</li>
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> 30-day retention</li>
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Community support</li>
        </ul>
        <StxLink to="/register" class="block mt-7 py-2.5 w-full text-center text-sm rounded-[10px] font-semibold [transition:transform_0.12s_ease,opacity_0.15s_ease] active:translate-y-px border border-line text-muted">Get started</StxLink>
      </div>

      <div class="p-7 bg-panel border rounded-2xl border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] shadow-[0_12px_40px_color-mix(in_srgb,var(--accent)_12%,transparent)]">
        <div class="font-semibold text-accent text-sm tracking-wider uppercase">Pro</div>
        {{-- Monthly is the resting state (`state('monthly')` at :13), so it is
             written statically and `:text` takes over once the toggle is live.
             As `{{ }}` in the body, the Pro price was cloaked — the price on the
             pricing page did not exist for a crawler or before hydration. --}}
        <div class="mt-3">
          <span class="text-4xl wordmark" :text="interval() === 'yearly' ? '$190' : '$19'">$19</span><span class="text-sm text-subtle" :text="interval() === 'yearly' ? ' / year' : ' / month'"> / month</span>
        </div>
        <p class="mt-2 text-muted text-sm">For teams and sites that are growing.</p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Unlimited projects</li>
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Unlimited errors</li>
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Full retention</li>
          <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Priority support</li>
        </ul>
        <button @click="upgrade" :disabled="loading()" class="mt-7 py-2.5 w-full text-sm rounded-[10px] font-semibold [transition:transform_0.12s_ease,opacity_0.15s_ease] active:translate-y-px bg-accent text-white disabled:opacity-60 disabled:cursor-default" :text="loading() ? 'Redirecting…' : 'Upgrade to Pro'">Upgrade to Pro</button>
        @if (err())
          <p class="mt-3 text-center text-xs text-[#ef4444]">{{ err() }}</p>
        @endif
      </div>
    </div>
    <p class="mt-10 text-center text-subtle text-xs">Prefer to self-host? loghq is open source and free to run yourself.</p>
  </div>
</div>
@endsection
