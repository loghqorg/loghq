<script server>
// Static import — see login.stx for why a dynamic one inside the action loads
// a sibling project's package.
import { passwordResets } from '@stacksjs/auth'
useSeoMeta({
  title: 'Reset your password - loghq',
  description: 'Request a password reset link for your loghq account.',
  robots: 'noindex, nofollow',
})

// Resting values for what the action merges back.
let sent = false
let formError = ''
let values: { email?: string } = {}

// The page handles its own POST (stx#1847).
//
// This returns the SAME answer whether or not the address exists, and does not
// redirect: the confirmation replaces the form in place. Both are deliberate.
// A redirect would put the outcome in the URL, and a distinguishable response
// would turn this form into an account-existence oracle — which is the whole
// reason the route it replaces answered uniformly too.
//
// A transport failure is swallowed for the same reason and logged instead, so
// a bounced send cannot be read off the page as "this address is real".
const action = async ({ form }: { form: Record<string, string | string[]> }) => {
  const email = String(form.email ?? '').trim().toLowerCase()

  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
    return { sent: true, values: { email } }

  try {
    await passwordResets(email).sendEmail()
  }
  catch (err) {
    console.error('[forgot-password] send failed:', err instanceof Error ? err.message : err)
  }

  return { sent: true, values: { email } }
}
</script>

{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Reset your password</p>
    </div>

    @if (sent)
      <div class="px-3 py-3 text-sm rounded-lg ok-box">
        If an account exists for that email, a reset link is on its way. It expires in 60 minutes.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Back to sign in</StxLink>
      </p>
    @else
      {{-- Posts to itself; the action is in the server block. --}}
      <form action="/forgot-password" method="POST" class="space-y-4">
        @if (formError)
          <div class="px-3 py-2 text-sm rounded-lg err-box">{{ formError }}</div>
        @endif

        <p class="text-muted text-sm">Enter the email you signed up with and we will send you a link to reset your password.</p>

        <div>
          <label for="forgot-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
          <input id="forgot-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" value="{{ values?.email || '' }}" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        {{-- A plain button; the loading binding that was here read a client
            mutation this page no longer has. --}}
        <button type="submit" class="py-2.5 w-full font-semibold text-sm btn-solid">Send reset link</button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Remembered it?
        <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
      </p>
    @endif
  </div>
</div>
@endsection
