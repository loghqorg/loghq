<script server>
useSeoMeta({
  title: 'Reset your password - loghq',
  description: 'Request a password reset link for your loghq account.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Request a password-reset email. The endpoint is anti-enumeration: it always
// answers the same way, so the UI flips to a uniform "sent" state on success.
const error = state('')
const loading = state(false)
const sent = state(false)

async function handleSubmit(e) {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.elements.email.value }),
    })
    if (!res.ok) {
      const data = await res.json().catch(() => ({}))
      error.set(data.message || 'Something went wrong. Please try again.')
      return
    }
    sent.set(true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<style>
:root {
  --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48;
  --sans: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
    --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
}
:root[data-theme="dark"] { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
  --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
:root[data-theme="light"] { --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.field { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text); }
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.6; cursor: default; }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.ok { background: color-mix(in srgb, #22c55e 12%, transparent); color: #16a34a; }
</style>

<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <a href="/" class="text-2xl wordmark">loghq</a>
      <p class="mt-2 text-sm text-subtle">Reset your password</p>
    </div>

    @if (sent())
      <div class="px-3 py-3 text-sm rounded-lg ok">
        If an account exists for that email, a reset link is on its way. It expires in 60 minutes.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <a href="/login" class="font-medium text-accent">Back to sign in</a>
      </p>
    @else
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
        @endif

        <p class="text-muted text-sm">Enter the email you signed up with and we will send you a link to reset your password.</p>

        <div>
          <label class="block mb-1.5 font-medium text-muted text-xs">Email</label>
          <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn">
          {{ loading() ? 'Sending…' : 'Send reset link' }}
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Remembered it?
        <a href="/login" class="font-medium text-accent">Sign in</a>
      </p>
    @endif
  </div>
</div>
