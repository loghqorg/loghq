<script server>
useSeoMeta({
  title: 'Reset your password - loghq',
  description: 'Request a password reset link for your loghq account.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Request a password-reset email. The endpoint is anti-enumeration: it always
// answers the same way, so the UI flips to a uniform "sent" state on success.
const error = state('')
const sent = state(false)

// useMutation owns the request, the in-flight flag and the failure path — see
// login.stx for why `error` stays a page signal rather than binding the
// primitive's own (its message is the prefixed thrown string; err.data is the
// server's body).
const requestReset = useMutation('/password/forgot', {
  onError(err: { data?: { message?: string } }) {
    error.set(err.data?.message || 'Something went wrong. Please try again.')
  },
  onSuccess() {
    sent.set(true)
  },
})

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (requestReset.loading())
    return
  const form = e.target
  error.set('')
  await requestReset.mutate({ email: form.elements.email.value }).catch(() => {})
}
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Reset your password</p>
    </div>

    @if (sent())
      <div class="px-3 py-3 text-sm rounded-lg ok-box">
        If an account exists for that email, a reset link is on its way. It expires in 60 minutes.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Back to sign in</StxLink>
      </p>
    @else
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div class="px-3 py-2 text-sm rounded-lg err-box">{{ error() }}</div>
        @endif

        <p class="text-muted text-sm">Enter the email you signed up with and we will send you a link to reset your password.</p>

        <div>
          <label for="forgot-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
          <input id="forgot-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        {{-- Static label + `:text`, never `{{ }}` in the body — see login.stx. --}}
        <button type="submit" :disabled="requestReset.loading()" :text="requestReset.loading() ? 'Sending…' : 'Send reset link'" class="py-2.5 w-full font-semibold text-sm btn-solid">Send reset link</button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Remembered it?
        <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
      </p>
    @endif
  </div>
</div>
@endsection
