<script client>
const out = state('pending')
const hdr = state('none')

configureFetch({
  onRequest(ctx) {
    ctx.options.headers.Authorization = 'Bearer PROBE'
    hdr.set('set')
  },
})

const m = useMutation('/login', {
  onError(e) {
    out.set([
      'status=' + e.status,
      'hasData=' + (e.data ? 'yes' : 'no'),
      'dataMsg=' + JSON.stringify(e.data && (e.data.message || e.data.error)),
      'msg=' + String(e.message).slice(0, 60),
    ].join(' | '))
  },
})

onMount(async () => {
  try { await m.mutate({ email: 'nobody@example.com', password: 'wrongwrong' }) }
  catch { /* rethrow expected */ }
  if (out() === 'pending') out.set('NO onError FIRED; errorSignal=' + String(m.error()))
})
</script>
<p id="r" :text="out()">pending</p>
<p id="h" :text="hdr()">none</p>
<p id="e" :text="String(m.error())">-</p>
