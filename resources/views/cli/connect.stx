<script server>
// Static imports, as in projects/new.stx. `hq as __hq` because it is an
// object: without the prefix it is a server-to-client bridge candidate.
import { Auth } from '@stacksjs/auth'
import { hq as __hq } from '../../../app/Hq/service'

useSeoMeta({
  title: 'Connect an app - loghq',
  // Auth-walled and single-use: nothing here is worth an index entry.
  robots: 'noindex, nofollow',
})

// The approve page for `buddy hq:connect` (routes/hq.ts). The CLI opens this
// URL with the code it was issued, a signed-in person confirms, and the CLI
// collects that project's keys on its next poll. Loading the page creates
// nothing: only the button does.
const code = new URLSearchParams(typeof __stxServeSearch !== 'undefined' ? __stxServeSearch : '').get('code') || ''

const token = (typeof cookies !== 'undefined' && cookies['auth-token']) || ''
let user = null
if (token) {
  try { user = await Auth.getUserFromToken(token) }
  catch { user = null }
}
const signedIn = !!user

// Looked up only for a signed-in viewer. A pending code answers the app's
// name. An unknown, expired or already approved one answers nothing, and the
// page says the same thing for all three so it cannot be used to test codes.
let appName = ''
let pending = false
if (signedIn && code) {
  try {
    const described = await __hq.describeConnect(code)
    if (described) {
      appName = described.app
      pending = true
    }
  }
  catch { pending = false }
}
</script>

<script client>
// The code is read from the URL rather than handed over from the server
// script, so no server value crosses into client code.
const error = state('')
const loading = state(false)
const connected = state('')

async function approve(): Promise<void> {
  if (loading())
    return
  const code = new URLSearchParams(useRoute().query).get('code') || ''
  loading.set(true)
  error.set('')
  try {
    const res = await fetch(`/api/cli/connect/${encodeURIComponent(code)}/approve`, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: '{}',
    })
    let data: any = {}
    try { data = await res.json() }
    catch {}
    if (res.status === 401) {
      navigate('/login', { replace: true, reload: true })
      return
    }
    if (!res.ok) {
      error.set(data.error || 'Could not approve the connection.')
      loading.set(false)
      return
    }
    connected.set(data.project?.name || 'your app')
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>

@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
    </div>

    @if (!signedIn)
      <div class="text-center">
        <h1 class="font-semibold text-xl tracking-tight">Sign in to connect your app</h1>
        <p class="mt-2 text-sm text-subtle">Your terminal is waiting for you to approve this connection. Sign in, then come back to this tab and reload it.</p>
        <div class="flex flex-col gap-3 mt-6">
          <a href="/login" target="_blank" rel="noopener" class="block py-2.5 w-full font-semibold text-accent-ink text-center text-sm bg-accent rounded-[10px]">Sign in</a>
          <a href="/register" target="_blank" rel="noopener" class="block py-2.5 w-full font-semibold text-center text-muted text-sm border border-line rounded-[10px]">Create an account</a>
        </div>
      </div>
    @endif

    @if (signedIn && !pending)
      <div class="text-center">
        <h1 class="font-semibold text-xl tracking-tight">This link is no longer valid</h1>
        <p class="mt-2 text-sm text-subtle">A connection request lasts ten minutes and can be approved once. Run the connect command again to get a new one.</p>
      </div>
    @endif

    @if (signedIn && pending)
      <div :show="!!connected()" class="text-center" role="status">
        <h1 class="font-semibold text-xl tracking-tight">Connected</h1>
        <p class="mt-2 text-sm text-subtle"><span :text="connected()"></span> is connected to loghq. You can close this tab and return to your terminal.</p>
      </div>
      <div :show="!connected()">
        <div class="mb-6 text-center">
          <h1 class="font-semibold text-xl tracking-tight">Connect {{ appName }} to loghq?</h1>
          <p class="mt-2 text-sm text-subtle">This creates an app called {{ appName }} in your account, or reuses the one you already have, and sends its keys to the terminal that asked.</p>
        </div>
        <div id="connect-error" role="alert" :show="!!error()" :text="error()" class="mb-4 py-2 err-box notice-box"></div>
        <Button type="button" size="sm" fullWidth @click="approve" :loading="loading()" :label="loading() ? 'Connecting…' : 'Approve connection'" className="auth-submit">Approve connection</Button>
        <p class="mt-4 text-center text-subtle text-xs">Only approve this if you just ran the connect command yourself.</p>
      </div>
    @endif
  </div>
</div>
@endsection
