<script server>
// Static imports — see login.stx for why a dynamic one inside the action loads
// a sibling project's package.
import { passwordResets, RateLimiter } from '@stacksjs/auth'
useSeoMeta({
  title: 'Choose a new password - loghq',
  description: 'Set a new password for your loghq account from an emailed reset link.',
  robots: 'noindex, nofollow',
})

// The link's own parameters, read server-side so they are part of the first
// render. They are carried across the POST as hidden inputs, because the form
// posts to /reset-password with no query string and the token would otherwise
// be gone by the time the action runs.
const __rpQuery = new URLSearchParams(__stxServeSearch || '')
const linkToken = __rpQuery.get('token') || ''
const linkEmail = __rpQuery.get('email') || ''

// Resting values for what the action merges back.
let done = false
let formError = ''

// The page handles its own POST (stx#1847).
//
// Rate limiting is carried over from the route this replaces rather than
// dropped: a reset endpoint without it is a token-guessing surface, and unlike
// sign-in there is no `Auth.attempt` doing it for us. Same key shape the API
// action used, so the two share a bucket per email.
const action = async ({ form }: { form: Record<string, string | string[]> }) => {
  const token = String(form.token ?? '')
  const email = String(form.email ?? '').trim().toLowerCase()
  const password = String(form.password ?? '')
  const confirmation = String(form.password_confirmation ?? '')

  // Client-side gates, now server-side: instant, and none of them is a fact
  // only the server holds.
  if (password !== confirmation)
    return { formError: 'Passwords do not match.' }
  if (password.length < 8)
    return { formError: 'Password must be at least 8 characters.' }
  if (!token || !email)
    return { formError: 'This reset link is invalid. Request a new one below.' }

  const rateLimitKey = `password_reset_attempt:${email}`
  if (await RateLimiter.isRateLimited(rateLimitKey))
    return { formError: 'Too many password reset attempts. Please try again later.' }

  const result = await passwordResets(email).resetPassword(token, password)

  if (!result.success) {
    await RateLimiter.recordFailedAttempt(rateLimitKey)
    // The framework's message already avoids saying whether the account exists.
    return { formError: result.message || 'This reset link is invalid or has expired. Request a new one below.' }
  }

  // No redirect and no auto-sign-in: the password just changed, so the next
  // step is proving it. `done` swaps the form for a link to /login.
  return { done: true }
}
</script>

{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Choose a new password</p>
    </div>

    @if (done)
      <div class="px-3 py-3 text-sm rounded-lg ok-box">
        Your password has been reset. You have been signed out everywhere; sign in with the new password.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Go to sign in</StxLink>
      </p>
    @else
      {{-- Posts to itself; the action is in the server block. --}}
      <form action="/reset-password" method="POST" class="space-y-4">
        {{-- The link's token and address, carried across the POST. --}}
        <input type="hidden" name="token" value="{{ linkToken }}">
        <input type="hidden" name="email" value="{{ linkEmail }}">
        @if (formError)
          <div class="px-3 py-2 text-sm rounded-lg err-box">{{ formError }}</div>
        @endif

        <div>
          <label for="reset-password" class="block mb-1.5 font-medium text-muted text-xs">New password</label>
          <input id="reset-password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
        </div>
        <div>
          <label for="reset-password-confirmation" class="block mb-1.5 font-medium text-muted text-xs">Confirm new password</label>
          <input id="reset-password-confirmation" name="password_confirmation" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat the password" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        {{-- A plain button; no client mutation to bind a loading state to. --}}
        <button type="submit" class="py-2.5 w-full font-semibold text-sm btn-solid">Reset password</button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Link expired?
        <StxLink to="/forgot-password" class="font-medium text-accent">Request a new one</StxLink>
      </p>
    @endif
  </div>
</div>
@endsection
