<script server>
useSeoMeta({
  title: 'Choose a new password - loghq',
  description: 'Set a new password for your loghq account from an emailed reset link.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Set a new password from an emailed reset link (/reset-password?token=…&email=…).
// The token is single-use and expiring; the server verifies it against a bcrypt
// hash and revokes every session on success.
const error = state('')
const done = state(false)

function linkParams(): { token: string, email: string } {
  const q = new URLSearchParams(typeof location !== 'undefined' ? location.search : '')
  return { token: q.get('token') || '', email: q.get('email') || '' }
}

// See login.stx for why `error` is a page signal and not the primitive's own.
const resetPassword = useMutation('/password/reset', {
  onError(err: { data?: { message?: string } }) {
    error.set(err.data?.message || 'This reset link is invalid or has expired. Request a new one below.')
  },
  onSuccess() {
    done.set(true)
  },
})

// The controls this handler reads. See login.stx for why the type is declared
// inline rather than in types/app.d.ts, and why the cast is on `target`.
interface ResetPasswordForm extends HTMLFormElement {
  elements: HTMLFormControlsCollection & {
    password: HTMLInputElement
    password_confirmation: HTMLInputElement
  }
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (resetPassword.loading())
    return
  const form = e.target as ResetPasswordForm
  const password = form.elements.password.value
  const confirmation = form.elements.password_confirmation.value
  // Client-side gates stay ahead of the request: they are instant, and none of
  // them is a fact only the server holds.
  if (password !== confirmation) {
    error.set('Passwords do not match.')
    return
  }
  if (password.length < 8) {
    error.set('Password must be at least 8 characters.')
    return
  }
  const { token, email } = linkParams()
  if (!token || !email) {
    error.set('This reset link is invalid. Request a new one below.')
    return
  }
  error.set('')
  await resetPassword.mutate({ token, email, password, password_confirmation: confirmation }).catch(() => {})
}
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Choose a new password</p>
    </div>

    @if (done())
      <div class="px-3 py-3 text-sm rounded-lg ok-box">
        Your password has been reset. You have been signed out everywhere; sign in with the new password.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Go to sign in</StxLink>
      </p>
    @else
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div class="px-3 py-2 text-sm rounded-lg err-box">{{ error() }}</div>
        @endif

        <div>
          <label for="reset-password" class="block mb-1.5 font-medium text-muted text-xs">New password</label>
          <input id="reset-password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
        </div>
        <div>
          <label for="reset-password-confirmation" class="block mb-1.5 font-medium text-muted text-xs">Confirm new password</label>
          <input id="reset-password-confirmation" name="password_confirmation" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat the password" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        {{-- Static label + `:text`, never `{{ }}` in the body — see login.stx. --}}
        <button type="submit" :disabled="resetPassword.loading()" :text="resetPassword.loading() ? 'Resetting…' : 'Reset password'" class="py-2.5 w-full font-semibold text-sm btn-solid">Reset password</button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Link expired?
        <StxLink to="/forgot-password" class="font-medium text-accent">Request a new one</StxLink>
      </p>
    @endif
  </div>
</div>
@endsection
