@extends('layouts/marketing')

<script server>
useSeoMeta({
  title: 'Automatic error capture - loghq',
  description: 'Initialize once and every uncaught error is captured with its stack trace, release, and environment. No scattered try/catch.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/features/capture' }] })

// Breadcrumb trail. One array drives two consumers — the rendered list in
// the Breadcrumbs partial and the BreadcrumbList JSON-LD below — so the
// markup and the structured data cannot disagree. The last crumb has no
// href or url: it is this page.
const crumbs = [
  { label: 'Home', href: '/', url: 'https://loghq.org/' },
  { label: 'Features', href: '/#features', url: 'https://loghq.org/#features' },
  { label: 'Automatic capture' },
]
</script>

@section('content')
@structuredData({
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.url })),
})

@include('Breadcrumbs')

<section class="feat-hero shell">
  <span class="kicker">Capture</span>
  <h1>Every uncaught error, captured on throw.</h1>
  <p>Initialize the SDK once and every unhandled exception is collected with its stack trace, release, and environment. No try/catch scattered through your code.</p>
  <div class="hero-actions">
    <StxLink class="btn primary" to="/register">Get started</StxLink>
    <StxLink class="btn ghost" to="/docs">Read the docs</StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Automatic capture preview">
  <div class="code" style="max-width: 700px">
    <div class="code-bar"><span class="chart-cap">app/error-boundary.ts</span></div>
    <pre class="code-body"><code>async function loghq(message, level = 'info', context) {
  try {
    await fetch('https://loghq.org/logs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-LogHQ-Key': KEY },
      body: JSON.stringify({ logs: [{ message, level, context,
        release: 'checkout@2.14.0', environment: 'production' }] }),
    })
  }
  catch {} // logging must never break the app
}

addEventListener('error', e => loghq(e.message, 'error', { stack: e.error?.stack }))
addEventListener('unhandledrejection', e => loghq(String(e.reason), 'error'))</code></pre>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="how-heading">
  <div class="section-head">
    <h2 id="how-heading" class="section-title">How it works</h2>
  </div>
  <div class="flow">
    <div class="flow-step">
      <span class="flow-num">01</span>
      <div>
        <h3>Install and init once</h3>
        <p>One init call wires up a global handler, so you do not wrap each call site by hand.</p>
      </div>
    </div>
    <div class="flow-step">
      <span class="flow-num">02</span>
      <div>
        <h3>Errors are captured on throw</h3>
        <p>Uncaught exceptions and unhandled rejections are collected the moment they happen, with the full stack.</p>
      </div>
    </div>
    <div class="flow-step">
      <span class="flow-num">03</span>
      <div>
        <h3>Context rides along</h3>
        <p>Release, environment, and request metadata attach automatically, so an error arrives with the facts you need.</p>
      </div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-label="What you get">
  <div class="metrics">
    <div class="metric">
      <div class="m-value">One init</div>
      <div class="m-label">A single call sets up global capture across your whole app.</div>
    </div>
    <div class="metric">
      <div class="m-value">Full context</div>
      <div class="m-label">Stack trace, release, environment, and metadata on every event.</div>
    </div>
    <div class="metric">
      <div class="m-value">Any runtime</div>
      <div class="m-label">Server, edge, and browser code report through the same SDK.</div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="related-heading">
  <div class="section-head">
    <h2 id="related-heading" class="section-title">Pairs well with</h2>
  </div>
  <div class="related">
    <StxLink to="/features/grouping">
      <div class="r-name">Fingerprint grouping</div>
      <div class="r-desc">See captured errors fold into single issues.</div>
    </StxLink>
    <StxLink to="/features/stack-traces">
      <div class="r-name">Readable stack traces</div>
      <div class="r-desc">Turn minified frames back into your source.</div>
    </StxLink>
    <StxLink to="/features/releases">
      <div class="r-name">Releases and environments</div>
      <div class="r-desc">Tag each captured error with its deploy.</div>
    </StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Get started">
  <div class="cta-band">
    <h2>Ship with a net under you.</h2>
    <div class="cta-actions">
      <StxLink class="btn primary" to="/register">Get started</StxLink>
      <StxLink class="btn ghost" to="/docs">Read the docs</StxLink>
    </div>
  </div>
</section>
@endsection
