<script server>
// loghq log stream. Authenticates the current user from the token cookie,
// loads THEIR projects
// owner-scoped, and renders the active one's log stream (newest first) with
// level-threshold, time-range, and text-search filters. Reads via __db.unsafe.
// Static import per ch.5.3, renamed to `__db` per ch.5.8 — see the fuller note
// in settings.stx. The rewrite exports every top-level binding into the template
// context, and `db` is an object rather than a function, so without the prefix it
// is a bridge candidate that only stays unpublished while no client block happens
// to contain the word.
// STATIC, not `await import('@stacksjs/auth')` inside the guard below.
//
// A dynamic import in a server block is resolved in the context of the module
// evaluating it — stx's variable-extractor — and the stx fork's
// node_modules/@stacksjs/auth is a symlink into a SIBLING PROJECT. So the
// dynamic form loaded another app's auth package, whose @stacksjs/orm has no
// User model for this database. Proven on login.stx, where it threw
// `User.where is not a function` with that project's path in the stack trace
// (fixed in 62d46ce); this page only escaped it because getUserFromToken
// leans on raw db queries rather than the ORM.
//
// The catch below would have hidden that: an import failure becomes
// `user = null`, which renders as signed-out rather than as an error.
import { Auth } from '@stacksjs/auth'
import { db as __db } from '@stacksjs/database'
// Config-only, deliberately not app/Fix/analyze: this page renders a hundred
// rows and calls no model, so it must not pull `@stacksjs/ai` in behind a
// question it only asks to decide whether to draw a link.
import { fixableLevel, fixEnabled } from '../../app/Fix/policy'
// The archive scope reads Parquet rather than log_entries. Same functions the
// API routes call, so the page and the API cannot answer differently.
import { archiveSummary, searchArchive } from '../../app/Archive/query'
import { archiveConfig } from '../../app/Archive/config'
import { projectPlan } from '../../app/Archive/plan'
import { utcIsoHoursAgo } from '../../app/Support/time'

// __stxServeSearch is a context local, injected onto THIS render's context by
// the serve path immediately before the block runs — not a global to reach
// through globalThis for. Reading it bare has no ordering requirement and no
// cross-request global to race on.
const query = new URLSearchParams(__stxServeSearch || '')

// Level filter is a MINIMUM-severity threshold: the key names the floor, and we
// expand it to the set of levels at or above it. Whitelisted — the raw param is
// never interpolated into SQL.
const LEVEL_ORDER = ['debug', 'info', 'notice', 'warning', 'error', 'critical', 'alert', 'emergency']
const LEVEL_TABS = [
  { key: 'all', label: 'All' },
  { key: 'debug', label: 'Debug+' },
  { key: 'info', label: 'Info+' },
  { key: 'warning', label: 'Warn+' },
  { key: 'error', label: 'Error+' },
]
// `find(...)?.key ?? default` rather than `some(...) ? get() : default`.
//
// The old form asked the same question twice — once in `some`, once by reading
// the param again — and the compiler could not carry the proof from the first
// to the second, so `levelFilter` stayed `string | null` and
// `LEVEL_ORDER.indexOf(levelFilter)` on the next line was a type error. This
// form states the whitelist lookup once and lands on `string`, which is what
// the code always meant. Same behaviour: an unknown or absent level is 'all'.
const levelParam = query.get('level')
const levelFilter = LEVEL_TABS.find(t => t.key === levelParam)?.key ?? 'all'
const levelSet = (levelFilter === 'all' || levelFilter === 'debug')
  ? null
  : LEVEL_ORDER.slice(LEVEL_ORDER.indexOf(levelFilter))

// Free-text search over the message (bounded, passed as a bound param).
const search = (query.get('q') || '').slice(0, 200)

// Date ranges are a whitelist: the key comes from the URL, and nothing derived
// from it is interpolated into SQL at all. `hours` drives the query as a bound
// cutoff, `interval` is the phrase the empty state prints.
//
// `hours` exists because the SQL here used to read
// `timestamp::timestamptz >= NOW() - INTERVAL '24 hours'`, which is Postgres and
// this app runs SQLite. Both halves throw there, so every range except All time
// failed, was swallowed by the catch below, and rendered the degraded `live =
// false` state in production. See app/Support/time.ts for the same fault
// costing log_fix_runs every row it ever tried to write.
interface LogRange {
  key: string
  label: string
  /** Hours back from now, or null for no bound. */
  hours: number | null
  /** How the window reads in prose, for the empty state. */
  interval: string | null
  /** Reads the Parquet archive rather than the hot database. */
  archive?: boolean
}

// Named, and placed in the list rather than duplicated beside it, so the
// fallback below cannot drift from the tab the UI renders as selected.
const DEFAULT_RANGE: LogRange = { key: '24h', label: '24h', hours: 24, interval: '24 hours' }

const RANGES: LogRange[] = [
  { key: '1h', label: '1h', hours: 1, interval: '1 hour' },
  DEFAULT_RANGE,
  { key: '7d', label: '7d', hours: 24 * 7, interval: '7 days' },
  { key: '30d', label: '30d', hours: 24 * 30, interval: '30 days' },
  { key: 'all', label: 'All time', hours: null, interval: null },
  // Everything that has aged out of the hot window and been written to Parquet.
  // A separate scope rather than a longer range: these rows are not in
  // log_entries any more, so they answer to a different query path entirely.
  { key: 'archive', label: 'Archive', hours: null, interval: null, archive: true },
]

// `activeRange` is the lookup, and `rangeFilter` is derived from it — the
// reverse of before, where a `some` guarded a ternary and then a separate
// `find` repeated the same predicate and returned `LogRange | undefined`.
//
// That `undefined` was never discharged, so `activeRange.interval` was
// dereferenced unguarded in four places, including one that interpolates into
// SQL. It held only because the two predicates agreed; nothing said they had
// to, and an edit to either would have failed at runtime with the type system
// silent. Now there is one predicate and a total fallback.
const rangeParam = query.get('range')
const activeRange = RANGES.find(r => r.key === rangeParam) ?? DEFAULT_RANGE
const rangeFilter = activeRange.key

const requestedProject = query.get('project')
const cookieProject = cookies.loghq_project ?? ''

const PAGE_SIZE = 50
const pageParam = Number.parseInt(query.get('page') || '1', 10)
const requestedPage = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1

// Authenticate from the token cookie. A project the user does not own is
// never resolved, so no
// tenant can read another tenant's logs by guessing a project id.
// `__token` is prefixed deliberately: extractBridgeData (client-script.ts:775)
// skips `__`-prefixed bindings, and everything else in this block is a bridge
// candidate that gets published into the HTML as soon as its NAME appears
// anywhere in the client script — comments included. Named `token`, this line
// put the raw session credential in the page source of every /dashboard render,
// because `useStore('session').token()` appears in the client block below. See
// the fuller note in settings.stx.
const __token = cookies.loghq_token ?? ''
let user: AuthUser | null = null
if (__token) {
  try {
    user = await Auth.getUserFromToken(__token)
  }
  catch (err) {
    // Fail closed, but leave a trace. This used to be a bare `catch {}`, so a
    // database blip and a genuinely signed-out visitor were indistinguishable
    // both on the page and in the log.
    console.error('[auth] getUserFromToken failed:', err instanceof Error ? err.message : err)
    user = null
  }
}

// Load the user's OWN projects (plus invited) and pick the active one.
let projects: ProjectRow[] = []
let activeProject: ProjectRow | null = null
let needsOnboarding = false
let pendingInvites: PendingInvite[] = []
// Set when the project lookup itself fails, as opposed to `live` below, which
// covers the log-stream queries. The two are separate because they degrade
// differently: without the stream you still get chrome and a filter bar to
// retry from; without the project list there is no page to render at all.
let projectsUnavailable = false
if (user) {
  const userEmail = String(user.email || '').trim().toLowerCase()
  // These two used to sit outside any try/catch, and the failure mode was not
  // the 500 you would expect. stx isolates a throwing view (#1810) and renders
  // what it already had, so a dropped connection or a table missing after a
  // half-applied migration produced HTTP 200 with the page truncated to
  // "Loading…" — a skeleton that never resolves, with no error anywhere.
  // Measured by renaming project_invites out from under a live server: 22845
  // bytes of dashboard became 14842 bytes of permanent spinner.
  try {
    projects = (await __db.unsafe(
      // No p.ingest_key. This page has no key UI, and `projects` is a bridge
      // candidate, so selecting the column published every project's ingest
      // credential — the only thing routes/logs.ts checks — into the HTML.
      `SELECT DISTINCT p.id, p.name, p.platform, p.created_at, p.is_active,
              (p.owner_id = $1) AS is_owner
      FROM projects p
      LEFT JOIN project_members m ON m.project_id = p.id AND lower(m.email) = $2
      WHERE p.owner_id = $1 OR m.email IS NOT NULL
      ORDER BY p.created_at DESC NULLS LAST, p.id`,
      [Number(user.id), userEmail],
    )) ?? []
    pendingInvites = (await __db.unsafe(
      `SELECT i.token, p.name AS project_name FROM project_invites i
      JOIN projects p ON p.id = i.project_id
      WHERE lower(i.email) = $1 ORDER BY i.created_at ASC NULLS LAST`,
      [userEmail],
    )) ?? []
  }
  catch {
    // Deliberately no onboarding bounce from here: needsOnboarding stays false,
    // so a transient database fault cannot redirect an existing user to
    // /projects/new and invite them to create a duplicate project.
    projectsUnavailable = true
    projects = []
    pendingInvites = []
  }
  if (!projectsUnavailable && projects.length === 0 && pendingInvites.length === 0)
    needsOnboarding = true
  else if (projects.length > 0)
    activeProject = projects.find(p => p.id === requestedProject) || projects.find(p => p.id === cookieProject) || projects[0]
}
const projectId = activeProject?.id || null

// Canonical dashboard URL for a filter state; defaults are omitted so links stay
// clean. The project rides the loghq_project cookie. Changing any filter resets
// to page 1.
function pageUrl(overrides: Partial<{ level: string, range: string, q: string, page: number }>): string {
  const state = { level: levelFilter, range: rangeFilter, q: search, page: requestedPage, ...overrides }
  const p = new URLSearchParams()
  if (state.level && state.level !== 'all')
    p.set('level', state.level)
  if (state.range && state.range !== '24h')
    p.set('range', state.range)
  if (state.q)
    p.set('q', state.q)
  if (state.page && state.page > 1)
    p.set('page', String(state.page))
  const s = p.toString()
  return s ? `/dashboard?${s}` : '/dashboard'
}

const levelTabs = LEVEL_TABS.map(t => ({ ...t, href: pageUrl({ level: t.key, page: 1 }) }))
const rangeTabs = RANGES.map(r => ({ ...r, href: pageUrl({ range: r.key, page: 1 }) }))

let logs: LogRow[] = []
let counts = { total: 0, warnings: 0, errors: 0 }
let live = false
let pager = { from: 0, to: 0, total: 0, page: 1, pages: 1, hasPrev: false, hasNext: false, prevHref: '', nextHref: '' }

// Archive scope state. Only populated when the Archive tab is active.
let archivePlan = 'free'
let archiveNextCursor: string | null = null
let archiveSummaryRow = { partitions: 0, archivedRows: 0, archivedBytes: 0, prunedRows: 0, oldestDay: null as string | null, newestDay: null as string | null }
const isArchive = activeRange.archive === true
const hotWindowDays = archiveConfig().hotWindowDays

async function loadData(): Promise<void> {
  if (!projectId)
    return

  // The archive scope reads Parquet through DuckDB instead of the hot table, so
  // it takes its own path and returns before any of the SQL below.
  if (activeRange.archive) {
    await loadArchive()
    return
  }

  // WHERE for the stream: project + level threshold + range + search. Levels
  // come from the LEVEL_ORDER whitelist; every other value is a bound param.
  const conds = ['project_id = $1']
  const params = [projectId]
  if (levelSet) {
    // Individual placeholders (`IN (...)`), not `= ANY($n)` with an array param:
    // __db.unsafe binds a JS array as a malformed Postgres array literal.
    const placeholders = levelSet.map((_, i) => `$${params.length + i + 1}`).join(',')
    levelSet.forEach(l => params.push(l))
    conds.push(`level IN (${placeholders})`)
  }
  // timestamp is an ISO-8601 varchar, so the cutoff is bound in the same shape
  // and compared as a string. utcIsoHoursAgo, not utcHoursAgo: the latter is
  // shaped for created_at and the two formats diverge at the eleventh character.
  if (activeRange.hours != null) {
    params.push(utcIsoHoursAgo(activeRange.hours))
    conds.push(`timestamp >= $${params.length}`)
  }
  if (search) {
    // lower(...) LIKE lower(...) rather than ILIKE, which SQLite does not have.
    // Spelling it this way is case-insensitive on both engines, where a bare
    // LIKE would quietly become case-sensitive the day this moves to Postgres.
    params.push(`%${search.toLowerCase()}%`)
    conds.push(`lower(message) LIKE $${params.length}`)
  }
  const where = conds.join(' AND ')

  const filteredTotal = Number((await __db.unsafe(`SELECT COUNT(*) AS n FROM log_entries WHERE ${where}`, params))?.[0]?.n ?? 0)
  const pages = Math.max(1, Math.ceil(filteredTotal / PAGE_SIZE))
  const page = Math.min(requestedPage, pages)
  const offset = (page - 1) * PAGE_SIZE

  logs = (await __db.unsafe(
    `SELECT id, level, message, channel, environment, release, framework, host, context, timestamp
    FROM log_entries WHERE ${where} ORDER BY timestamp DESC, id DESC LIMIT ${PAGE_SIZE} OFFSET ${offset}`,
    params,
  )) ?? []

  pager = {
    from: filteredTotal === 0 ? 0 : offset + 1,
    to: offset + logs.length,
    total: filteredTotal,
    page,
    pages,
    hasPrev: page > 1,
    hasNext: page < pages,
    prevHref: pageUrl({ page: page - 1 }),
    nextHref: pageUrl({ page: page + 1 }),
  }

  // Stats respect the date range but not the level tabs (which only slice the
  // list). Warnings = warning; errors = error and worse.
  const cconds = ['project_id = $1']
  const cparams: any[] = [projectId]
  if (activeRange.hours != null) {
    cparams.push(utcIsoHoursAgo(activeRange.hours))
    cconds.push(`timestamp >= $${cparams.length}`)
  }
  const c = (await __db.unsafe(
    `SELECT COUNT(*) AS total,
            COUNT(*) FILTER (WHERE level = 'warning') AS warnings,
            COUNT(*) FILTER (WHERE level IN ('error','critical','alert','emergency')) AS errors
    FROM log_entries WHERE ${cconds.join(' AND ')}`,
    cparams,
  ))?.[0]
  counts = { total: Number(c?.total ?? 0), warnings: Number(c?.warnings ?? 0), errors: Number(c?.errors ?? 0) }
  live = true
}

/**
 * The Archive scope: entries that have left the hot database for Parquet.
 *
 * Paged by keyset rather than by offset, because that is the only cursor
 * read_parquet can be asked for cheaply, so the pager below renders prev/next
 * links carrying a cursor instead of page numbers.
 */
async function loadArchive(): Promise<void> {
  if (!projectId)
    return

  archivePlan = await projectPlan(projectId)

  if (archivePlan !== 'pro') {
    // Nothing to show, and nothing to apologise for: a free project's aged logs
    // were pruned rather than archived, which is what the plan says happens.
    archiveSummaryRow = await archiveSummary(projectId)
    logs = []
    live = true
    return
  }

  const [cursorTs, cursorId] = (query.get('cursor') || '').split('~')
  const { logs: rows, nextCursor } = await searchArchive(projectId, {
    levels: levelSet ?? undefined,
    q: search || undefined,
    beforeTs: cursorTs || undefined,
    beforeId: cursorId || undefined,
    limit: PAGE_SIZE,
  })

  logs = rows as LogRow[]
  archiveNextCursor = nextCursor ? `${nextCursor.ts}~${nextCursor.id}` : null
  archiveSummaryRow = await archiveSummary(projectId)

  // Totals come from the ledger rather than from scanning the files: the row
  // counts were recorded when each partition was verified.
  counts = {
    total: archiveSummaryRow.archivedRows,
    warnings: 0,
    errors: 0,
  }

  pager = {
    from: rows.length ? 1 : 0,
    to: rows.length,
    total: archiveSummaryRow.archivedRows,
    page: 1,
    pages: 1,
    hasPrev: !!cursorTs,
    hasNext: !!archiveNextCursor,
    prevHref: pageUrl({ range: 'archive' }),
    nextHref: archiveNextCursor ? `${pageUrl({ range: 'archive' })}${pageUrl({ range: 'archive' }).includes('?') ? '&' : '?'}cursor=${encodeURIComponent(archiveNextCursor)}` : '',
  }

  live = true
}

// The loser of a Promise.race is not cancelled, it is merely ignored. This used
// to leave the 5s timer armed on every render where the query won, so each
// request held a pending handle for the rest of that window for nothing. Cleared
// in `finally`, which covers the timeout branch too.
//
// A server-block timer, deliberately not useTimeout: reactive APIs are inert
// stubs in this scope, so the composable would silently never fire.
let __queryTimer: ReturnType<typeof setTimeout> | undefined
try {
  if (projectId) {
    await Promise.race([
      loadData(),
      new Promise((_resolve, reject) => {
        __queryTimer = setTimeout(() => reject(new Error('timeout')), 5000)
      }),
    ])
  }
}
catch {
  live = false
}
finally {
  if (__queryTimer)
    clearTimeout(__queryTimer)
}

// Severity drives the one accent-adjacent semantic color on the list rail.
// The level as a data attribute, not a colour. The six hex literals this used to
// return are tokens in public/tokens.css now (--sev-*), and app-chrome.css maps
// `data-level` onto a single `--sev` that the rail and the badge both read. Two
// wins beyond removing the inline styles: the palette is named once instead of
// twice, and it follows the theme, where one hardcoded set was previously used
// on both.
function levelKey(level: LogLevel | null | undefined): string {
  return String(level || 'debug')
}
function levelLabel(level: LogLevel | null | undefined): string {
  return String(level || 'info').toUpperCase()
}
// Compact fixed-width labels so the level column stays aligned across every row
// (a log tail reads best when the message always starts at the same x).
function chipLabel(level: LogLevel | null | undefined): string {
  switch (level) {
    case 'emergency': return 'EMERG'
    case 'critical': return 'CRIT'
    case 'warning': return 'WARN'
    case 'notice': return 'NOTE'
    default: return String(level || 'info').toUpperCase()
  }
}
// Absolute clock (HH:MM:SS) for the row; the stream is read against wall time.
function clockOf(iso: string | null | undefined): string {
  if (!iso) return '--:--:--'
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return String(iso).slice(11, 19) || '--:--:--'
  return d.toISOString().slice(11, 19)
}
function dayOf(iso: string | null | undefined): string {
  if (!iso) return ''
  const d = new Date(iso)
  return Number.isNaN(d.getTime()) ? '' : d.toISOString().slice(5, 10)
}
// Whether the expanded row offers "Fix with AI". Both halves of the question
// live in app/Fix/policy.ts; this wrapper exists only because the template
// calls it per row, and a local function is how every other row-level helper
// on this page is reached.
function canFix(level: LogLevel | null | undefined): boolean {
  return fixEnabled() && fixableLevel(level)
}

// Pretty-print stored JSON context for the expanded row (best-effort).
function prettyContext(raw: unknown): string {
  if (!raw) return ''
  // JSON.parse takes a string, and `raw` is unknown — context comes from a text
  // column, so it is a string in practice, but the signature does not say so.
  // The coercion is exactly what JSON.parse was doing implicitly with anything
  // else, and both paths still land on the same value: a non-string stringifies
  // to something unparseable, throws, and falls out of the catch unchanged.
  const text = typeof raw === 'string' ? raw : String(raw)
  try { return JSON.stringify(JSON.parse(text), null, 2) }
  catch { return text }
}

// Stats carry state, not just a number: the dot + number tint go live only when
// the count is non-zero, so "are there errors right now?" reads at a glance.
// `tone` replaces a hex literal per row. The two colours here were the same
// amber and rose the log rows used, written a second time — so the palette could
// drift between the stat cards and the rows below them. app-chrome.css keys the
// dot and the number off `data-tone`, which is set only when the count is
// non-zero; that is what `on` expressed as an inline ternary.
const stats = [
  { label: 'Log entries', value: counts.total.toLocaleString(), dot: false, tone: '' },
  { label: 'Warnings', value: counts.warnings.toLocaleString(), dot: true, tone: counts.warnings > 0 ? 'warning' : '' },
  { label: 'Errors', value: counts.errors.toLocaleString(), dot: true, tone: counts.errors > 0 ? 'error' : '' },
]

// What this page lets the client block read, declared.
//
// switchUrl is where the project switcher lands. pageUrl() is server-side — it
// reads the filter state this render was built from — so the client cannot
// rebuild it. It used to cross as a hand-JSON-encoded string; defineClientPayload
// does that encoding itself.
//
// needsOnboarding was already crossing on the implicit bridge, just untyped and
// only because the name happened to appear in the client source. It is listed
// now, so it crosses because this line says so.
defineClientPayload({
  switchUrl: pageUrl({ page: 1 }),
  needsOnboarding,
})

useSeoMeta({
  title: 'Logs - loghq',
  description: 'Your live application log stream: filter by level, search messages, and inspect structured context.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Dashboard chrome: theme toggle, plan badge, logout, and the invite banner.
//
// The logout and Upgrade controls used to be built in JS and mounted on the
// document body. Body-mounted nodes survive an SPA view swap, so
// they outlived this page and painted stale chrome over the next one. They are
// declarative markup inside the page container now, which the router replaces
// along with everything else.
const pro = state(false)

// `theme` mirrors the root element's data-theme — the root is owned by no
// component, and stx's color-mode boot script — emitted from app.colorMode in
// config/ui.ts — sets it before hydration to avoid a flash.
function toggleTheme(): void {
  // The theme store owns persistence, the prefers-color-scheme listener, the
  // cross-tab storage listener and the dark-class write. This used to do the
  // first of those by hand and none of the rest, in three separate files.
  useStore('theme').toggle()
}

function signOut(): void {
  // One call. The store owns the token cookie and the cached viewer, and the
  // revoke request is fire-and-forget inside it: the credentials are being
  // discarded either way, so a failed revoke must not strand someone on a page
  // they have already logged out of.
  useStore('session').signOut()
}

// Invite banner. Was one delegated listener on the container doing className
// sniffing and row.remove(); each row now owns its own handlers and the state
// is keyed by invite token.
const dismissed = state<string[]>([])
const joining = state('')

const isDismissed = (t: string): boolean => dismissed().includes(t)
const joinLabel = (t: string): string => (joining() === t ? 'Joining…' : 'Join')

// ---- project switcher ----
//
// This was a DOM-0 `onchange` attribute that wrote document.cookie by hand,
// read location.protocol to decide the secure flag, and then assigned
// location.href — four separate violations in one attribute, none of them
// visible to the strict validator, which only scans <script> bodies.
//
// The cookie is the session store's `project` signal, so setting it here writes
// the same cookie with the same attributes the store already declares. The
// reload is DECLARED, as in settings.stx: the server render is keyed off that
// cookie, so a fragment swap would repaint the old project's logs.
// switchUrl arrives from defineClientPayload in the server block, already a
// string. Do not redeclare it here — the bridge skips any name the client
// declares itself, which would leave it undefined.
function switchProject(e: Event): void {
  useStore('session').project.set((e.target as HTMLSelectElement).value)
  navigate(switchUrl, { reload: true })
}

function dismissInvite(token: string): void {
  dismissed.set([...dismissed(), token])
}

// One URL, one method — the shape useMutation fits. No Authorization header: the
// session store's configureFetch attaches the bearer, and its onResponseError
// owns the 401, which this hand-written version had no branch for at all.
//
// `joining` stays a page signal rather than using acceptInvite.loading(). It
// holds WHICH invite is in flight, not merely whether one is, because the banner
// disables only the row being accepted.
const acceptInvite = useMutation('/api/invites/accept', {
  onError() {
    // 401 included: the interceptor is already clearing the session and
    // leaving, and releasing the row is right either way.
    joining.set('')
  },
  onSuccess(body: { project: string }) {
    useStore('session').project.set(body.project)
    navigate('/dashboard', { reload: true })
  },
})

async function joinInvite(token: string): Promise<void> {
  if (joining())
    return
  joining.set(token)
  await acceptInvite.mutate({ token }).catch(() => {})
}

// Pro status comes from the session store, which fetches /api/me once and
// shares it with the account page instead of each requesting it separately.
onMount(() => {
  const session = useStore('session')
  session.loadViewer()
  effect(() => pro.set(session.pro()))
})

// Onboarding bounce. The server block already computed needsOnboarding, and it
// crosses to here through the server-to-client bridge, so this is not a second
// decision — it is the same one, acted on somewhere cancellable and lintable.
// It replaces a <script> tag emitted as page CONTENT, which is not a redirect:
// it is a fully rendered page that then tears itself down, costing a paint and
// a second document load on a route the server already knew was wrong.
onMount(() => {
  if (needsOnboarding)
    navigate('/projects/new', { reload: true })
})

// Project selection arrives as ?project=… from the apps list. This used to be a
// pre-paint script, which it never needed to be: the server has already
// rendered by the time it runs, so the cookie it writes only takes effect on
// the NEXT request. Moving it here costs nothing and removes a raw cookie
// write, a location read and a history rewrite — three DOM-guard violations.
//
// Names are described rather than spelled here on purpose: the strict
// validator scans script bodies as raw text, comments included, so quoting a
// prohibited API in a comment reports as a violation of it.
//
// The param is deliberately not stripped from the URL. stx has since given
// useSearchParams a working delete (#1806 — the declaration used to promise one
// the runtime did not have), so this is now a choice rather than a limitation,
// and the choice is unchanged: the server prefers the query param over the
// cookie, so the URL stays shareable and pinned to that project, and it clears
// itself on the first filter click because pageUrl() does not carry it.
onMount(() => {
  const requested = useSearchParams().get('project')
  if (requested)
    useStore('session').project.set(requested)
})
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
{{-- No hand-written theme guard here. config/ui.ts declares app.colorMode, and
    stx emits the pre-paint boot script from that one declaration — first inside
    <head>, above every stylesheet, reading the same loghq_theme key and setting
    the same data-theme attribute this script used to set by hand. The generated
    one is strictly better: it also resolves 'auto' against
    prefers-color-scheme, which the three copies here never did. --}}

{{-- Ambient grain overlay: barely-there texture so surfaces aren't sterile-flat. --}}
<div class="grain" aria-hidden="true"></div>

{{-- page-dashboard carries this page's indigo --accent and --rail, which
    used to be a :root block in a page <style> tag and was scoped only by
    which page happened to carry that tag. It is public/app-chrome.css now,
    hung off this wrapper so it cannot repaint the rest of the app. The
    fixed-position chrome below is inside the wrapper and still inherits it;
    the grain overlay sits outside and needs no accent. --}}
<div class="px-5 py-10 md:px-10 min-h-[100dvh] page-dashboard">
  {{-- Fixed-position chrome. Inside the page container, not document.body, so an
      SPA view swap takes it with the rest of the page. Position is fixed, so
      where it sits in the DOM does not affect layout. --}}
  <StxLink class="chrome-upgrade" to="/pricing" :show="!pro()">Upgrade</StxLink>
  <span class="chrome-pro chrome-upgrade" :show="pro()">Pro</span>
  <button class="chrome-logout" @click="signOut">Log out</button>

  <div class="mx-auto max-w-5xl">

    @if (!user)
      <div id="auth-pending" class="py-24 text-center text-sm text-subtle">Loading…</div>
    @endif

    @if (user && needsOnboarding)
      <div class="py-24 text-center text-sm text-subtle">Setting up your workspace…</div>
    @endif

    {{-- The project lookup failed. Say so, rather than leaving the page as the
        "Loading…" skeleton above — which is exactly what it did before, on a
        200, forever. Wording matches the stream's own fault state further down
        so the two read as one condition when they happen together. --}}
    @if (user && projectsUnavailable)
      <div class="py-24 text-center">
        <p class="text-muted text-sm"><span class="font-semibold text-ink">Can't reach your projects right now.</span> Make sure Postgres is provisioned.</p>
        <p class="mt-2 text-subtle text-xs">Nothing has been lost — reload once the database is back.</p>
      </div>
    @endif

    @if (user && !needsOnboarding && !projectsUnavailable)

    @if (pendingInvites.length)
      <div class="mb-7">
        @foreach (pendingInvites as inv)
          <div class="flex flex-wrap gap-3 items-center mb-2.5 px-5 py-3.5 bg-[color-mix(in_srgb,var(--accent)_6%,var(--panel))] border border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] rounded-xl" :show="!isDismissed('{{ inv.token }}')">
            <span class="text-sm">🎉 You've been invited to <span class="font-semibold">{{ inv.project_name }}</span>.</span>
            <div class="flex gap-2 items-center ml-auto">
              <button class="px-4 py-1.5 font-semibold text-sm text-accent-ink bg-accent border border-accent js-invite-join pill" @click="joinInvite('{{ inv.token }}')" :disabled="joining() === '{{ inv.token }}'" :text="joinLabel('{{ inv.token }}')">Join</button>
              <button class="px-3 py-1.5 text-sm text-subtle border border-line js-invite-dismiss pill" x-tooltip="Hide for now" @click="dismissInvite('{{ inv.token }}')">Dismiss</button>
            </div>
          </div>
        @endforeach
      </div>
    @endif

    @if (projectId)
    <header class="flex flex-wrap gap-5 items-end justify-between mb-8">
      {{-- flex-wrap, matching the header that contains it. Without it these six
          controls — wordmark, project select, All apps, New app, theme, settings
          — sat on one unbreakable 452px line, and the dashboard scrolled
          sideways by 97px at 375px. Measured in a real browser, not inferred:
          this div was the single outermost element whose right edge crossed the
          viewport. The outer header already wrapped, which is what hid it. --}}
      <div class="flex flex-wrap gap-3 items-center">
        <StxLink to="/projects" class="wordmark-link"><h1 class="font-sans leading-none text-2xl md:text-[28px] wordmark">loghq</h1></StxLink>
        @if (projects.length > 1)
          <select @change="switchProject" aria-label="Switch project" class="px-3 py-1.5 font-mono text-muted text-sm app-panel tnum">
            @foreach (projects as p)
              <option value="{{ p.id }}" {{ p.id === projectId ? 'selected' : '' }}>{{ p.name }}{{ p.is_active === false ? ' (archived)' : '' }}</option>
            @endforeach
          </select>
        @else
          <span class="font-mono text-muted text-sm tnum">{{ activeProject?.name }}{{ activeProject?.is_active === false ? ' (archived)' : '' }}</span>
        @endif
        <StxLink to="/projects" class="px-3 py-1.5 font-medium text-muted text-sm border border-line pill">All apps</StxLink>
        <StxLink to="/projects/new" class="px-3 py-1.5 font-medium text-muted text-sm border border-line pill">+ New app</StxLink>
        <button class="icon-btn theme-btn" @click="toggleTheme" x-tooltip="Toggle theme" aria-label="Toggle theme">
          <Icon name="lucide:sun" size="17" class="h-[17px] w-[17px] ic-sun" />
          <Icon name="lucide:moon" size="17" class="h-[17px] w-[17px] ic-moon" />
        </button>
        {{-- x-tooltip lives on this WRAPPER, not on the StxLink, and that is
            load-bearing. component-renderer.ts:154-159 rewrites any x-* attribute
            on a COMPONENT to a `:` signal binding unless the name is in its
            ALPINE_PASSTHROUGH set — and x-tooltip is not in that set, even though
            the signals runtime lists it in X_HANDLED (signals.ts:2295) as an
            attribute it consumes itself. So x-tooltip="Settings" on the StxLink
            became :tooltip="Settings", stx tried to evaluate the bare identifier
            Settings as an expression, and the page logged
            "hydration invariant failed after DOMContentLoaded: 1 expression(s)
            never evaluated — Settings is not defined". Filed upstream. The same
            trap applies to <Icon> and every other component; a plain element is
            the only safe host until the two lists agree.

            The span is inline-flex so it behaves as the same flex item the
            anchor used to be, and the hover area is unchanged. --}}
        <span class="inline-flex" x-tooltip="Settings">
          <StxLink to="/settings" class="icon-btn" aria-label="Settings">
            {{-- 17px to match the sun/moon beside it. The hand-pasted SVG this
                replaced carried no width/height at all, so it sized itself from
                the 34px button rather than from its siblings. --}}
            <Icon name="lucide:settings" size="17" class="h-[17px] w-[17px]" />
          </StxLink>
        </span>
      </div>
      <nav class="flex flex-wrap gap-1.5 items-center">
        {{-- `to` is interpolated raw here, and only here. Inside a loop the value
            is escaped once by the loop and again when the component emits its
            href, so `to="{{ … }}"` yields &amp;amp; and the browser sees a
            literal "&amp;" in the query string — the second filter arrives as a
            param named "amp;range". Outside a loop the same form is correct.
            Safe because these hrefs come from pageUrl(), which builds them with
            URLSearchParams: every value is already percent-encoded, so the only
            literal ampersands are the separators and a quote cannot appear. --}}
        @foreach (levelTabs as f)
          <StxLink to="{!! f.href !!}"
            class="px-3.5 py-1.5 font-medium text-sm border pill {{ f.key === levelFilter ? 'pill-on' : 'pill-off' }}"
            aria-current="{{ f.key === levelFilter ? 'page' : 'false' }}">{{ f.label }}</StxLink>
        @endforeach
        <span class="shrink-0 mx-1.5 h-4 w-px bg-line" aria-hidden="true"></span>
        @foreach (rangeTabs as r)
          <StxLink to="{!! r.href !!}"
            class="px-3 py-1.5 font-medium text-xs border font-mono tnum pill {{ r.key === rangeFilter ? 'pill-on-soft' : 'pill-off-soft' }}"
            aria-current="{{ r.key === rangeFilter ? 'page' : 'false' }}">{{ r.label }}</StxLink>
        @endforeach
      </nav>
    </header>

    {{-- Search: plain GET form, preserves level + range via hidden fields. --}}
    <form method="get" action="/dashboard" class="flex gap-2 items-center mb-6">
      @if (levelFilter !== 'all')<input type="hidden" name="level" value="{{ levelFilter }}">@endif
      @if (rangeFilter !== '24h')<input type="hidden" name="range" value="{{ rangeFilter }}">@endif
      <input type="search" name="q" aria-label="Search log messages" value="{{ search }}" placeholder="Search log messages…" autocomplete="off"
            class="flex-1 px-4 py-2.5 font-mono text-sm search-input tnum" />
      <button type="submit" class="px-4 py-2.5 font-semibold text-sm text-accent-ink bg-accent border border-accent pill">Search</button>
      @if (search)
        <StxLink to="{{ pageUrl({ q: '', page: 1 }) }}" class="px-3 py-2.5 text-sm text-subtle border border-line pill">Clear</StxLink>
      @endif
    </form>

    @if (!live)
      <div class="mb-8 px-4 py-3 text-muted text-sm app-panel reveal">
        <span class="font-semibold text-ink">Waiting for data.</span> Make sure Postgres is provisioned.
      </div>
    @endif

    {{-- Stats: hairline-separated, mono numerics. The dot + number tint go live
        only on a non-zero count, so severity reads at a glance. --}}
    <div class="grid grid-cols-3 mb-8 border-line divide-x app-panel reveal">
      @foreach (stats as s)
        <div class="px-5 py-5 border-line" data-tone="{{ s.tone }}">
          <div class="flex gap-1.5 items-center mb-2">
            @if (s.dot)<span class="inline-block shrink-0 h-1.5 w-1.5 rounded-full stat-dot"></span>@endif
            <span class="font-medium text-subtle text-xs tracking-wider uppercase">{{ s.label }}</span>
          </div>
          <div class="font-mono font-semibold text-3xl tracking-tight stat-value tnum">{{ s.value }}</div>
        </div>
      @endforeach
    </div>

    <section class="overflow-hidden app-panel reveal">
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-line">
        <span class="font-semibold text-subtle text-xs tracking-wider uppercase">Stream</span>
        <span class="font-mono text-subtle text-xs tnum">{{ pager.total === 0 ? 'none' : `${pager.from}-${pager.to} of ${pager.total.toLocaleString()}` }}</span>
      </div>

      @forelse (logs as entry)
        <details class="border-b border-line">
          <summary class="px-5 py-2.5 log-row" data-level="{{ levelKey(entry.level) }}">
            <span class="self-stretch rounded-full log-rail"></span>
            <span class="font-mono tabular-nums text-subtle text-xs tnum" x-tooltip="{{ entry.timestamp }}">{{ clockOf(entry.timestamp) }}</span>
            <span class="inline-block px-1 py-0.5 font-mono font-semibold text-[11px] text-center whitespace-nowrap rounded log-level tnum">{{ chipLabel(entry.level) }}</span>
            <span class="font-mono text-[11px] text-subtle truncate tnum">{{ entry.channel || '' }}</span>
            <span class="min-w-0 font-mono text-ink text-sm truncate tnum">{{ entry.message }}</span>
          </summary>
          <div class="pb-4 pt-1 px-5 bg-[color-mix(in_srgb,var(--accent)_3%,transparent)]">
            <div class="flex flex-wrap gap-x-5 gap-y-1 mb-3 font-mono text-subtle text-xs tnum">
              <span>{{ dayOf(entry.timestamp) }} {{ clockOf(entry.timestamp) }} UTC</span>
              @if (entry.environment)<span>env: <span class="text-muted">{{ entry.environment }}</span></span>@endif
              @if (entry.framework)<span>via: <span class="text-muted">{{ entry.framework }}</span></span>@endif
              @if (entry.release)<span>release: <span class="text-muted">{{ entry.release }}</span></span>@endif
              @if (entry.host)<span>host: <span class="text-muted">{{ entry.host }}</span></span>@endif
            </div>
            <div class="mb-3 break-words font-mono text-ink text-sm whitespace-pre-wrap tnum">{{ entry.message }}</div>
            @if (entry.context)
              <pre class="overflow-x-auto px-3 py-2.5 break-words font-mono text-muted text-xs whitespace-pre-wrap app-panel tnum">{{ prettyContext(entry.context) }}</pre>
            @endif
            {{-- Offered from `warning` up only. Below that the answer is nearly
                always "nothing is wrong", and a button that usually says so is
                a button people stop reading. A link, not a submit: nothing is
                spent until the next page is opened and the analysis asked for
                explicitly. --}}
            @if (canFix(entry.level))
              <div class="mt-3.5">
                <StxLink to="/fix?log={{ entry.id }}" class="inline-flex gap-1.5 items-center px-3 py-1.5 font-medium text-muted text-xs border border-line pill">
                  <i class="h-3.5 w-3.5 i-hugeicons-ai-magic"></i> Fix with AI
                </StxLink>
              </div>
            @endif
          </div>
        </details>
      @empty
        @if (isArchive && archivePlan !== 'pro')
          <div class="px-5 py-16 text-center">
            <div class="mb-1 font-medium text-base">Archived logs are a Pro feature</div>
            <div class="mb-4 mx-auto max-w-md text-sm text-subtle">
              On the free plan, entries older than your {{ hotWindowDays }} day window are removed rather than archived.
              @if (archiveSummaryRow.prunedRows > 0)
                So far {{ archiveSummaryRow.prunedRows.toLocaleString() }} entries have aged out this way.
              @endif
              Upgrade to keep them searchable for good.
            </div>
            <StxLink to="/settings#retention" class="inline-block px-4 py-2 font-semibold text-accent-ink text-sm bg-accent rounded-[10px]">See retention settings</StxLink>
          </div>
        @elseif (isArchive)
          <div class="px-5 py-16 text-center">
            <div class="mb-1 font-medium text-base">Nothing archived yet{{ search ? ` matching "${search}"` : '' }}</div>
            <div class="text-sm text-subtle">Entries move here once they pass the {{ hotWindowDays }} day hot window.</div>
          </div>
        @else
          <div class="px-5 py-16 text-center">
            <div class="mb-1 font-medium text-base">No log entries{{ search ? ` matching "${search}"` : '' }}{{ activeRange.interval ? ` in the last ${activeRange.interval}` : '' }}</div>
            <div class="text-sm text-subtle">Point an SDK at this project and its logs stream in here live.</div>
          </div>
        @endif
      @endforelse

      @if (isArchive && (pager.hasPrev || pager.hasNext))
        <div class="flex items-center justify-between px-5 py-3.5">
          <span class="font-mono text-subtle text-xs tnum">{{ pager.to }} shown{{ archiveSummaryRow.archivedRows ? ` of ${archiveSummaryRow.archivedRows.toLocaleString()} archived` : '' }}</span>
          <div class="flex gap-2 items-center">
            @if (pager.hasPrev)
              <StxLink to="{{ pager.prevHref }}" class="px-3 py-1.5 font-medium text-muted text-xs border border-line pill">&larr; Newest</StxLink>
            @else
              <span class="px-3 py-1.5 font-medium text-subtle text-xs border border-line opacity-45 pill">&larr; Newest</span>
            @endif
            @if (pager.hasNext)
              <StxLink to="{{ pager.nextHref }}" class="px-3 py-1.5 font-medium text-muted text-xs border border-line pill">Older &rarr;</StxLink>
            @else
              <span class="px-3 py-1.5 font-medium text-subtle text-xs border border-line opacity-45 pill">Older &rarr;</span>
            @endif
          </div>
        </div>
      @elseif (pager.pages > 1)
        <div class="flex items-center justify-between px-5 py-3.5">
          <span class="font-mono text-subtle text-xs tnum">{{ pager.from }}-{{ pager.to }} of {{ pager.total.toLocaleString() }}</span>
          <div class="flex gap-2 items-center">
            @if (pager.hasPrev)
              <StxLink to="{{ pager.prevHref }}" class="px-3 py-1.5 font-medium text-muted text-xs border border-line pill">&larr; Newer</StxLink>
            @else
              <span class="px-3 py-1.5 font-medium text-subtle text-xs border border-line opacity-45 pill">&larr; Newer</span>
            @endif
            <span class="font-mono tabular-nums text-subtle text-xs tnum">{{ pager.page }} / {{ pager.pages }}</span>
            @if (pager.hasNext)
              <StxLink to="{{ pager.nextHref }}" class="px-3 py-1.5 font-medium text-muted text-xs border border-line pill">Older &rarr;</StxLink>
            @else
              <span class="px-3 py-1.5 font-medium text-subtle text-xs border border-line opacity-45 pill">Older &rarr;</span>
            @endif
          </div>
        </div>
      @endif
    </section>
    @else
      <div class="py-20 text-center">
        <StxLink to="/projects" class="wordmark-link"><h1 class="mb-3 font-sans text-2xl wordmark">loghq</h1></StxLink>
        <p class="text-sm text-subtle">Accept an invitation above to get started, or <StxLink to="/projects/new" class="text-accent">create your own app</StxLink>.</p>
      </div>
    @endif
    @endif

    <footer class="mt-12 text-center text-subtle text-xs">
      Log streaming on Stacks and Postgres. <span class="font-font-mono [font-feature-settings:'tnum'_1] tnum">loghq.org</span>
    </footer>

  </div>
</div>

{{-- Client guard: enforce the bearer token and mirror it into the cookie the
    server authenticates from. Navigation only — it renders nothing, and it has
    to run before the page is usable, so it stays a plain script rather than
    hydrating with the rest.
    The chrome and invite banner it used to build now live in the client block
    at the top of this file. --}}


@include('AuthGuard')
@endsection
