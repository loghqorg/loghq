<script server>
// loghq analytics: entry volume over time and level distribution per release,
// spanning both the hot database and the Parquet archive.
//
// Follows dashboard.stx throughout: authenticate from the token cookie, resolve
// the user's own projects, hold filter state in the URL query, and read through
// app/Archive/query.ts so this page and the API cannot answer the same question
// differently. The `__` prefixes and the static-import rules are load-bearing
// for the same reasons documented at length there.
import { Auth } from '@stacksjs/auth'
import { db as __db } from '@stacksjs/database'
import { archiveConfig } from '../../app/Archive/config'
import { projectPlan } from '../../app/Archive/plan'
import { archiveSummary, levelsByRelease, volumeSeries } from '../../app/Archive/query'

const query = new URLSearchParams(typeof __stxServeSearch !== 'undefined' ? __stxServeSearch : '')

// Whitelisted, like the dashboard's ranges: the key comes from the URL and only
// the mapped day count is ever used in a query.
interface AnalyticsRange {
  key: string
  label: string
  days: number
}

const DEFAULT_RANGE: AnalyticsRange = { key: '30d', label: '30 days', days: 30 }
const RANGES: AnalyticsRange[] = [
  { key: '7d', label: '7 days', days: 7 },
  DEFAULT_RANGE,
  { key: '90d', label: '90 days', days: 90 },
  { key: '180d', label: '180 days', days: 180 },
]

const activeRange = RANGES.find(r => r.key === query.get('range')) ?? DEFAULT_RANGE

// Custom range: ?from=YYYY-MM-DD&to=YYYY-MM-DD, both required and valid, and it
// wins over the preset. volumeSeries/levelsByRelease already take day bounds, so
// a custom span needs no query changes; it is still bucketed by day like 180d.
const qFrom = query.get('from')
const qTo = query.get('to')
const isDay = (v: string | null): v is string => typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)
const isCustom = isDay(qFrom) && isDay(qTo)
const customFrom = isCustom ? String(qFrom).slice(0, 10) : ''
const customTo = isCustom ? String(qTo).slice(0, 10) : ''
// The one-line label the picker button shows.
const fmtDay = (d: string): string => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
const rangeLabel = isCustom
  ? (customFrom.slice(0, 4) === customTo.slice(0, 4) ? `${fmtDay(customFrom)} \u2013 ${fmtDay(customTo)}, ${customTo.slice(0, 4)}` : `${fmtDay(customFrom)}, ${customFrom.slice(0, 4)} \u2013 ${fmtDay(customTo)}, ${customTo.slice(0, 4)}`)
  : activeRange.label

const requestedProject = query.get('project')
const cookieProject = typeof cookies !== 'undefined' ? (cookies.loghq_project ?? '') : ''

const __token = typeof cookies !== 'undefined' ? (cookies.loghq_token ?? '') : ''
let user: AuthUser | null = null
if (__token) {
  try {
    user = await Auth.getUserFromToken(__token)
  }
  catch (err) {
    console.error('[auth] getUserFromToken failed:', err instanceof Error ? err.message : err)
    user = null
  }
}

let projects: any[] = []
let activeProject: any = null
let projectsUnavailable = false
if (user) {
  const userEmail = String(user.email || '').trim().toLowerCase()
  try {
    projects = (await __db.unsafe(
      // No p.ingest_key: `projects` is a bridge candidate, and selecting the
      // column would publish every ingest credential into the page source.
      `SELECT DISTINCT p.id, p.name, p.is_active
      FROM projects p
      LEFT JOIN project_members m ON m.project_id = p.id AND lower(m.email) = $2
      WHERE p.owner_id = $1 OR m.email IS NOT NULL
      ORDER BY p.created_at DESC NULLS LAST, p.id`,
      [Number(user.id), userEmail],
    )) ?? []
  }
  catch {
    projectsUnavailable = true
    projects = []
  }
  if (projects.length > 0)
    activeProject = projects.find(p => p.id === requestedProject) || projects.find(p => p.id === cookieProject) || projects[0]
}
const projectId = activeProject?.id || null

function pageUrl(overrides: Partial<{ range: string }>): string {
  const state = { range: activeRange.key, ...overrides }
  const p = new URLSearchParams()
  if (state.range && state.range !== DEFAULT_RANGE.key)
    p.set('range', state.range)
  const s = p.toString()
  return s ? `/analytics?${s}` : '/analytics'
}

const rangeTabs = RANGES.map(r => ({ ...r, href: pageUrl({ range: r.key }), active: !isCustom && r.key === activeRange.key }))
const switchUrl = pageUrl({})

const cfg = archiveConfig()
const hotWindowDays = cfg.hotWindowDays

let plan = 'free'
let series: Array<{ bucket: string, hot: number, archive: number, total: number }> = []
let releases: Array<{ release: string, levels: Record<string, number>, total: number }> = []
let summary = { partitions: 0, archivedRows: 0, archivedBytes: 0, prunedRows: 0, oldestDay: null as string | null, newestDay: null as string | null }
let live = false

// Levels in severity order, so a stacked bar always reads the same way and a
// colour always means the same thing.
//
// The colour itself is not named here. Segments carry `data-level`, which
// app-chrome.css maps onto `--sev` from the tokens in public/tokens.css, so this
// page uses the same palette as the stream's rails and chips and follows the
// theme without restating a single hex value. See the note above the
// `[data-level]` rules in public/app-chrome.css.
const LEVEL_ORDER = ['debug', 'info', 'notice', 'warning', 'error', 'critical', 'alert', 'emergency']

function dayOfUtc(d: Date): string {
  return d.toISOString().slice(0, 10)
}

async function loadData(): Promise<void> {
  if (!projectId)
    return

  const now = new Date()
  let fromDay: string
  let toDay: string
  if (isCustom) {
    fromDay = customFrom
    toDay = customTo
  }
  else {
    const from = new Date(now.getTime())
    from.setUTCDate(from.getUTCDate() - activeRange.days)
    fromDay = dayOfUtc(from)
    toDay = dayOfUtc(now)
  }

  plan = await projectPlan(projectId)
  series = await volumeSeries(projectId, { fromDay, toDay, unit: 'day' })
  releases = await levelsByRelease(projectId, { fromDay, toDay })
  summary = await archiveSummary(projectId)
  live = true
}

// Same 5s race as the dashboard, and the timer is cleared in `finally` for the
// same reason: the loser of a race is ignored, not cancelled, so leaving it
// armed holds a handle for the rest of the window on every successful render.
let __queryTimer: ReturnType<typeof setTimeout> | undefined
try {
  if (projectId) {
    await Promise.race([
      loadData(),
      new Promise((_resolve, reject) => {
        __queryTimer = setTimeout(() => reject(new Error('timeout')), 5000)
      }),
    ])
  }
}
catch {
  live = false
}
finally {
  if (__queryTimer)
    clearTimeout(__queryTimer)
}

// Chart geometry, computed server-side. The bars are plain divs rather than a
// charting library: this is a bar per day over at most 180 days, and a
// dependency that ships a canvas renderer to draw rectangles would cost more
// than it returns.
const maxTotal = series.reduce((m, p) => Math.max(m, p.total), 0)
const totalEntries = series.reduce((s, p) => s + p.total, 0)
const totalArchived = series.reduce((s, p) => s + p.archive, 0)

const bars = series.map(p => ({
  ...p,
  // Floor at 2% so a day with a single entry is still visible rather than
  // rounding away to nothing next to a day with fifty thousand.
  hotPct: maxTotal ? Math.max(p.hot ? 2 : 0, (p.hot / maxTotal) * 100) : 0,
  archivePct: maxTotal ? Math.max(p.archive ? 2 : 0, (p.archive / maxTotal) * 100) : 0,
  label: p.bucket,
}))

const releaseRows = releases.slice(0, 12).map(r => ({
  release: r.release,
  total: r.total,
  segments: LEVEL_ORDER
    .filter(l => (r.levels[l] ?? 0) > 0)
    .map(l => ({ level: l, n: r.levels[l], pct: (r.levels[l] / r.total) * 100 })),
}))

function formatBytes(n: number): string {
  if (!n)
    return '0 B'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  const i = Math.min(units.length - 1, Math.floor(Math.log(n) / Math.log(1024)))
  return `${(n / 1024 ** i).toFixed(i === 0 ? 0 : 1)} ${units[i]}`
}

const archivedBytesLabel = formatBytes(summary.archivedBytes)
</script>

<script client>
// Page chrome only. Everything on this page is server-rendered; these are the
// same three controls the dashboard carries, so the two pages behave alike.
const pro = state(false)

function toggleTheme(): void {
  useStore('theme').toggle()
}

function signOut(): void {
  useStore('session').signOut()
}

function switchProject(e: Event): void {
  // Declared reload, as in dashboard.stx: the server render is keyed off the
  // project cookie, so a fragment swap would repaint the previous project.
  useStore('session').project.set((e.target as HTMLSelectElement).value)
  navigate(switchUrl, { reload: true })
}

onMounted(() => {
  pro.set(!!useStore('session').pro())
  const requested = useSearchParams().get('project')
  if (requested)
    useStore('session').project.set(requested)
})
</script>

@extends('layouts/default')

@section('content')


{{-- Date-range picker styling. A loose <style> under a layout: stx sweeps it
    into the page (loghq's default layout has no @stack('styles')). Self-contained
    to the picker, themed on the app's tokens. --}}
<style>
.range-tool {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  min-height: 2.25rem;
  padding: 0 0.72rem;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--panel);
  color: var(--text-2);
  font: 600 0.8125rem/1 var(--sans, ui-sans-serif);
  text-decoration: none;
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
}
.range-tool:hover { color: var(--text); border-color: var(--accent); }
.range-tool:active { transform: scale(0.98); }
.range-tool:focus-visible,
.range-link:focus-visible,
.chrome-btn:focus-visible,
.icon-btn:focus-visible,
select.panel:focus-visible,
input:focus-visible,
textarea:focus-visible,
summary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
.range-tool.is-active { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
.range-tool i { width: 1rem; height: 1rem; }
.date-menu { position: relative; }
.date-menu > summary { list-style: none; }
.date-menu > summary::-webkit-details-marker { display: none; }
.date-popover {
  position: absolute;
  right: 0;
  top: calc(100% + 0.5rem);
  z-index: 40;
  width: min(44rem, calc(100vw - 2.5rem));
  padding: 0.75rem;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  box-shadow: 0 18px 50px color-mix(in srgb, var(--text) 10%, transparent);
}
/* Period picker: presets down the left, two months on the right. The range is
   drawn flat with rounded ends, the way Fathom's is, on the --bar wash the KPI
   bars already use so it reads as the same accent at the same strength. */
.drp-backdrop { position: fixed; inset: 0; z-index: 39; background: transparent; cursor: default; }
.drp { display: grid; grid-template-columns: 10.5rem minmax(0, 1fr); gap: 0.75rem; }
.drp-presets { display: flex; flex-direction: column; gap: 0.15rem; padding-right: 0.75rem; border-right: 1px solid var(--border); }
.drp-preset {
  display: block;
  width: 100%;
  padding: 0.5rem 0.7rem;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--text-2);
  font: 500 0.8125rem/1.2 var(--sans, ui-sans-serif);
  text-align: left;
  cursor: pointer;
}
.drp-preset:hover { color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); }
.drp-preset.is-active { color: var(--accent-ink); background: var(--accent); }
.drp-cals { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.drp-head { display: grid; grid-template-columns: 2rem minmax(0, 1fr) minmax(0, 1fr) 2rem; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem; }
.drp-nav {
  display: inline-grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
}
.drp-nav:hover { color: var(--text); border-color: var(--border); }
.drp-nav svg { width: 1rem; height: 1rem; }
.drp-nav.is-hidden { visibility: hidden; }
.drp-sel {
  min-width: 0;
  height: 2rem;
  padding: 0 0.5rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg);
  color: var(--text);
  font: 600 0.8125rem/1 var(--sans, ui-sans-serif);
}
.drp-dow, .drp-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.drp-dow span { padding: 0.25rem 0; color: var(--text-3); font: 600 0.7rem/1.2 var(--sans, ui-sans-serif); text-align: center; }
.drp-day {
  height: 2.25rem;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--text);
  font: 500 0.8125rem/1 var(--mono, ui-monospace);
  cursor: pointer;
}
.drp-day:hover { background: color-mix(in srgb, var(--accent) 22%, transparent); }
.drp-day.is-out { color: var(--text-3); }
.drp-day.is-today { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.drp-day.is-range { background: var(--accent-soft); }
.drp-day.is-edge { background: var(--accent); color: var(--accent-ink); border-radius: 8px; }
.drp-day.is-disabled { color: var(--text-3); opacity: 0.45; cursor: default; }
.drp-day.is-disabled:hover { background: transparent; }
.drp-day:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 8px; }
@media (max-width: 1023px) {
  .date-menu { position: static; }
  .date-popover { left: 0; right: auto; width: calc(100vw - 2rem); max-height: calc(100dvh - 6rem); overflow-y: auto; overscroll-behavior: contain; }
  .drp { grid-template-columns: minmax(0, 1fr); }
  .drp-presets { flex-direction: row; flex-wrap: wrap; gap: 0.35rem; padding: 0 0 0.6rem; border-right: 0; border-bottom: 1px solid var(--border); }
  .drp-preset { width: auto; padding: 0.45rem 0.65rem; border: 1px solid var(--border); border-radius: 999px; }
  .drp-cals { grid-template-columns: minmax(0, 1fr); }
  .drp-cal.is-right { display: none; }
  .drp-cal.is-left .drp-nav.is-hidden { visibility: visible; }
  .drp-day { height: 2.5rem; }
}
</style>
<div class="grain" aria-hidden="true"></div>

<div class="px-5 py-10 md:px-10 min-h-[100dvh] page-dashboard">
  <StxLink class="chrome-upgrade" to="/pricing" :show="!pro()">Upgrade</StxLink>
  <span class="chrome-pro chrome-upgrade" :show="pro()">Pro</span>
  <button class="chrome-logout" @click="signOut">Log out</button>

  <div class="mx-auto max-w-5xl">

    @if (!user)
      <div id="auth-pending" class="py-24 text-center text-sm text-subtle">Loading…</div>
    @endif

    @if (user && projectsUnavailable)
      <div class="py-24 text-center">
        <p class="text-muted text-sm"><span class="font-semibold text-ink">Can't reach your projects right now.</span></p>
        <p class="mt-2 text-subtle text-xs">Nothing has been lost, reload once the database is back.</p>
      </div>
    @endif

    @if (user && !projectsUnavailable && !projectId)
      <div class="py-24 text-center">
        <p class="text-muted text-sm">No projects yet.</p>
        <p class="mt-2 text-subtle text-xs"><StxLink to="/projects/new" class="text-accent">Create one</StxLink> and its analytics appear here.</p>
      </div>
    @endif

    @if (user && projectId)
    <header class="flex flex-wrap gap-5 items-end justify-between mb-8">
      <div class="flex flex-wrap gap-3 items-center">
        <StxLink to="/projects" class="wordmark-link"><h1 class="font-sans leading-none text-2xl md:text-[28px] wordmark">loghq</h1></StxLink>
        @if (projects.length > 1)
          <select @change="switchProject" aria-label="Switch project" class="px-3 py-1.5 font-mono text-muted text-sm app-panel tnum">
            @foreach (projects as p)
              <option value="{{ p.id }}" {{ p.id === projectId ? 'selected' : '' }}>{{ p.name }}</option>
            @endforeach
          </select>
        @else
          <span class="font-mono text-muted text-sm tnum">{{ activeProject?.name }}</span>
        @endif
        <StxLink to="/dashboard" class="px-3 py-1.5 font-medium text-muted text-sm border border-line pill">Stream</StxLink>
        <button class="icon-btn theme-btn" @click="toggleTheme" x-tooltip="Toggle theme" aria-label="Toggle theme">
          <Icon name="lucide:sun" size="17" class="h-[17px] w-[17px] ic-sun" />
          <Icon name="lucide:moon" size="17" class="h-[17px] w-[17px] ic-moon" />
        </button>
        <span class="inline-flex" x-tooltip="Settings">
          <StxLink to="/settings" class="icon-btn" aria-label="Settings">
            <Icon name="lucide:settings" size="17" class="h-[17px] w-[17px]" />
          </StxLink>
        </span>
      </div>
      <nav class="flex flex-wrap gap-1.5 items-center">
        <DateRangePicker :summary="rangeLabel" :active="isCustom" />
        @foreach (rangeTabs as r)
          <StxLink to="{{ r.href }}" class="px-3 py-1.5 font-medium text-sm border pill {{ r.active ? 'text-ink border-line bg-[color-mix(in_srgb,var(--accent)_10%,transparent)]' : 'text-subtle border-transparent' }}">{{ r.label }}</StxLink>
        @endforeach
      </nav>
    </header>

    @if (!live)
      <div class="mb-6 px-5 py-3.5 text-muted text-sm app-panel">
        Analytics are unavailable right now. Reload once the database is back.
      </div>
    @endif

    {{-- Headline numbers. Archived is called out separately from the total
        because the difference between them is the whole point of the tier:
        entries that are still searchable but no longer in the hot database. --}}
    <section class="grid gap-4 grid-cols-2 md:grid-cols-4 mb-8">
      <div class="px-5 py-4 app-panel">
        <div class="mb-1 text-subtle text-xs tracking-wide uppercase">Entries</div>
        <div class="font-mono text-2xl tnum">{{ totalEntries.toLocaleString() }}</div>
        <div class="mt-1 text-subtle text-xs">last {{ activeRange.label }}</div>
      </div>
      <div class="px-5 py-4 app-panel">
        <div class="mb-1 text-subtle text-xs tracking-wide uppercase">From archive</div>
        <div class="font-mono text-2xl tnum">{{ totalArchived.toLocaleString() }}</div>
        <div class="mt-1 text-subtle text-xs">older than {{ hotWindowDays }} days</div>
      </div>
      <div class="px-5 py-4 app-panel">
        <div class="mb-1 text-subtle text-xs tracking-wide uppercase">Archived total</div>
        <div class="font-mono text-2xl tnum">{{ summary.archivedRows.toLocaleString() }}</div>
        <div class="mt-1 text-subtle text-xs">{{ summary.partitions }} {{ summary.partitions === 1 ? 'day' : 'days' }}, {{ archivedBytesLabel }}</div>
      </div>
      <div class="px-5 py-4 app-panel">
        <div class="mb-1 text-subtle text-xs tracking-wide uppercase">Plan</div>
        <div class="font-mono text-2xl tnum">{{ plan === 'pro' ? 'Pro' : 'Free' }}</div>
        <div class="mt-1 text-subtle text-xs">{{ plan === 'pro' ? 'full retention' : `${hotWindowDays} day window` }}</div>
      </div>
    </section>

    {{-- Volume over time. Hot and archived are stacked rather than summed so the
        boundary of the hot window is visible: without it, a project whose older
        days have moved to Parquet looks like a project that stopped logging. --}}
    <section class="mb-8 app-panel">
      <div class="flex flex-wrap gap-3 items-center justify-between px-5 py-3.5 border-b border-line">
        <h2 class="font-semibold text-sm">Volume</h2>
        <div class="flex gap-4 items-center text-subtle text-xs">
          <span class="flex gap-1.5 items-center"><span class="h-2.5 w-2.5 bg-accent rounded-sm"></span> Hot</span>
          <span class="flex gap-1.5 items-center"><span class="h-2.5 w-2.5 bg-[color-mix(in_srgb,var(--accent)_35%,transparent)] rounded-sm"></span> Archived</span>
        </div>
      </div>

      @if (bars.length)
        <div class="px-5 py-5">
          <div class="flex gap-[2px] items-end h-40">
            @foreach (bars as b)
              <div class="flex relative flex-1 flex-col justify-end h-full min-w-[2px] group" x-tooltip="{{ b.label }}: {{ b.total.toLocaleString() }} entries{{ b.archive ? ` (${b.archive.toLocaleString()} archived)` : '' }}">
                @if (b.archivePct > 0)
                  <div class="w-full bg-[color-mix(in_srgb,var(--accent)_35%,transparent)] rounded-t-sm" style="height: {{ b.archivePct }}%"></div>
                @endif
                @if (b.hotPct > 0)
                  <div class="w-full bg-accent {{ b.archivePct > 0 ? '' : 'rounded-t-sm' }}" style="height: {{ b.hotPct }}%"></div>
                @endif
              </div>
            @endforeach
          </div>
          <div class="flex justify-between mt-2.5 font-mono text-subtle text-xs tnum">
            <span>{{ bars[0].label }}</span>
            <span>{{ bars[bars.length - 1].label }}</span>
          </div>
        </div>
      @else
        <div class="px-5 py-16 text-center">
          <div class="mb-1 font-medium text-base">No entries in the last {{ activeRange.label }}</div>
          <div class="text-sm text-subtle">Point an SDK at this project and its volume shows up here.</div>
        </div>
      @endif
    </section>

    {{-- Level mix per release. The question this answers is "did this release
        change the shape of what we log", which a total count cannot. --}}
    <section class="mb-8 app-panel">
      <div class="px-5 py-3.5 border-b border-line">
        <h2 class="font-semibold text-sm">Levels by release</h2>
      </div>

      @if (releaseRows.length)
        <div class="px-5 py-4">
          @foreach (releaseRows as r)
            <div class="mb-4 last:mb-0">
              <div class="flex items-baseline justify-between mb-1.5">
                <span class="font-mono text-sm tnum">{{ r.release }}</span>
                <span class="font-mono text-subtle text-xs tnum">{{ r.total.toLocaleString() }}</span>
              </div>
              <div class="flex overflow-hidden h-2.5 rounded-full">
                @foreach (r.segments as s)
                  <div class="level-seg" data-level="{{ s.level }}" style="width: {{ s.pct }}%" x-tooltip="{{ s.level }}: {{ s.n.toLocaleString() }}"></div>
                @endforeach
              </div>
            </div>
          @endforeach
        </div>
      @else
        <div class="px-5 py-16 text-center">
          <div class="mb-1 font-medium text-base">Nothing to compare yet</div>
          <div class="text-sm text-subtle">Send a `release` with your entries and each one gets its own row here.</div>
        </div>
      @endif
    </section>

    {{-- What the archive holds, day by day. Read from the ledger rather than by
        scanning Parquet: the counts were recorded when each day was verified. --}}
    @if (summary.partitions > 0)
      <section class="mb-8 app-panel">
        <div class="flex flex-wrap gap-3 items-center justify-between px-5 py-3.5 border-b border-line">
          <h2 class="font-semibold text-sm">Archive</h2>
          <span class="font-mono text-subtle text-xs tnum">
            {{ summary.oldestDay ?? '' }}{{ summary.oldestDay && summary.newestDay ? ' to ' : '' }}{{ summary.newestDay ?? '' }}
          </span>
        </div>
        <div class="grid gap-y-1.5 grid-cols-2 sm:grid-cols-4 px-5 py-4 text-xs">
          <div>
            <div class="text-subtle">Days</div>
            <div class="font-mono tnum">{{ summary.partitions.toLocaleString() }}</div>
          </div>
          <div>
            <div class="text-subtle">Entries</div>
            <div class="font-mono tnum">{{ summary.archivedRows.toLocaleString() }}</div>
          </div>
          <div>
            <div class="text-subtle">Stored</div>
            <div class="font-mono tnum">{{ archivedBytesLabel }}</div>
          </div>
          <div>
            <div class="text-subtle">Aged out</div>
            <div class="font-mono tnum">{{ summary.prunedRows.toLocaleString() }}</div>
          </div>
        </div>
        <div class="pb-4 px-5 text-subtle text-xs">
          <StxLink to="/dashboard?range=archive" class="text-accent">Search archived entries</StxLink>
          <span class="mx-1.5">·</span>
          <StxLink to="/settings#retention" class="text-accent">Retention settings</StxLink>
        </div>
      </section>
    @endif

    @endif
  </div>
</div>
@endsection
