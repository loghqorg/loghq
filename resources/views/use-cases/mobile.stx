@extends('layouts/marketing')

<script server>
useSeoMeta({
  title: 'Mobile crash reporting - loghq',
  description: 'Group native crashes and JavaScript errors by build and release, so you see which version regressed and how many devices it reached.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/use-cases/mobile' }] })

// Breadcrumb trail. One array drives two consumers — the rendered list in
// the Breadcrumbs partial and the BreadcrumbList JSON-LD below — so the
// markup and the structured data cannot disagree. The last crumb has no
// href or url: it is this page.
const crumbs = [
  { label: 'Home', href: '/', url: 'https://loghq.org/' },
  { label: 'Use cases', href: '/use-cases', url: 'https://loghq.org/use-cases' },
  { label: 'Mobile' },
]
</script>

@section('content')
@structuredData({
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.url })),
})

@include('Breadcrumbs')

<section class="feat-hero shell">
  <span class="kicker">Mobile</span>
  <h1>Know which build crashed, before the review does.</h1>
  <p>A mobile release reaches thousands of devices at once and you cannot attach a debugger to any of them. loghq collects the crash, groups it by build and release, and tells you how many users a version affected.</p>
  <div class="hero-actions">
    <StxLink class="btn primary" to="/register">Get started</StxLink>
    <StxLink class="btn ghost" to="/features/releases">Releases</StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Crashes by release">
  <div class="max-w-[640px] panel">
    <div class="panel-head"><span class="chart-cap">Crash-free sessions, by release</span><span class="panel-tag">Sample data</span></div>
    <div class="bar-row">
      <span class="bar-label">4.3.0</span>
      <span class="bar-track"><span class="w-[27%] bar-fill"></span></span>
      <span class="bar-value">96.4%</span>
    </div>
    <div class="bar-row">
      <span class="bar-label">4.2.1</span>
      <span class="bar-track"><span class="w-[96%] bar-fill"></span></span>
      <span class="bar-value">99.7%</span>
    </div>
    <div class="bar-row">
      <span class="bar-label">4.2.0</span>
      <span class="bar-track"><span class="w-[90%] bar-fill"></span></span>
      <span class="bar-value">99.3%</span>
    </div>
    <div class="bar-row">
      <span class="bar-label">4.1.4</span>
      <span class="bar-track"><span class="w-[93%] bar-fill"></span></span>
      <span class="bar-value">99.5%</span>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="how-heading">
  <div class="section-head">
    <h2 id="how-heading" class="section-title">How mobile teams use it</h2>
  </div>
  <div class="flow">
    <div class="flow-step">
      <span class="flow-num">01</span>
      <div>
        <h3>Tag the build on release</h3>
        <p>Set the release and build number in the init call. Every crash and handled error carries the exact version that produced it.</p>
      </div>
    </div>
    <div class="flow-step">
      <span class="flow-num">02</span>
      <div>
        <h3>Crashes group by signature</h3>
        <p>Native and JavaScript-layer errors fold into one issue per fault, with an affected-user count instead of a raw event stream.</p>
      </div>
    </div>
    <div class="flow-step">
      <span class="flow-num">03</span>
      <div>
        <h3>Catch a bad release early</h3>
        <p>A crash-free-sessions drop on a new build surfaces immediately, so you can halt a staged rollout before it reaches everyone.</p>
      </div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-label="What you get">
  <div class="metrics">
    <div class="metric">
      <div class="m-value">Per build</div>
      <div class="m-label">Crashes and crash-free rates are broken down by release and build number.</div>
    </div>
    <div class="metric">
      <div class="m-value">User count</div>
      <div class="m-label">Each issue shows how many devices and users it reached, not just events.</div>
    </div>
    <div class="metric">
      <div class="m-value">One issue</div>
      <div class="m-label">Native and JS-layer faults for the same bug fold into a single thread.</div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="related-heading">
  <div class="section-head">
    <h2 id="related-heading" class="section-title">Features that do the work</h2>
  </div>
  <div class="related">
    <StxLink to="/features/releases">
      <div class="r-name">Releases and environments</div>
      <div class="r-desc">Break crashes down by build and staged rollout.</div>
    </StxLink>
    <StxLink to="/features/grouping">
      <div class="r-name">Fingerprint grouping</div>
      <div class="r-desc">One issue per crash, with an affected-user tally.</div>
    </StxLink>
    <StxLink to="/features/alerts">
      <div class="r-name">Alerts and triage</div>
      <div class="r-desc">Get told the moment crash-free sessions drop.</div>
    </StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Get started">
  <div class="cta-band">
    <h2>Ship the app with a net under you.</h2>
    <div class="cta-actions">
      <StxLink class="btn primary" to="/register">Get started</StxLink>
      <StxLink class="btn ghost" to="/docs">Read the docs</StxLink>
    </div>
  </div>
</section>
@endsection
