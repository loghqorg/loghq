@extends('layouts/marketing')

<script server>
useSeoMeta({
  title: 'Backend error tracking - loghq',
  description: 'Capture server, edge, and background-job failures with the request, release, and environment attached, so every 500 names the route and deploy that broke it.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/use-cases/backend' }] })

// Breadcrumb trail. One array drives two consumers — the rendered list in
// the Breadcrumbs partial and the BreadcrumbList JSON-LD below — so the
// markup and the structured data cannot disagree. The last crumb has no
// href or url: it is this page.
const crumbs = [
  { label: 'Home', href: '/', url: 'https://loghq.org/' },
  { label: 'Use cases', href: '/use-cases', url: 'https://loghq.org/use-cases' },
  { label: 'Backend' },
]
</script>

@section('content')
@structuredData({
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.url })),
})

@include('Breadcrumbs')

<section class="feat-hero shell">
  <span class="kicker">Backend</span>
  <h1>Every 500 arrives with the request that caused it.</h1>
  <p>A stack trace on its own is half the story. loghq attaches the route, method, release, and environment to each server error, so triage starts with the facts instead of grepping a log for the surrounding lines.</p>
  <div class="hero-actions">
    <a class="btn primary" href="/register">Get started</a>
    <a class="btn ghost" href="/features/capture">Automatic capture</a>
  </div>
</section>

<section class="reveal section shell" aria-label="Backend capture preview">
  <div class="code" style="max-width: 700px">
    <div class="code-bar"><span class="chart-cap">app/server.ts</span></div>
    <pre class="code-body"><code>async function loghq(message, level = 'info', context) {
  try {
    await fetch('https://loghq.org/logs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-LogHQ-Key': KEY },
      body: JSON.stringify({ logs: [{ message, level, context,
        release: 'api@2.14.0', environment: 'production' }] }),
    })
  }
  catch {}
}

// requests, workers, and cron jobs — same endpoint, one channel each
process.on('uncaughtException', e => loghq(e.message, 'critical', { stack: e.stack }))
process.on('unhandledRejection', r => loghq(String(r), 'error'))</code></pre>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="scenarios-heading">
  <div class="section-head">
    <h2 id="scenarios-heading" class="section-title">Where it earns its keep</h2>
  </div>
  <div class="chips">
    <div class="chip">
      <h3>Request handlers</h3>
      <p>An unhandled exception in a route reports with the method, path, status, and the release serving that request.</p>
    </div>
    <div class="chip">
      <h3>Background jobs and queues</h3>
      <p>A worker that throws mid-batch is captured with the job name and payload shape, not lost to a detached process.</p>
    </div>
    <div class="chip">
      <h3>Edge and serverless</h3>
      <p>Short-lived functions flush their errors before the runtime tears down, so nothing is dropped on cold exit.</p>
    </div>
    <div class="chip">
      <h3>Scheduled tasks</h3>
      <p>A cron that fails at 3am is grouped and counted like any other issue, ready in the morning with its own history.</p>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-label="What you get">
  <div class="metrics">
    <div class="metric">
      <div class="m-value">Full request</div>
      <div class="m-label">Route, method, status, and metadata attach to every server error.</div>
    </div>
    <div class="metric">
      <div class="m-value">One SDK</div>
      <div class="m-label">Requests, workers, and cron jobs report through the same init call.</div>
    </div>
    <div class="metric">
      <div class="m-value">By deploy</div>
      <div class="m-label">Each event is tagged with its release, so a regression names its own build.</div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="related-heading">
  <div class="section-head">
    <h2 id="related-heading" class="section-title">Features that do the work</h2>
  </div>
  <div class="related">
    <a href="/features/capture">
      <div class="r-name">Automatic capture</div>
      <div class="r-desc">Global handlers across requests, jobs, and cron.</div>
    </a>
    <a href="/features/releases">
      <div class="r-name">Releases and environments</div>
      <div class="r-desc">Split staging noise from a real production regression.</div>
    </a>
    <a href="/features/alerts">
      <div class="r-name">Alerts and triage</div>
      <div class="r-desc">Get paged for a new or spiking backend issue.</div>
    </a>
  </div>
</section>

<section class="reveal section shell" aria-label="Get started">
  <div class="cta-band">
    <h2>Ship the backend with a net under you.</h2>
    <div class="cta-actions">
      <a class="btn primary" href="/register">Get started</a>
      <a class="btn ghost" href="/docs">Read the docs</a>
    </div>
  </div>
</section>
@endsection
