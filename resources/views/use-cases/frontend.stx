@extends('layouts/marketing')

<script server>
useSeoMeta({
  title: 'Frontend error tracking - loghq',
  description: 'Catch the JavaScript errors your users actually hit in the browser, with source-mapped stack traces, release tagging, and one issue per bug.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/use-cases/frontend' }] })

// Breadcrumb trail. One array drives two consumers — the rendered list in
// the Breadcrumbs partial and the BreadcrumbList JSON-LD below — so the
// markup and the structured data cannot disagree. The last crumb has no
// href or url: it is this page.
const crumbs = [
  { label: 'Home', href: '/', url: 'https://loghq.org/' },
  { label: 'Use cases', href: '/use-cases', url: 'https://loghq.org/use-cases' },
  { label: 'Frontend' },
]
</script>

@section('content')
@structuredData({
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.url })),
})

@include('Breadcrumbs')

<section class="feat-hero shell">
  <span class="kicker">Frontend</span>
  <h1>See the errors your users hit, in your own source.</h1>
  <p>Browser code fails on devices you will never touch, in a minified bundle you cannot read. loghq captures the throw, resolves it back to your original file with a source map, and folds every occurrence into one issue.</p>
  <div class="hero-actions">
    <StxLink class="btn primary" to="/register">Get started</StxLink>
    <StxLink class="btn ghost" to="/features/stack-traces">Stack traces</StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Frontend capture preview">
  <div class="max-w-[700px] code">
    <div class="code-bar"><span class="chart-cap">src/main.ts</span></div>
    <pre class="code-body"><code>async function loghq(message, level = 'info', context) {
  try {
    await fetch('https://loghq.org/logs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-LogHQ-Key': KEY },
      body: JSON.stringify({ logs: [{ message, level, context,
        release: 'web@2.14.0', environment: 'production' }] }),
    })
  }
  catch {}
}

// window.onerror and unhandled rejections, in two lines
addEventListener('error', e => loghq(e.message, 'error', { stack: e.error?.stack }))
addEventListener('unhandledrejection', e => loghq(String(e.reason), 'error'))</code></pre>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="how-heading">
  <div class="section-head">
    <h2 id="how-heading" class="section-title">How frontend teams use it</h2>
  </div>
  <div class="flow">
    <div class="flow-step">
      <span class="flow-num">01</span>
      <div>
        <h3>Ship the source map with the build</h3>
        <p>Your bundler already emits a source map. Upload it on deploy and every frame in every trace points back to the real file, function, and line.</p>
      </div>
    </div>
    <div class="flow-step">
      <span class="flow-num">02</span>
      <div>
        <h3>Errors group across browsers and devices</h3>
        <p>The same TypeError from Chrome, Safari, and an in-app webview folds into one issue with a device and browser breakdown, not six near-duplicates.</p>
      </div>
    </div>
    <div class="flow-step">
      <span class="flow-num">03</span>
      <div>
        <h3>A regression names its release</h3>
        <p>Each event carries the release it came from, so a spike after a deploy points straight at the build that introduced it.</p>
      </div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-label="What you get">
  <div class="metrics">
    <div class="metric">
      <div class="m-value">Your source</div>
      <div class="m-label">Source maps turn minified frames back into the code you wrote.</div>
    </div>
    <div class="metric">
      <div class="m-value">SPA-aware</div>
      <div class="m-label">History navigations, async rejections, and event handlers are all captured.</div>
    </div>
    <div class="metric">
      <div class="m-value">Per device</div>
      <div class="m-label">Every issue breaks down by browser, OS, and release automatically.</div>
    </div>
  </div>
</section>

<section class="reveal section shell" aria-labelledby="related-heading">
  <div class="section-head">
    <h2 id="related-heading" class="section-title">Features that do the work</h2>
  </div>
  <div class="related">
    <StxLink to="/features/stack-traces">
      <div class="r-name">Readable stack traces</div>
      <div class="r-desc">Turn minified browser frames back into your source.</div>
    </StxLink>
    <StxLink to="/features/grouping">
      <div class="r-name">Fingerprint grouping</div>
      <div class="r-desc">One issue per bug, across every browser and device.</div>
    </StxLink>
    <StxLink to="/features/releases">
      <div class="r-name">Releases and environments</div>
      <div class="r-desc">Tie a browser spike to the build that caused it.</div>
    </StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Get started">
  <div class="cta-band">
    <h2>Ship the frontend with a net under you.</h2>
    <div class="cta-actions">
      <StxLink class="btn primary" to="/register">Get started</StxLink>
      <StxLink class="btn ghost" to="/docs">Read the docs</StxLink>
    </div>
  </div>
</section>
@endsection
