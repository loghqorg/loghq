      <div class="hero-actions">
        <a class="btn primary" :href="isAuthed() ? '/dashboard' : '/register'">{{ isAuthed() ? 'Go to dashboard' : 'Get started' }}</a>
        <a class="btn ghost" href="https://github.com/stacksjs/loghq">View source</a>
      </div>
    </div>

    <div class="hero-code reveal [animation-delay:0.08s]">
