@extends('layouts/marketing')

<script server>
// The real SDK snippet doubles as the hero visual. Legitimate product content,
// not a div-based fake screenshot.
const snippet = `// config/logging.php
'channels' => [
  'loghq' => ['driver' => 'loghq'],
  'stack' => ['channels' => ['single', 'loghq']],
]

// then log as you already do
Log::info('order placed', ['order_id' => 42])
Log::warning('inventory low', ['sku' => 'ABC-1'])

// every line streams to loghq: searchable, filterable, live`

const featureCells = [
  { slug: 'capture', cls: 'cell feature', title: 'Every level, captured', body: 'One log channel ships debug through emergency: all eight severities, with their structured context.' },
  { slug: 'grouping', cls: 'cell', title: 'Filter by severity', body: 'Threshold the stream to warnings-and-up, errors-and-up, or a single level. Signal without the noise.' },
  { slug: 'releases', cls: 'cell tint', title: 'Releases and environments', body: 'Every line is tagged with its environment and release, so you can scope the stream to one deploy.' },
  { slug: 'stack-traces', cls: 'cell', title: 'Structured context', body: 'Expand any line to see its full JSON context (ids, timings, payloads), pretty-printed, not flattened.' },
  { slug: 'alerts', cls: 'cell tint', title: 'Search everything', body: 'Full-text search across every message, scoped by level and time window. Find the one line that matters.' },
  { slug: 'self-host', cls: 'cell', title: 'Self-hosting', body: 'Open source, on your own Postgres. Sensitive log data never leaves your servers.' },
]

// No hand-carried ordinal. The loop already knows which iteration it is on, and
// a `num` field in the data is a second source of truth that silently goes
// wrong the moment a step is inserted or reordered.
const steps = [
  { verb: 'Install', body: 'Add the loghq log channel to your app. One line in your logging config wires up the stream.' },
  { verb: 'Log', body: 'Keep logging exactly as you do today. Every Log call is shipped to loghq in the background.' },
  { verb: 'Stream', body: 'Watch lines land live, filter by level and time, search messages, and inspect structured context.' },
]

useSeoMeta({
  title: 'loghq - Logs for people who ship',
  description: 'Logs for people who ship. Stream, search, and filter your application logs in a fast, live UI instead of tailing a file. Built on Stacks and Postgres.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/' }] })
</script>

<script client>
// Auth-aware CTAs. Same signal as SiteNav/SiteFooter, declared here because a
// partial's client scope does not reach the including page's markup. Replaces an
// imperative DOM-rewriting block that also reached into the nav and footer —
// those now reflect auth state themselves, on every page rather than only this
// one.
const isAuthed = state(false)
// The store owns the token; this mirrors its derived isAuthed so the markup
// stays a binding. Read inside onMount because useStore is NOT in the
// usesSignals trigger list — a client script whose only stx call is useStore()
// gets the immediate IIFE form instead of the mount wrapper and runs before the
// store bundle registers. onMount is a trigger, so this guarantees the wrapper.
onMount(() => {
  const session = useStore('session')
  effect(() => isAuthed.set(session.isAuthed()))
})

// Launch-updates capture. The form posts on its own with scripting off (it
// carries action and method); this upgrades it to an inline reply so the
// visitor is not dropped on a JSON body.
const email = state('')
const sending = state(false)
const status = state('')
const failed = state(false)

async function subscribe() {
  if (sending())
    return

  sending.set(true)
  status.set('')
  failed.set(false)

  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email(), source: 'marketing-home' }),
    })
    const data = await res.json()
    status.set(data.message ?? 'You are on the list.')
    email.set('')
  }
  catch {
    // The address is not lost to the visitor: the field keeps its value, so a
    // retry is one click and not a retype.
    failed.set(true)
    status.set('That did not send. Check your connection and try again.')
  }
  finally {
    sending.set(false)
  }
}
</script>


@section('content')
<div class="shell">
  <section class="hero">
    <div class="reveal">
      <h1 class="hero-title">Your logs, finally worth reading.</h1>
      <p class="hero-sub">Stream every log line from your app into a fast, searchable UI. Filter by level, search messages, and inspect structured context instead of tailing a file.</p>
      <div class="hero-actions">
        {{-- Label and href carry their logged-OUT state statically: that is the
             SSR truth, it is what a crawler and a first-time visitor see, and it
             works with no JavaScript. The bindings upgrade it for a signed-in
             visitor after hydration. As `{{ }}` in the body this button was
             cloaked — display:none until the runtime booted. --}}
        <a class="btn primary" href="/register" :href="isAuthed() ? '/dashboard' : '/register'" :text="isAuthed() ? 'Go to dashboard' : 'Get started'">Get started</a>
        <a class="btn ghost" href="https://github.com/stacksjs/loghq">View source</a>
      </div>
    </div>

    <div class="overflow-hidden border border-line rounded-[var(--r)] bg-[var(--code-bg)] hero-code reveal [animation-delay:0.08s]">
      {{-- marketing.css also defines .code-bar, with a wider gap and less
           vertical padding. This element used to beat it with a
           `.hero-code .code-bar` descendant rule; the utilities beat it on
           source order instead, the Crosswind sheet being emitted after
           /marketing.css. --}}
      <div class="flex gap-[0.55rem] items-center px-4 py-[0.8rem] [border-bottom:1px_solid_rgba(148,163,184,0.14)] code-bar">
        <span class="h-[9px] w-[9px] rounded-[999px] bg-accent" aria-hidden="true"></span>
        <span class="chart-cap">config/logging.php</span>
      </div>
      <pre class="code-body"><code>{{ snippet }}</code></pre>
    </div>
  </section>

  <section id="features" class="reveal section" aria-labelledby="features-heading">
    <div class="section-head">
      <h2 id="features-heading" class="section-title">From scattered log files to one live stream.</h2>
    </div>
    <div class="bento">
      @foreach (featureCells as cell)
        <StxLink class="{{ cell.cls }}" to="/features/{{ cell.slug }}">
          <h3>{{ cell.title }}</h3>
          <p>{{ cell.body }}</p>
          <span class="cell-more">View feature</span>
        </StxLink>
      @endforeach
    </div>
  </section>

  <section class="reveal section" aria-labelledby="how-heading">
    <div class="section-head">
      <h2 id="how-heading" class="section-title">Live in three steps.</h2>
    </div>
    <div class="flow">
      @foreach (steps as step)
        <div class="flow-step">
          <span class="flow-num">{{ String(loop.iteration).padStart(2, '0') }}</span>
          <div>
            <h3>{{ step.verb }}</h3>
            <p>{{ step.body }}</p>
          </div>
        </div>
      @endforeach
    </div>
  </section>

  <section class="reveal section" aria-label="Open source and self-hosting">
    <div class="flex flex-wrap gap-5 items-center justify-between px-8 py-7 border border-line rounded-[var(--r)] bg-[var(--surface)]">
      <p class="m-0 max-w-[52ch] text-muted text-[1rem] leading-[1.55]"><strong class="text-ink font-semibold">Open source, and yours to run.</strong> Host loghq on your own Postgres so sensitive log data never leaves your infrastructure, or start on the hosted tier in a minute.</p>
      <StxLink class="btn ghost" to="/features/self-host">Read about self-hosting</StxLink>
    </div>
  </section>

  <section class="reveal section" aria-label="Get started">
    <div class="cta-band">
      <h2>Stop tailing log files.</h2>
      <div class="cta-actions">
        {{-- Label and href carry their logged-OUT state statically: that is the
             SSR truth, it is what a crawler and a first-time visitor see, and it
             works with no JavaScript. The bindings upgrade it for a signed-in
             visitor after hydration. As `{{ }}` in the body this button was
             cloaked, display:none until the runtime booted. --}}
        <a class="btn primary" href="/register" :href="isAuthed() ? '/dashboard' : '/register'" :text="isAuthed() ? 'Go to dashboard' : 'Get started'">Get started</a>
        <StxLink class="btn ghost" to="/use-cases">See use cases</StxLink>
      </div>
    </div>
  </section>

  {{-- Launch updates. A separate intent from the buttons above: the band asks
       you to start now, this asks nothing of you but an address. Hidden from a
       signed-in visitor, who has already done more than subscribe. --}}
  <section class="reveal section" aria-labelledby="updates-heading" :hidden="isAuthed()">
    <div class="cta-band">
      <h2 id="updates-heading">Not ready to sign up?</h2>
      <p class="sub-note">Leave an address and we will send a note when loghq is ready. No newsletter, no drip sequence.</p>
      <form class="sub-form" action="/api/subscribe" method="POST" @submit.prevent="subscribe()">
        <label class="sr-only" for="subscribe-email">Email address</label>
        <input
          id="subscribe-email"
          class="sub-field"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@company.com"
          required
          x-model="email"
        >
        <button class="btn primary" type="submit" :disabled="sending()" :text="sending() ? 'Sending' : 'Keep me posted'">Keep me posted</button>
      </form>
      <p class="sub-status" role="status" aria-live="polite" :data-state="failed() ? 'error' : ''" :text="status()"></p>
    </div>
  </section>
</div>
@endsection
