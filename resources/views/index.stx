          <p>{{ cell.body }}</p>
          <span class="cell-more">View feature</span>
        </StxLink>
      @endforeach
    </div>
  </section>

  <section class="reveal section" aria-labelledby="how-heading">
    <div class="section-head">
      <h2 id="how-heading" class="section-title">Live in three steps.</h2>
    </div>
    <div class="flow">
      @foreach (steps as step)
        <div class="flow-step">
          <span class="flow-num">{{ step.num }}</span>
          <div>
            <h3>{{ step.verb }}</h3>
            <p>{{ step.body }}</p>
          </div>
        </div>
      @endforeach
    </div>
  </section>

  <section class="reveal section" aria-label="Open source and self-hosting">
    <div class="open-band">
      <p><strong>Open source, and yours to run.</strong> Host loghq on your own Postgres so sensitive log data never leaves your infrastructure, or start on the hosted tier in a minute.</p>
      <StxLink class="btn ghost" to="/features/self-host">Read about self-hosting</StxLink>
    </div>
  </section>

  <section class="reveal section" aria-label="Get started">
    <div class="cta-band">
      <h2>Stop tailing log files.</h2>
      <div class="cta-actions">
        <a class="btn primary" :href="isAuthed() ? '/dashboard' : '/register'">{{ isAuthed() ? 'Go to dashboard' : 'Get started' }}</a>
        <StxLink class="btn ghost" to="/use-cases">See use cases</StxLink>
      </div>
