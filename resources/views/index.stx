  <body>
    @include('SiteNav')

    <main class="shell">

      <section class="hero">
        <div class="reveal">
          <h1 class="hero-title">Your logs, finally worth reading.</h1>
          <p class="hero-sub">Stream every log line from your app into a fast, searchable UI. Filter by level, search messages, inspect structured context — instead of tailing a file.</p>
          <div class="hero-actions">
            <a class="btn primary" data-auth-cta href="/register">Get started</a>
            <a class="btn ghost" href="https://github.com/stacksjs/loghq">View source</a>
          </div>
        </div>

        <div class="hero-code reveal" style="animation-delay: 0.08s">
          <div class="code-bar">
            <span class="dot" aria-hidden="true"></span>
            <span class="chart-cap">config/logging.php</span>
          </div>
          <pre class="code-body"><code>{{ snippet }}</code></pre>
        </div>
      </section>

      <section id="features" class="section reveal" aria-labelledby="features-heading">
        <div class="section-head">
          <h2 id="features-heading" class="section-title">From scattered log files to one live stream.</h2>
        </div>
        <div class="bento">
          @foreach (featureCells as cell)
            <a class="{{ cell.cls }}" href="/features/{{ cell.slug }}">
              <h3>{{ cell.title }}</h3>
              <p>{{ cell.body }}</p>
              <span class="cell-more">View feature</span>
            </a>
          @endforeach
        </div>
      </section>

      <section class="section reveal" aria-labelledby="how-heading">
        <div class="section-head">
          <h2 id="how-heading" class="section-title">Live in three steps.</h2>
        </div>
        <div class="flow">
          @foreach (steps as step)
            <div class="flow-step">
              <span class="flow-num">{{ step.num }}</span>
              <div>
                <h3>{{ step.verb }}</h3>
                <p>{{ step.body }}</p>
              </div>
            </div>
          @endforeach
        </div>
      </section>

      <section class="section reveal" aria-label="Open source and self-hosting">
        <div class="open-band">
          <p><strong>Open source, and yours to run.</strong> Host loghq on your own Postgres so sensitive stack data never leaves your infrastructure, or start on the hosted tier in a minute.</p>
          <a class="btn ghost" href="/features/self-host">Read about self-hosting</a>
        </div>
      </section>

      <section class="section reveal" aria-label="Get started">
        <div class="cta-band">
          <h2>Ship with a net under you.</h2>
          <div class="cta-actions">
            <a class="btn primary" data-auth-cta href="/register">Get started</a>
            <a class="btn ghost" href="/use-cases">See use cases</a>
          </div>
        </div>
      </section>

    </main>

    @include('SiteFooter')

    <!-- Reflect auth state: a logged-in visitor (token in localStorage) sees
         "Dashboard" instead of Log in / Sign up. -->
    <script>
      (function () {
        if (!localStorage.getItem('token')) return
        document.querySelectorAll('[data-auth-login]').forEach(function (a) {
          a.textContent = 'Dashboard'
          a.setAttribute('href', '/dashboard')
        })
        document.querySelectorAll('[data-auth-signup]').forEach(function (a) {
          a.style.display = 'none'
        })
        document.querySelectorAll('[data-auth-cta]').forEach(function (a) {
          a.textContent = 'Go to dashboard'
          a.setAttribute('href', '/dashboard')
        })
      })()
    </script>
  </body>
</html>
