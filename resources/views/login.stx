<script server>
// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled

useSeoMeta({
  title: 'Sign in - loghq',
  description: 'Sign in to your loghq account to view your live log stream.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/login' }] })

// OAuth failures come back as ?error= on a full-page redirect from the
// provider. Read here rather than from location.search in a client block: it is
// server-known at render time, so reading it on the client meant the message
// could not exist until hydration.
const oauthError = new URLSearchParams(typeof __stxServeSearch !== 'undefined' ? __stxServeSearch : '').get('error') || ''
</script>

<script client>
// Client-fetch sign-in, matching the uniform HQ auth model (statushq et al).
//
// The page no longer handles its own POST. Sign-in is a same-origin fetch to
// POST /api/auth/login (routes/auth.ts), which on success sets the HttpOnly
// `auth-token` cookie server-side and returns a token in its body; the browser
// then carries that cookie on the full-page navigation to /dashboard. There is
// no client token, no Authorization header and no localStorage.
//
// Written in loghq's own signal idiom (`:model` inputs, `:show`/`:text`
// bindings, @click/@submit handlers) rather than statushq's plain-DOM IIFE.
const mode = state('credentials')
const email = state('')
const password = state('')
const remember = state(false)
const code = state('')
const error = state('')
const loading = state(false)
// The 2FA challenge from step one. Not a signal — nothing renders it, it is
// just carried to the verify request. Plain module state survives between the
// two handler calls.
let challengeToken = ''

async function post(url: string, body: Record<string, unknown>): Promise<{ ok: boolean, status: number, data: any }> {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify(body),
  })
  let data: any = {}
  try { data = await res.json() }
  catch {}
  return { ok: res.ok, status: res.status, data }
}

async function onLogin(e: Event): Promise<void> {
  e.preventDefault()
  error.set('')
  const em = email().trim()
  const pw = password()
  if (!em || !pw) {
    error.set('Enter your email and password.')
    return
  }
  if (loading())
    return
  loading.set(true)
  try {
    const r = await post('/api/auth/login', { email: em, password: pw, remember: remember() ? '1' : '0' })
    if (r.data && r.data.requires_two_factor) {
      // A 2FA-enabled account: carry the challenge to step two. loghq ships no
      // enrolment UI, but the step exists so such an account cannot lock out.
      challengeToken = r.data.challenge_token
      mode.set('twofa')
      return
    }
    if (r.ok && (r.data.token || r.data.access_token)) {
      navigate('/dashboard', { reload: true })
      return
    }
    error.set((r.data && (r.data.message || r.data.error)) || 'Invalid email or password.')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}

async function onVerify(e: Event): Promise<void> {
  e.preventDefault()
  error.set('')
  if (loading())
    return
  loading.set(true)
  try {
    const r = await post('/api/auth/verify-two-factor-login', {
      challenge_token: challengeToken,
      code: code().trim(),
      remember: remember() ? '1' : '0',
    })
    if (r.ok && (r.data.token || r.data.access_token)) {
      navigate('/dashboard', { reload: true })
      return
    }
    // Challenge tokens are single-use; send a failed attempt back to step one.
    error.set((r.data && (r.data.message || r.data.error)) || 'Invalid code - please sign in again.')
    code.set('')
    mode.set('credentials')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>


{{-- Explicit layout binding, per ch.3.4. Without it the page relies on
    the implicit path (process.js:310-338), which applies defaultLayout only
    while the page has no DOCTYPE and then wraps it in a synthetic
    @section('content'). --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Sign in to your account</p>
    </div>

    {{-- The shared error box for both steps. `:text` overwrites the (empty)
        static label after hydration and never cloaks. --}}
    <div :show="!!error()" :text="error()" class="mb-4 px-3 py-2 text-sm rounded-lg err-box"></div>

    {{-- Step 1: credentials. A same-origin fetch, not a native POST — the
        submit is intercepted so the browser never navigates to /login itself. --}}
    <form :show="mode() === 'credentials'" action="/api/auth/login" method="POST" @submit="onLogin" class="space-y-4">
      <div>
        <label for="login-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
        <input id="login-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" :model="email" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="login-password" class="block font-medium text-muted text-xs">Password</label>
          <StxLink to="/forgot-password" class="font-medium text-accent text-xs">Forgot password?</StxLink>
        </div>
        <input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" :model="password" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      {{-- Remember me, default OFF: unchecked is the baseline week, checked is
          30 days (sessionExpiryMinutes reads this on the server). --}}
      <label for="login-remember" class="flex gap-2 items-center text-sm text-subtle cursor-pointer select-none">
        <input id="login-remember" name="remember" type="checkbox" :model="remember" class="h-4 w-4 accent-[var(--accent)]">
        <span>Keep me signed in for 30 days</span>
      </label>

      <button type="submit" :disabled="loading()" :text="loading() ? 'Signing in…' : 'Sign in'" class="py-2.5 w-full font-semibold text-sm btn-solid">Sign in</button>
    </form>

    {{-- Step 2: TOTP, shown only when the account has 2FA enabled. --}}
    <form :show="mode() === 'twofa'" action="/api/auth/verify-two-factor-login" method="POST" @submit="onVerify" class="space-y-4">
      <p class="text-sm text-subtle">Enter the 6-digit code from your authenticator app.</p>
      <div>
        <label for="login-code" class="block mb-1.5 font-medium text-muted text-xs">Authentication code</label>
        <input id="login-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" :model="code" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <button type="submit" :disabled="loading()" :text="loading() ? 'Verifying…' : 'Verify and sign in'" class="py-2.5 w-full font-semibold text-sm btn-solid">Verify and sign in</button>
    </form>

    @if (oauthError)
      <div class="mt-4 px-3 py-2 text-sm rounded-lg err-box">{{ oauthError }}</div>
    @endif

    @if (anyOauth)
    {{-- The two rules on this element were `.divider::before` and
        `.divider::after`. Crosswind generates nothing for a `before:` or
        `after:` utility — verified against the served sheet — so the
        hairlines are real elements rather than pseudo-elements. --}}
    <div class="flex gap-3 items-center my-5 text-[12px] text-subtle">
      <span class="flex-1 h-px bg-line"></span>or<span class="flex-1 h-px bg-line"></span>
    </div>

    {{-- The two SVGs below are the only inline ones left in the app, and they
        stay inline deliberately. Every library icon is an <Icon> now, but
        these are BRAND marks: the Google mark is four fixed brand colours that
        must not inherit currentColor, and neither is in the lucide collection.
        Adding @iconify-json/simple-icons for two marks would be a dependency
        for nothing. Do not "finish the job" by converting them. --}}
    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="mt-6 text-center text-sm text-subtle">
      No account?
      <StxLink to="/register" class="font-medium text-accent">Create one</StxLink>
    </p>
  </div>
</div>
@endsection
