<script server>
// STATIC import, and that is load-bearing — do not turn it into an
// `await import('@stacksjs/auth')` inside the action below.
//
// A static import here is resolved against this project. A dynamic import
// evaluated inside an action's body is resolved in the context of the module
// running it — stx's variable-extractor — and the stx fork's
// node_modules/@stacksjs/auth is a symlink into a SIBLING PROJECT (bughq). So
// the dynamic form loaded another app's auth package, whose `@stacksjs/orm`
// has no User model generated for this database, and `Auth.login` died on
// `User.where is not a function`. Measured, not theorised: the stack trace
// named bughq's path.
import { Auth } from '@stacksjs/auth'

// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled

useSeoMeta({
  title: 'Sign in - loghq',
  description: 'Sign in to your loghq account to view your live log stream.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/login' }] })

// OAuth failures come back as ?error= on a full-page redirect from the
// provider. Read here rather than from location.search in a client block: it is
// server-known at render time, so reading it on the client meant the message
// could not exist until hydration.
const oauthError = new URLSearchParams(__stxServeSearch || '').get('error') || ''

// What the action merges back on a rejected submit, declared with its
// resting values.
//
// Not decoration. On a GET neither name exists at all, so the template's
// `@if (formError)` and `values?.email` were reading undeclared identifiers —
// harmless at runtime, because an undefined name is falsy, but it left the
// page's own contract implicit and unreadable. Declaring them states what the
// action returns and gives the template something real to read on both paths.
// The action's `Object.assign` overwrites these on the POST render.
let formError = ''
let values: { email?: string } = {}

// ---------------------------------------------------------------------------
// The page handles its own POST (stx#1847).
//
// `action` is picked up off the render context, so a plain top-level binding in
// this block is the declaration — and being a function it is dropped by the
// server→client bridge, so it never reaches the HTML.
//
// This is the whole form now. There is no fetch, no preventDefault and no
// client mirror of the error: the browser posts the form, this runs, and either
// a 303 carries the session cookie to /dashboard or the same template
// re-renders with `formError` and `values` merged into its context. That is one
// handler for the scripting-off path and the scripting-on path, which is what
// the app never had — measured in stx#1847, five of five forms inert without
// JavaScript.
//
// `Auth.login` carries the rate limiting with it: `Auth.attempt` calls
// RateLimiter.isRateLimited before verifying and records a failed attempt after,
// keyed by email. So dropping `.rateLimit(5, 'minute')` from the route does not
// drop the protection — it moves into the same function that checks the
// password.
//
// The cookie is deliberately NOT httpOnly. loghq's session store reads
// `loghq_token` with useCookie to attach the bearer to API calls, so making it
// httpOnly here would sign the user in and then leave every client fetch
// unauthenticated. Same name, maxAge and SameSite the store writes, so a
// session established here and one established by the enhanced path are
// indistinguishable afterwards.
const action = async ({ form, request }: { form: Record<string, string | string[]>, request: Request }) => {
  const email = String(form.email ?? '').trim()
  const password = String(form.password ?? '')

  // Cheap checks first, in the same shape the failure path uses, so an empty
  // submit does not cost a database round trip.
  if (!email || !password)
    return { formError: 'Enter your email and password.', values: { email } }

  const result = await Auth.login({ email, password })

  // One message for "no such account" and "wrong password" on purpose — saying
  // which is an account-enumeration oracle. The framework made the same change
  // for its own auth in 0.70.362.
  if (!result?.token)
    return { formError: 'Invalid email or password.', values: { email } }

  return {
    redirect: '/dashboard',
    cookies: {
      loghq_token: {
        value: result.token,
        maxAge: 2592000,
        sameSite: 'Lax',
        path: '/',
        // Secure only where it can be honoured. Setting it unconditionally
        // would make the cookie undeliverable over plain http, which is what
        // local dev serves.
        secure: new URL(request.url).protocol === 'https:',
      },
    },
  }
}
</script>


{{-- Explicit layout binding, per ch.3.4. Without it the page relies on
    the implicit path (process.js:310-338), which applies defaultLayout only
    while the page has no DOCTYPE and then wraps it in a synthetic
    @section('content'). That is fragile in a specific way: the gate is
    `if (!hasDoctype || hasSections)`, so the binding depends on what the
    page does NOT contain. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Sign in to your account</p>
    </div>

    {{-- action and method, so the browser can submit this on its own. The page
        handles its own POST — see the action in the server block — so there is
        no separate endpoint and no handler to keep in step with one. --}}
    <form action="/login" method="POST" class="space-y-4">
      @if (formError)
        <div class="px-3 py-2 text-sm rounded-lg err-box">{{ formError }}</div>
      @endif

      <div>
        <label for="login-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
        <input id="login-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" value="{{ values?.email || '' }}" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="login-password" class="block font-medium text-muted text-xs">Password</label>
          <StxLink to="/forgot-password" class="font-medium text-accent text-xs">Forgot password?</StxLink>
        </div>
        <input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      {{-- The label is a `:text` binding with the resting label written into the
          element, not a `{{ }}` expression in the body. stx cloaks any element
          whose TEXT contains an unresolved expression (misc-directives.ts:228)
          and the cloak rule is `[x-cloak]{display:none !important}` — so the
          form's only submit control was display:none until the client runtime
          booted. `:text` overwrites the static label after hydration and never
          cloaks, so the button is present and pressable at first paint. --}}
      {{-- A plain button. The `:disabled` and `:text` bindings that used to sit
          here read a client mutation's loading flag; with a native submit the
          browser owns that state, and a binding onto a signal this page no
          longer has would have been a dangling expression. The label is static
          markup, so it is present and pressable at first paint rather than
          waiting on hydration to be written. --}}
      <button type="submit" class="py-2.5 w-full font-semibold text-sm btn-solid">Sign in</button>
    </form>

    @if (oauthError)
      <div class="mt-4 px-3 py-2 text-sm rounded-lg err-box">{{ oauthError }}</div>
    @endif

    @if (anyOauth)
    {{-- The two rules on this element were `.divider::before` and
        `.divider::after`. Crosswind generates nothing for a `before:` or
        `after:` utility — verified against the served sheet — so the
        hairlines are real elements rather than pseudo-elements. --}}
    <div class="flex gap-3 items-center my-5 text-[12px] text-subtle">
      <span class="flex-1 h-px bg-line"></span>or<span class="flex-1 h-px bg-line"></span>
    </div>

    {{-- The two SVGs below are the only inline ones left in the app, and they
        stay inline deliberately. Every library icon is an <Icon> now, but
        these are BRAND marks: the Google mark is four fixed brand colours that
        must not inherit currentColor, and neither is in the lucide collection.
        Adding @iconify-json/simple-icons for two marks would be a dependency
        for nothing. Do not "finish the job" by converting them. --}}
    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="mt-6 text-center text-sm text-subtle">
      No account?
      <StxLink to="/register" class="font-medium text-accent">Create one</StxLink>
    </p>
  </div>
</div>
@endsection
