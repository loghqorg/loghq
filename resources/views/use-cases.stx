@extends('layouts/marketing')

<script server>
useSeoMeta({
  title: 'Use cases - loghq',
  description: 'How frontend, backend, mobile, on-call, and agency teams put loghq error tracking to work in production.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/use-cases' }] })

// Breadcrumb trail. One array drives two consumers — the rendered list in
// the Breadcrumbs partial and the BreadcrumbList JSON-LD below — so the
// markup and the structured data cannot disagree. The last crumb has no
// href or url: it is this page.
const crumbs = [
  { label: 'Home', href: '/', url: 'https://loghq.org/' },
  { label: 'Use cases' },
]
</script>

@section('content')
@structuredData({
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.url })),
})

@include('Breadcrumbs')

<section class="feat-hero shell">
  <span class="kicker">Use cases</span>
  <h1>A net under every team that ships to production.</h1>
  <p>The same SDK and the same triage fit a browser bundle, a background worker, or a native app. Here is how different teams lean on loghq, and which features do the work.</p>
  <div class="hero-actions">
    <StxLink class="btn primary" to="/register">Get started</StxLink>
    <StxLink class="btn ghost" to="/docs">Read the docs</StxLink>
  </div>
</section>

<section class="reveal section shell" aria-label="Use cases">
  <div class="usecases">

    <article class="usecase">
      <img src="https://picsum.photos/seed/loghq-frontend-browser/720/340" alt="A web application open in a browser" width="720" height="340" loading="lazy">
      <div class="usecase-body">
        <h2>Frontend</h2>
        <p>Catch the errors your users actually hit in the browser. Upload a source map and every minified frame resolves back to the component and line that threw.</p>
        <StxLink class="textlink" to="/use-cases/frontend">How teams use loghq for frontend</StxLink>
      </div>
    </article>

    <article class="usecase">
      <img src="https://picsum.photos/seed/loghq-backend-api/720/340" alt="Server and API infrastructure" width="720" height="340" loading="lazy">
      <div class="usecase-body">
        <h2>Backend</h2>
        <p>Server, edge, and job failures arrive with the request, release, and environment attached, so a 500 names the route and the deploy that broke it.</p>
        <StxLink class="textlink" to="/use-cases/backend">How teams use loghq for backend</StxLink>
      </div>
    </article>

    <article class="usecase">
      <img src="https://picsum.photos/seed/loghq-mobile-app/720/340" alt="A mobile app on a phone" width="720" height="340" loading="lazy">
      <div class="usecase-body">
        <h2>Mobile</h2>
        <p>Native crashes and JavaScript errors fold into one issue per build, so you see which release regressed and how many devices it reached.</p>
        <StxLink class="textlink" to="/use-cases/mobile">How teams use loghq for mobile</StxLink>
      </div>
    </article>

    <article class="usecase">
      <img src="https://picsum.photos/seed/loghq-oncall-sre/720/340" alt="An on-call engineer reviewing alerts" width="720" height="340" loading="lazy">
      <div class="usecase-body">
        <h2>On-call and SRE</h2>
        <p>Alerts fire for new and spiking issues, not for every known warning. Triage by release and affected-user count instead of scrolling a raw log.</p>
        <StxLink class="textlink" to="/use-cases/on-call">How on-call teams use loghq</StxLink>
      </div>
    </article>

    <article class="usecase">
      <img src="https://picsum.photos/seed/loghq-agency-clients/720/340" alt="Multiple client projects on a board" width="720" height="340" loading="lazy">
      <div class="usecase-body">
        <h2>Agencies</h2>
        <p>Keep each client site as its own project with its own issues, releases, and members, so you know exactly which build on which site started erroring.</p>
        <StxLink class="textlink" to="/use-cases/agencies">How agencies use loghq</StxLink>
      </div>
    </article>

  </div>
</section>

<section class="reveal section shell" aria-label="Get started">
  <div class="cta-band">
    <h2>Ship with a net under you.</h2>
    <div class="cta-actions">
      <StxLink class="btn primary" to="/register">Get started</StxLink>
      <StxLink class="btn ghost" to="/docs">Read the docs</StxLink>
    </div>
  </div>
</section>
@endsection
