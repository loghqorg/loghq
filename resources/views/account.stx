<script server>
useSeoMeta({
  title: 'Account - loghq',
  description: 'Your loghq profile, plan, and sign-in method.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Account page. The profile is fetched client-side from /api/me and was
// previously painted onto the DOM by hand — ~17 element lookups setting text,
// classes, visibility, and one raw HTML insertion. It is all one object, so it
// is one signal now and the markup reads from it.
const user: StxSignal<MeUser | null> = state(null)
const pro = state(false)
const loaded = state(false)

function initial(s: string | null | undefined): string {
  return (s || '?').trim().charAt(0).toUpperCase()
}

function fmtDate(v: string | null | undefined): string {
  if (!v)
    return '--'
  const d = new Date(v)
  return Number.isNaN(d.getTime())
    ? '--'
    : d.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
}

// Derived reads. Plain functions rather than computed(): each is called from a
// binding, which re-evaluates when the signal it reads changes.
const displayName = (): string => user()?.name || 'Your account'
const email = (): string => user()?.email || ''
const avatarUrl = (): string => user()?.avatar || ''
const avatarInitial = (): string => initial(user()?.name || user()?.email)
const provider = (): string => user()?.provider || ''
const memberSince = (): string => fmtDate(user()?.created_at)

function logout(): void {
  // One call. The store owns the token cookie and the cached viewer, and the
  // revoke request is fire-and-forget inside it: the credentials are being
  // discarded either way, so a failed revoke must not strand someone on a page
  // they have already logged out of.
  useStore('session').signOut()
}

// The viewer is fetched once, by the session store, and shared. This page and
// the dashboard used to request /api/me independently and keep their own `pro`
// signal, so moving between them refetched every time and the two copies could
// disagree. These three stay local signals so every binding in the markup below
// is unchanged; they mirror the store.
onMount(() => {
  const session = useStore('session')
  session.loadViewer()
  effect(() => {
    user.set(session.viewer())
    pro.set(session.pro())
    loaded.set(session.viewerLoaded())
  })
})
</script>

<style>
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; }
.btn { border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease, background-color 0.15s ease; font-weight: 600; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn-ghost { border: 1px solid var(--border); color: var(--text); }
.btn-ghost:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.badge { border: 1px solid var(--border); border-radius: 999px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-2); }
.badge-pro { border-color: var(--accent); color: var(--accent); }
.avatar { border-radius: 999px; object-fit: cover; background: color-mix(in srgb, var(--accent) 14%, var(--panel)); }
.row { border-top: 1px solid var(--border); }
.skeleton { background: color-mix(in srgb, var(--text-3) 20%, transparent); border-radius: 6px; animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 0.9; } }
@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
</style>

<div class="min-h-[100dvh]">
  <header class="flex items-center justify-between mx-auto px-5 md:px-6 h-16 max-w-3xl">
    <StxLink to="/" class="text-lg wordmark">loghq</StxLink>
    <div class="flex gap-2.5 items-center">
      <StxLink to="/dashboard" class="px-3.5 py-2 text-sm btn btn-ghost">Dashboard</StxLink>
      <button @click="logout" class="px-3.5 py-2 text-sm btn btn-ghost">Log out</button>
    </div>
  </header>

  {{-- A plain div, deliberately not the main element: resources/layouts/default.stx
      owns the single router container. A second one makes the fragment span
      ambiguous, because the server slices between the first opening main tag
      and the last closing one. Tag names are described rather than spelled
      here — see the note in resources/partials/SiteNav.stx. --}}
  <div class="mx-auto px-5 py-8 md:px-6 max-w-3xl">
    <h1 class="mb-6 text-2xl wordmark">Account</h1>

    <section class="mb-5 p-6 card">
      <div class="flex gap-4 items-center">
        <img class="h-14 w-14 avatar" alt="" width="56" height="56" :show="!!avatarUrl()" :src="avatarUrl()">
        <div class="grid place-items-center h-14 w-14 font-bold text-xl text-accent avatar" :show="!avatarUrl()">{{ avatarInitial() }}</div>
        <div class="min-w-0">
          {{-- Skeleton and value are separate elements rather than one element
              swapping classes: :class works but logs on every bind, and the
              skeleton needs a fixed box the real text must not inherit. --}}
          <div class="skeleton w-[160px] h-5" :show="!loaded()"></div>
          <div class="font-semibold text-lg" :show="loaded()">{{ displayName() }}</div>
          <div class="mt-1.5 text-muted text-sm">{{ email() }}</div>
        </div>
        <span class="ml-auto px-2.5 py-1 badge" :show="!!provider()">{{ provider() }}</span>
      </div>
    </section>

    <section class="mb-5 card">
      <div class="flex items-center justify-between px-6 py-4">
        <div>
          <div class="font-mono text-subtle text-xs tracking-wide uppercase">Plan</div>
          <div class="mt-1 font-semibold text-base">
            {{ pro() ? 'Pro' : 'Free' }}<span class="ml-1 px-2 py-0.5 badge badge-pro" :show="pro()">active</span>
          </div>
        </div>
        {{-- Two anchors rather than one rewritten in place: the pro and free CTAs
            differ in destination, label and variant, so branching the markup is
            clearer than mutating three attributes. --}}
        <StxLink to="/pricing" class="px-4 py-2 text-sm btn btn-primary" :show="!pro()">Upgrade to Pro</StxLink>
        <StxLink to="/pricing" class="px-4 py-2 text-sm btn btn-ghost" :show="pro()">Manage plan</StxLink>
      </div>
      <div class="flex items-center justify-between px-6 py-4 row">
        <div>
          <div class="font-mono text-subtle text-xs tracking-wide uppercase">Member since</div>
          <div class="mt-1 text-base text-muted">{{ memberSince() }}</div>
        </div>
        <StxLink to="/dashboard" class="px-4 py-2 text-sm btn btn-ghost">Open dashboard</StxLink>
      </div>
    </section>

    <p class="text-sm text-subtle">
      Signed in with a private token. <StxLink to="/" class="text-accent">Back to site</StxLink>
    </p>
  </div>
</div>

{{-- Auth guard. Navigation only, renders nothing, and must run before the page is
    usable — a directive would hydrate too late and flash the account shell to a
    signed-out visitor. --}}

@include('AuthGuard')
