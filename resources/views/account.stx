<script server>
useSeoMeta({
  title: 'Account - loghq',
  description: 'Your loghq profile, plan, and sign-in method.',
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Account page. The profile is fetched client-side from /api/me and was
// previously painted onto the DOM by hand — ~17 element lookups setting text,
// classes, visibility, and one raw HTML insertion. It is all one object, so it
// is one signal now and the markup reads from it.
const user = state<MeUser | null>(null)
const pro = state(false)
const loaded = state(false)

function initial(s: string | null | undefined): string {
  return (s || '?').trim().charAt(0).toUpperCase()
}

function fmtDate(v: string | null | undefined): string {
  if (!v)
    return '--'
  const d = new Date(v)
  return Number.isNaN(d.getTime())
    ? '--'
    : d.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
}

// Derived reads. Plain functions rather than computed(): each is called from a
// binding, which re-evaluates when the signal it reads changes.
// Signed in / signed out, decided only once /api/me has answered. Both are
// false while `loaded` is still false, so the page shows its skeleton rather
// than briefly claiming the visitor is signed out.
const signedIn = (): boolean => loaded() && !!user()
const signedOut = (): boolean => loaded() && !user()
const displayName = (): string => user()?.name || 'Your account'
const email = (): string => user()?.email || ''
// A remote avatar can 404 — a revoked GitHub account, a Gravatar that was
// removed, a provider that rotates its CDN paths. Without this the <img> stays
// in the layout and paints the browser's broken-image glyph, which looks like
// the app is broken rather than like the picture is gone. The flag is reset
// whenever the URL changes so a later successful load is not suppressed by an
// earlier failure.
const avatarFailed = state(false)
let lastAvatarUrl = ''

const avatarUrl = (): string => {
  const url = user()?.avatar || ''
  if (url !== lastAvatarUrl) {
    lastAvatarUrl = url
    avatarFailed.set(false)
  }
  return url
}
const avatarOk = (): boolean => !!avatarUrl() && !avatarFailed()
const avatarInitial = (): string => initial(user()?.name || user()?.email)

// A named handler rather than an expression in the attribute — ch.7.7/7.9.
function onAvatarError(): void {
  avatarFailed.set(true)
}
const provider = (): string => user()?.provider || ''
const memberSince = (): string => fmtDate(user()?.created_at)

function logout(): void {
  // One call. The store owns the token cookie and the cached viewer, and the
  // revoke request is fire-and-forget inside it: the credentials are being
  // discarded either way, so a failed revoke must not strand someone on a page
  // they have already logged out of.
  useStore('session').signOut()
}

// --- Two-factor authentication ------------------------------------------
// TOTP enrolment over the same same-origin fetches this page already uses. The
// secret is generated and stashed server-side (/api/auth/generate-two-factor-secret,
// delete-on-read); this page only shows it and sends back the 6-digit code,
// never the secret. The initial on/off is mirrored from /api/me (two_factor_enabled);
// enable/disable flip it locally so there is no reload.
const twoFaEnabled = state(false)
const twoFaBusy = state(false)
const twoFaError = state('')
// { secret, uri } while a setup is mid-flight, null otherwise. Its presence is
// what swaps the panel from the pitch to the confirm form.
const twoFaSetup = state<{ secret: string, uri: string } | null>(null)
const twoFaCode = state('')
const twoFaPassword = state('')
// Once the viewer has toggled 2FA here, stop mirroring the (now stale) viewer
// value over the local flip: the store's cached /api/me still says the old
// state until something refetches it, and the mirror effect must not clobber
// what the person just did.
let twoFaTouched = false

const twoFaOff = (): boolean => signedIn() && !twoFaEnabled() && !twoFaSetup()
const twoFaSettingUp = (): boolean => signedIn() && !twoFaEnabled() && !!twoFaSetup()
const twoFaOn = (): boolean => signedIn() && twoFaEnabled()
const twoFaSecret = (): string => twoFaSetup()?.secret || ''
const twoFaUri = (): string => twoFaSetup()?.uri || ''

/** What generate-two-factor-secret answers with (qr is ignored here). */
interface TwoFaSetupResponse { secret?: string, uri?: string }

async function startTwoFaSetup(): Promise<void> {
  if (twoFaBusy())
    return
  twoFaBusy.set(true)
  twoFaError.set('')
  try {
    const res = await fetch('/api/auth/generate-two-factor-secret', { method: 'POST', credentials: 'same-origin' })
    if (!res.ok) {
      twoFaError.set('Could not start setup. Please try again.')
      return
    }
    const d = await res.json().catch(() => ({})) as TwoFaSetupResponse
    if (!d.secret || !d.uri) {
      twoFaError.set('Could not start setup. Please try again.')
      return
    }
    twoFaCode.set('')
    twoFaSetup.set({ secret: d.secret, uri: d.uri })
  }
  catch {
    twoFaError.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    twoFaBusy.set(false)
  }
}

function cancelTwoFaSetup(): void {
  twoFaSetup.set(null)
  twoFaError.set('')
}

async function confirmTwoFa(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (twoFaBusy())
    return
  const code = twoFaCode().trim()
  // Checked here so a typo answers at once; the server re-verifies against the
  // stashed secret regardless.
  if (!/^\d{6}$/.test(code)) {
    twoFaError.set('Enter the 6-digit code from your authenticator app.')
    return
  }
  twoFaBusy.set(true)
  twoFaError.set('')
  try {
    const res = await fetch('/api/auth/enable-two-factor', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ code }),
    })
    if (!res.ok) {
      twoFaError.set('That code did not match. Check your authenticator app and try again.')
      return
    }
    twoFaTouched = true
    twoFaEnabled.set(true)
    twoFaSetup.set(null)
    twoFaCode.set('')
  }
  catch {
    twoFaError.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    twoFaBusy.set(false)
  }
}

async function disableTwoFa(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (twoFaBusy())
    return
  const password = twoFaPassword()
  if (!password) {
    twoFaError.set('Confirm your password to turn two-factor off.')
    return
  }
  twoFaBusy.set(true)
  twoFaError.set('')
  try {
    const res = await fetch('/api/auth/disable-two-factor', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ password }),
    })
    if (!res.ok) {
      twoFaError.set('Incorrect password. Two-factor is still on.')
      return
    }
    twoFaTouched = true
    twoFaEnabled.set(false)
    twoFaPassword.set('')
  }
  catch {
    twoFaError.set('Could not reach the server. Check your connection and try again.')
  }
  finally {
    twoFaBusy.set(false)
  }
}

// The viewer is fetched once, by the session store, and shared. This page and
// the dashboard used to request /api/me independently and keep their own `pro`
// signal, so moving between them refetched every time and the two copies could
// disagree. These three stay local signals so every binding in the markup below
// is unchanged; they mirror the store.
onMount(() => {
  const session = useStore('session')
  session.loadViewer()
  effect(() => {
    // One batch, three writes. Without it each set() flushes on its own, so a
    // render can observe `loaded` still false while `user` already holds the
    // viewer — the skeleton and the value both showing for a frame. batch()
    // defers the flush until all three have landed.
    batch(() => {
      user.set(session.viewer())
      pro.set(session.pro())
      loaded.set(session.viewerLoaded())
      // Mirror the server's 2FA state until the viewer changes it here; after a
      // local enable/disable, `twoFaTouched` guards the fresh value from being
      // overwritten by the store's still-stale cached viewer.
      if (!twoFaTouched)
        twoFaEnabled.set(session.viewer()?.two_factor_enabled === true)
    })
  })
})
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
{{-- Content measure: max-w-2xl, matching settings.stx.
    The app had four measures across four pages — dashboard 1024, projects 896,
    account 768, settings 672 — so the column resized on every navigation. It
    has three now, and each one is a category rather than a coincidence:

      max-w-5xl  data surfaces (dashboard's five-column log stream, the app list)
      max-w-2xl  the settings-style forms (this page, settings)
      max-w-sm   focused single-purpose cards (sign in, register, new app)

    This page and settings are both stacked forms reached from the same chrome,
    so the 768/672 split between them was the indefensible one. Both header and
    body carry the measure and must move together, or the header stops aligning
    with the content beneath it. --}}
<div class="min-h-[100dvh]">
  <header class="flex items-center justify-between mx-auto px-5 md:px-6 h-16 max-w-2xl">
    <StxLink to="/" class="text-lg wordmark">loghq</StxLink>
    <div class="flex gap-2.5 items-center">
      {{-- This page has no server auth block: the viewer arrives from /api/me
          after paint, so these are bound rather than branched. Ungated, a
          signed-out visitor was offered "Log out", which logs nobody out, above
          a profile card of empty dashes. --}}
      <StxLink to="/dashboard" class="px-3.5 py-2 font-semibold text-ink text-sm border border-line rounded-[10px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :show="signedIn()">Dashboard</StxLink>
      <button @click="logout" class="px-3.5 py-2 font-semibold text-ink text-sm border border-line rounded-[10px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :show="signedIn()">Log out</button>
      <StxLink to="/login" class="px-3.5 py-2 font-semibold text-accent-ink text-sm bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :show="signedOut()">Sign in</StxLink>
    </div>
  </header>

  {{-- A plain div, deliberately not the main element: resources/layouts/default.stx
      owns the single router container. A second one makes the fragment span
      ambiguous, because the server slices between the first opening main tag
      and the last closing one. Tag names are described rather than spelled
      here — see the note in resources/partials/SiteNav.stx. --}}
  <div class="mx-auto px-5 py-8 md:px-6 max-w-2xl">
    <h1 class="mb-6 text-2xl wordmark">Account</h1>

    {{-- The signed-out resting state. Without it this page sat on a skeleton
        name, an empty email and a Free plan badge for a visitor who has no
        account loaded at all, which reads as a broken profile rather than as a
        page that needs signing in to. --}}
    <div class="py-24 text-center" :show="signedOut()">
      <p class="mb-4 text-sm text-subtle">You're signed out.</p>
      <StxLink to="/login" class="inline-block px-4 py-2.5 font-semibold text-accent-ink text-sm bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px]">Sign in</StxLink>
    </div>

    <section class="mb-5 p-6 bg-panel border border-line rounded-[14px]" :show="!signedOut()">
      <div class="flex gap-4 items-center">
        {{-- The initials block is the fallback for BOTH "no avatar" and "the
            avatar failed to load", so the two :show conditions are exact
            complements — avatarOk() and !avatarOk() — and exactly one of the
            pair is ever visible.

            `:src` deliberately has NO static counterpart, unlike every other
            binding in this app. There is no server-known avatar: it arrives
            from /api/me after paint. A static src="" would be worse than
            nothing — the browser resolves an empty src against the current
            URL and requests the page again as an image. The element is hidden
            by :show until avatarOk() is true, so there is no first-paint state
            to encode. --}}
        <img class="object-cover h-14 w-14 bg-[color-mix(in_srgb,var(--accent)_14%,var(--panel))] rounded-[999px]" alt="" width="56" height="56" :show="avatarOk()" :src="avatarUrl()" @error="onAvatarError">
        <div class="grid object-cover place-items-center h-14 w-14 font-bold text-accent text-xl bg-[color-mix(in_srgb,var(--accent)_14%,var(--panel))] rounded-[999px]" :show="!avatarOk()" :text="avatarInitial()"></div>
        <div class="min-w-0">
          {{-- Skeleton and value are separate elements rather than one element
              swapping classes: :class works but logs on every bind, and the
              skeleton needs a fixed box the real text must not inherit. --}}
          <div class="h-5 w-[160px] bg-[color-mix(in_srgb,var(--text-3)_20%,transparent)] rounded-md skeleton-pulse" :show="!loaded()"></div>
          <div class="font-semibold text-lg" :show="loaded()" :text="displayName()"></div>
          <div class="mt-1.5 text-muted text-sm" :text="email()"></div>
        </div>
        <span class="ml-auto px-2.5 py-1 font-mono text-[11px] text-muted tracking-[0.04em] uppercase border border-line rounded-[999px]" :show="!!provider()" :text="provider()"></span>
      </div>
    </section>

    <section class="mb-5 bg-panel border border-line rounded-[14px]" :show="!signedOut()">
      <div class="flex items-center justify-between px-6 py-4">
        <div>
          <div class="font-mono text-subtle text-xs tracking-wide uppercase">Plan</div>
          <div class="mt-1 font-semibold text-base">
            {{-- Its own <span> because the parent also holds the badge below,
                and `:text` on the parent would erase it. Free is the resting
                state: `pro` is false until /api/me answers. --}}
            <span :text="pro() ? 'Pro' : 'Free'">Free</span>{{-- The badge base without its `text-muted`/`border-line`: this is the Pro
                variant and both would fight the accent pair below. `.badge-pro`
                used to win by cascade order inside one <style> block; two
                utilities of equal specificity are decided by their order in the
                GENERATED sheet instead, and text-muted lands after text-accent
                there — the Pro badge came out grey. --}}
                <span class="ml-1 px-2 py-0.5 font-mono text-[11px] text-accent tracking-[0.04em] uppercase border border-accent rounded-[999px]" :show="pro()">active</span>
          </div>
        </div>
        {{-- Two anchors rather than one rewritten in place: the pro and free CTAs
            differ in destination, label and variant, so branching the markup is
            clearer than mutating three attributes. --}}
        <StxLink to="/pricing" class="px-4 py-2 font-semibold text-accent-ink text-sm bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :show="!pro()">Upgrade to Pro</StxLink>
        <StxLink to="/pricing" class="px-4 py-2 font-semibold text-ink text-sm border border-line rounded-[10px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :show="pro()">Manage plan</StxLink>
      </div>
      <div class="flex items-center justify-between px-6 py-4 [border-top:1px_solid_var(--border)]">
        <div>
          <div class="font-mono text-subtle text-xs tracking-wide uppercase">Member since</div>
          <div class="mt-1 text-base text-muted" :text="memberSince()"></div>
        </div>
        <StxLink to="/dashboard" class="px-4 py-2 font-semibold text-ink text-sm border border-line rounded-[10px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]">Open dashboard</StxLink>
      </div>
    </section>

    <section class="mb-5 bg-panel border border-line rounded-[14px]" :show="signedIn()">
      <div class="px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="font-mono text-subtle text-xs tracking-wide uppercase">Two-factor authentication</div>
            <div class="mt-1 font-semibold text-base">
              <span :text="twoFaEnabled() ? 'On' : 'Off'">Off</span>
              <span class="ml-1 px-2 py-0.5 font-mono text-[11px] text-accent tracking-[0.04em] uppercase border border-accent rounded-[999px]" :show="twoFaEnabled()">active</span>
            </div>
          </div>
          <button @click="startTwoFaSetup" :disabled="twoFaBusy()" :aria-busy="twoFaBusy()" :show="twoFaOff()" class="px-4 py-2 font-semibold text-accent-ink text-sm bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :text="twoFaBusy() ? 'Starting...' : 'Set up'">Set up</button>
        </div>

        <div role="alert" :show="!!twoFaError()" :text="twoFaError()" class="mt-3 py-2 err-box notice-box"></div>

        {{-- Off, nothing in progress: the pitch. --}}
        <p class="mt-3 text-muted text-sm" :show="twoFaOff()">Add a second step at sign-in so a stolen password alone cannot open your account. Works with any authenticator app (1Password, Google Authenticator, Authy).</p>

        {{-- Setup mid-flight: the secret and otpauth link, then the code. The
            secret is held server-side for 10 minutes; re-opening setup replaces
            it, so the code must come from the last secret shown. --}}
        <div :show="twoFaSettingUp()">
          <p class="mt-3 text-muted text-sm">Add this secret to your authenticator app, then enter the 6-digit code it shows. The secret is held for 10 minutes.</p>
          <p class="mb-1 mt-3 font-mono text-subtle text-xs tracking-wide uppercase">Secret (enter manually)</p>
          <p class="px-3 py-2 break-all font-mono text-sm tracking-[0.08em] bg-[color-mix(in_srgb,var(--text-3)_8%,transparent)] border border-line rounded-[10px]" :text="twoFaSecret()"></p>
          <p class="mt-2 text-muted text-sm">On this device? <a class="text-accent" :href="twoFaUri()">open in your authenticator app</a> instead of typing it.</p>
          <form @submit="confirmTwoFa" class="mt-4 space-y-3">
            <div>
              <label for="twofa-code" class="block mb-1.5 font-medium text-muted text-xs">6-digit code</label>
              <input id="twofa-code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required placeholder="000000" :model="twoFaCode" class="px-3.5 py-2.5 max-w-[12rem] w-full font-mono text-sm tracking-[0.3em] field">
            </div>
            <div class="flex gap-2.5 items-center">
              <button type="submit" :disabled="twoFaBusy()" :aria-busy="twoFaBusy()" class="px-4 py-2 font-semibold text-accent-ink text-sm bg-accent hover:bg-[color-mix(in_srgb,var(--accent)_88%,#000)] rounded-[10px] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :text="twoFaBusy() ? 'Confirming...' : 'Confirm and enable'">Confirm and enable</button>
              <button type="button" @click="cancelTwoFaSetup" :disabled="twoFaBusy()" class="px-4 py-2 font-semibold text-ink text-sm border border-line rounded-[10px] hover:border-[color-mix(in_srgb,var(--accent)_45%,var(--border))] active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]">Cancel</button>
            </div>
          </form>
        </div>

        {{-- Enabled: offer to turn off, password re-confirmed server-side. --}}
        <form @submit="disableTwoFa" class="mt-3 space-y-3" :show="twoFaOn()">
          <p class="text-muted text-sm">Sign-in needs your password plus a code from your authenticator app. Confirm your password to turn this off.</p>
          <div>
            <label for="twofa-off-password" class="block mb-1.5 font-medium text-muted text-xs">Password</label>
            <input id="twofa-off-password" name="password" type="password" autocomplete="current-password" required placeholder="Confirm your password" :model="twoFaPassword" class="px-3.5 py-2.5 max-w-sm w-full text-sm field">
          </div>
          <button type="submit" :disabled="twoFaBusy()" :aria-busy="twoFaBusy()" class="px-4 py-2 font-semibold text-danger text-sm border border-line rounded-[10px] hover:border-danger active:translate-y-px [transition:transform_0.12s_ease,opacity_0.15s_ease,background-color_0.15s_ease]" :text="twoFaBusy() ? 'Turning off...' : 'Turn off two-factor'">Turn off two-factor</button>
        </form>
      </div>
    </section>

    <p class="text-sm text-subtle" :show="!signedOut()">
      Signed in with a private token. <StxLink to="/" class="text-accent">Back to site</StxLink>
    </p>
  </div>
</div>

@endsection
