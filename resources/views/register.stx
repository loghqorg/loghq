<script server>
// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled

useSeoMeta({
  title: 'Create your account - loghq',
  description: 'Create a loghq account and start streaming structured logs from any app that can make an HTTP request.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/register' }] })
</script>

<script client>
// Token auth via stx client directives (hydrated on the served page). Inputs are
// uncontrolled and read from the submit event; error/loading are signals.
const error = state('')

// Invite links are /register?email=…&invite=…. Read once at hydration: the
// invitee must sign up as the exact person invited, so the email is prefilled
// and locked. `invitedEmail` only prefills the DOM value — the field stays
// uncontrolled, so handleSubmit still reads it from form.elements.
const inviteParams = new URLSearchParams(location.search)
const invitedEmail = state(inviteParams.get('email') || '')
const isInvite = state(!!inviteParams.get('invite'))

// See login.stx for why `error` is a page signal and not the primitive's own.
const signUp = useMutation('/register', {
  onError(err: { data?: { message?: string } }) {
    error.set(err.data?.message || 'Could not create the account.')
  },
  onSuccess(data: { token?: string, access_token?: string, user?: unknown }) {
    // One write. The cookie IS the session — every server-rendered page
    // authenticates from it — so there is no localStorage copy to mirror.
    useStore('session').token.set(data.token || data.access_token || '')
    // Through the store, not localStorage directly: `user` is a useLocalStorage
    // signal the session store owns, so a raw setItem wrote the same key behind
    // the signal's back and nothing subscribed re-rendered.
    if (data.user)
      useStore('session').user.set(data.user)
    // New accounts have no apps yet: go to create-app — unless they arrived from
    // an invite link, in which case land on the dashboard where the join banner
    // is waiting. Read from inviteParams, parsed once at hydration above.
    navigate(inviteParams.get('invite') ? '/dashboard' : '/projects/new')
  },
})

// The controls this handler reads. See login.stx for why the type is declared
// inline rather than in types/app.d.ts, and why the cast is on `target`.
interface SignUpForm extends HTMLFormElement {
  elements: HTMLFormControlsCollection & {
    name: HTMLInputElement
    email: HTMLInputElement
    password: HTMLInputElement
  }
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (signUp.loading())
    return
  const form = e.target as SignUpForm
  if (form.elements.password.value.length < 8) {
    error.set('Password must be at least 8 characters.')
    return
  }
  error.set('')
  await signUp.mutate({
    name: form.elements.name.value,
    email: form.elements.email.value,
    password: form.elements.password.value,
  }).catch(() => {})
}
</script>
{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Create your account</p>
    </div>

    @if (isInvite())
      <p class="mb-3.5 invite-hint">You've been invited to a project — sign up to join it.</p>
    @endif

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="px-3 py-2 text-sm rounded-lg err-box">{{ error() }}</div>
      @endif

      <div>
        <label for="register-name" class="block mb-1.5 font-medium text-muted text-xs">Name</label>
        <input id="register-name" name="name" type="text" required autocomplete="name" placeholder="Ada Lovelace" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label for="register-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
        <input id="register-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field" :value="invitedEmail()" :readonly="!!invitedEmail()" :style="invitedEmail() ? 'opacity:0.85' : ''">
      </div>
      <div>
        <label for="register-password" class="block mb-1.5 font-medium text-muted text-xs">Password</label>
        <input id="register-password" name="password" type="password" required autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      {{-- Static label + `:text`, never `{{ }}` in the body — see login.stx. --}}
      <button type="submit" :disabled="signUp.loading()" :text="signUp.loading() ? 'Creating account…' : 'Create account'" class="py-2.5 w-full font-semibold text-sm btn-solid">Create account</button>
    </form>

    @if (anyOauth)
    {{-- The two rules on this element were `.divider::before` and
        `.divider::after`. Crosswind generates nothing for a `before:` or
        `after:` utility — verified against the served sheet — so the
        hairlines are real elements rather than pseudo-elements. --}}
    <div class="flex gap-3 items-center my-5 text-[12px] text-subtle">
      <span class="flex-1 h-px bg-line"></span>or<span class="flex-1 h-px bg-line"></span>
    </div>

    {{-- Brand marks, kept inline on purpose — same reasoning as login.stx. --}}
    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="mt-6 text-center text-sm text-subtle">
      Already have an account?
      <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
    </p>
  </div>
</div>
@endsection
