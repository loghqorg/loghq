<script server>
// Static, not a dynamic import inside the action — see the note in login.stx:
// the dynamic form resolves through stx's own node_modules, which links into a
// sibling project, and loads an auth package whose ORM has no model for this
// database.
import { register } from '@stacksjs/auth'
// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled

useSeoMeta({
  title: 'Create your account - loghq',
  description: 'Create a loghq account and start streaming structured logs from any app that can make an HTTP request.',
  ogImage: 'https://loghq.org/og.png',
})
useHead({ link: [{ rel: 'canonical', href: 'https://loghq.org/register' }] })

// Invite context, read on the server so it is part of the first render rather
// than something hydration adds.
//
// It has to survive the POST too. The form posts to /register with no query
// string, so both values are carried as hidden inputs below — that is the
// no-JS equivalent of the client reading location.search on every submit.
const __regQuery = new URLSearchParams(__stxServeSearch || '')
const isInvite = !!__regQuery.get('invite')
const invitedEmail = __regQuery.get('email') || ''

// Resting values for what the action merges back on a rejected submit.
let formError = ''
let values: { name?: string, email?: string } = {}

// The page handles its own POST (stx#1847). Same contract as login.stx: a 303
// carrying the session cookie, or a context merge that redraws this template
// with the message and the fields still filled.
const action = async ({ form, request }: { form: Record<string, string | string[]>, request: Request }) => {
  const name = String(form.name ?? '').trim()
  const email = String(form.email ?? '').trim()
  const password = String(form.password ?? '')
  const invited = !!String(form.invite ?? '')
  const kept = { name, email }

  if (!name || !email || !password)
    return { formError: 'Fill in your name, email and password.', values: kept }
  if (password.length < 8)
    return { formError: 'Password must be at least 8 characters.', values: kept }

  // `register` throws an HttpError for an invalid address, a short password or
  // a duplicate. Its duplicate message is deliberately vague — the framework
  // treats "this email exists" as an enumeration oracle — so it is surfaced
  // as-is rather than replaced with something more specific.
  let result
  try {
    result = await register({ name, email, password })
  }
  catch (err) {
    return { formError: (err as Error)?.message || 'Could not create the account.', values: kept }
  }

  if (!result?.token)
    return { formError: 'Could not create the account.', values: kept }

  // An invited user goes straight to the dashboard — the project already
  // exists, they were asked to join it. Everyone else has no project yet, so
  // they land on the create-your-first-app page.
  return {
    redirect: invited ? '/dashboard' : '/projects/new',
    cookies: {
      loghq_token: {
        value: result.token,
        maxAge: 2592000,
        sameSite: 'Lax',
        path: '/',
        secure: new URL(request.url).protocol === 'https:',
      },
    },
  }
}
</script>

{{-- Explicit layout binding — ch.3.4. See login.stx for why the implicit
    path is not relied on. --}}
@extends('layouts/default')

@section('content')
<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">loghq</StxLink>
      <p class="mt-2 text-sm text-subtle">Create your account</p>
    </div>

    @if (isInvite)
      <p class="mb-3.5 invite-hint">You've been invited to a project — sign up to join it.</p>
    @endif

    {{-- Posts to itself; the action in the server block handles it. --}}
    <form action="/register" method="POST" class="space-y-4">
      {{-- The invite context, carried across the POST. Without these the query
          string is lost on submit and an invited user would be sent to
          /projects/new to create a project they were invited to. --}}
      @if (isInvite)<input type="hidden" name="invite" value="1">@endif
      @if (formError)
        <div class="px-3 py-2 text-sm rounded-lg err-box">{{ formError }}</div>
      @endif

      <div>
        <label for="register-name" class="block mb-1.5 font-medium text-muted text-xs">Name</label>
        <input id="register-name" name="name" type="text" required autocomplete="name" placeholder="Ada Lovelace" value="{{ values?.name || '' }}" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label for="register-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
        <input id="register-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" value="{{ values?.email || invitedEmail }}" {{ invitedEmail ? 'readonly' : '' }} class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <label for="register-password" class="block mb-1.5 font-medium text-muted text-xs">Password</label>
        <input id="register-password" name="password" type="password" required autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      {{-- A plain button with a static label. The loading bindings that were
          here read a client mutation this page no longer has. --}}
      <button type="submit" class="py-2.5 w-full font-semibold text-sm btn-solid">Create account</button>
    </form>

    @if (anyOauth)
    {{-- The two rules on this element were `.divider::before` and
        `.divider::after`. Crosswind generates nothing for a `before:` or
        `after:` utility — verified against the served sheet — so the
        hairlines are real elements rather than pseudo-elements. --}}
    <div class="flex gap-3 items-center my-5 text-[12px] text-subtle">
      <span class="flex-1 h-px bg-line"></span>or<span class="flex-1 h-px bg-line"></span>
    </div>

    {{-- Brand marks, kept inline on purpose — same reasoning as login.stx. --}}
    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="mt-6 text-center text-sm text-subtle">
      Already have an account?
      <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
    </p>
  </div>
</div>
@endsection
