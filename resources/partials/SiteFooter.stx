    <div class="flex flex-col gap-[0.6rem] footer-col">
      <h4 class="footer-head">Resources</h4>
      <StxLink class="footer-link" to="/docs">Docs</StxLink>
      <StxLink class="footer-link" to="/pricing">Pricing</StxLink>
      <a class="footer-link" href="https://github.com/stacksjs/loghq">GitHub</a>
      <StxLink class="footer-link" to="/login" :show="!isAuthed()">Log in</StxLink>
      {{-- Inline display:none is the `:show` initial state and cannot be a
          `hidden` utility — see the explanation in SiteNav.stx. --}}
      <StxLink class="footer-link" to="/dashboard" :show="isAuthed()" style="display:none">Dashboard</StxLink>
      <StxLink class="footer-link" :show="!isAuthed()" to="/register">Get started</StxLink>
    </div>
  </div>

  <div class="footer-bottom">
    <StxLink class="brand" to="/" aria-label="loghq home">
      <span class="brand-mark">l</span>
      <span class="brand-name">loghq</span>
