<script server>
// Server-decided auth, same as SiteNav — see the fuller note there. These three
// links were `:show` bindings on a client signal, and every `:show` element is
// stamped `x-cloak`, so the footer's auth links were display:none until the
// runtime booted on every marketing page.
//
// Each partial owns its own copy: a partial's scope does not reach across
// includes, and this is one boolean rather than a signal plus an onMount plus an
// effect.
const footerAuthed = !!cookies.loghq_token
</script>

<footer class="footer shell">
  {{-- The two source rules were `@media (max-width: 900px)` and
      `(max-width: 560px)`. Crosswind emits nothing for a max-width
      variant, so this is the same design stated mobile-first: one column
      by default, two from bp-sm (561px), the 1.4fr lead column from bp-md
      (901px). The breakpoints are declared in config/crosswind.ts and sit
      one pixel above the max-widths they replace, which is what keeps the
      boundaries identical. --}}
  <div class="grid gap-x-8 gap-y-7 grid-cols-1 bp-md:gap-x-10 bp-md:gap-y-8 bp-md:grid-cols-[1.4fr_1fr_1fr_1fr] bp-sm:grid-cols-2 pb-9 pt-4 footer-cols">
    <div class="flex flex-col gap-[0.6rem] footer-col">
      <h4 class="footer-head">Product</h4>
      <StxLink class="footer-link" to="/features/capture">Automatic capture</StxLink>
      <StxLink class="footer-link" to="/features/grouping">Fingerprint grouping</StxLink>
      <StxLink class="footer-link" to="/features/stack-traces">Readable stack traces</StxLink>
      <StxLink class="footer-link" to="/features/releases">Releases and environments</StxLink>
      <StxLink class="footer-link" to="/features/alerts">Alerts and triage</StxLink>
      <StxLink class="footer-link" to="/features/self-host">Self-hosting</StxLink>
    </div>

    <div class="flex flex-col gap-[0.6rem] footer-col">
      <h4 class="footer-head">Use cases</h4>
      <StxLink class="footer-link" to="/use-cases">All use cases</StxLink>
      <StxLink class="footer-link" to="/use-cases/frontend">Frontend</StxLink>
      <StxLink class="footer-link" to="/use-cases/backend">Backend</StxLink>
      <StxLink class="footer-link" to="/use-cases/mobile">Mobile</StxLink>
      <StxLink class="footer-link" to="/use-cases/on-call">On-call and SRE</StxLink>
      <StxLink class="footer-link" to="/use-cases/agencies">Agencies</StxLink>
    </div>

    <div class="flex flex-col gap-[0.6rem] footer-col">
      <h4 class="footer-head">Compare</h4>
      <StxLink class="footer-link" to="/compare">All alternatives compared</StxLink>
      <StxLink class="footer-link" to="/compare/sentry">loghq vs Sentry</StxLink>
      <StxLink class="footer-link" to="/compare/bugsnag">loghq vs Bugsnag</StxLink>
      <StxLink class="footer-link" to="/compare/rollbar">loghq vs Rollbar</StxLink>
