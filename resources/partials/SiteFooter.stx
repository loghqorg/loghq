      <StxLink to="/features/releases">Releases and environments</StxLink>
      <StxLink to="/features/alerts">Alerts and triage</StxLink>
      <StxLink to="/features/self-host">Self-hosting</StxLink>
    </div>

    <div class="footer-col">
      <h4>Use cases</h4>
      <StxLink to="/use-cases">All use cases</StxLink>
      <StxLink to="/use-cases/frontend">Frontend</StxLink>
      <StxLink to="/use-cases/backend">Backend</StxLink>
      <StxLink to="/use-cases/mobile">Mobile</StxLink>
      <StxLink to="/use-cases/on-call">On-call and SRE</StxLink>
      <StxLink to="/use-cases/agencies">Agencies</StxLink>
    </div>

    <div class="footer-col">
      <h4>Compare</h4>
      <StxLink to="/compare">All alternatives compared</StxLink>
      <StxLink to="/compare/sentry">loghq vs Sentry</StxLink>
      <StxLink to="/compare/bugsnag">loghq vs Bugsnag</StxLink>
      <StxLink to="/compare/rollbar">loghq vs Rollbar</StxLink>
      <StxLink to="/compare/raygun">loghq vs Raygun</StxLink>
      <StxLink to="/compare/honeybadger">loghq vs Honeybadger</StxLink>
      <StxLink to="/compare/airbrake">loghq vs Airbrake</StxLink>
      <StxLink to="/compare/glitchtip">loghq vs GlitchTip</StxLink>
      <StxLink to="/compare/datadog">loghq vs Datadog</StxLink>
    </div>

    <div class="footer-col">
      <h4>Resources</h4>
      <StxLink to="/docs">Docs</StxLink>
      <StxLink to="/pricing">Pricing</StxLink>
      <a href="https://github.com/stacksjs/loghq">GitHub</a>
      <StxLink to="/login" :show="!isAuthed()">Log in</StxLink>
    <StxLink to="/dashboard" :show="isAuthed()" style="display:none">Dashboard</StxLink>
      <StxLink :show="!isAuthed()" to="/register">Get started</StxLink>
    </div>
  </div>

  <div class="footer-bottom">
    <StxLink class="brand" to="/" aria-label="loghq home">
      <span class="brand-mark">l</span>
      <span class="brand-name">loghq</span>
    </StxLink>
    <span>Open source log streaming, built on Stacks and Postgres.</span>
  </div>
</footer>

