<script client>
// Auth-aware nav. Login/register write the token to localStorage (and mirror it
// to a cookie so server-rendered pages authenticate), so this reads it once at
// hydration. Not reactive to a login in another tab — logging in navigates, so
// the next render picks it up.
//
// This lives in the partial rather than in each page on purpose. It used to be a
// script in index.stx only, which meant a logged-in visitor saw "Dashboard" on
// the homepage and "Log in / Sign up" on all 20+ other pages that include this
// nav. One source of truth for the markup deserves one for its state.
const isAuthed = state(false)
// The store owns the token; this mirrors its derived isAuthed so the markup
// stays a binding. Read inside onMount because useStore is NOT in the
// usesSignals trigger list — a client script whose only stx call is useStore()
// gets the immediate IIFE form instead of the mount wrapper and runs before the
// store bundle registers. onMount is a trigger, so this guarantees the wrapper.
onMount(() => {
  const session = useStore('session')
  effect(() => isAuthed.set(session.isAuthed()))
})
//
// NOTE ON COMMENTS IN THIS FILE: this used to say that a partial containing a
// client script never has its template comments stripped, so the prose shipped
// in the response body of all 23 pages including this nav. That is no longer
// true on stx 0.2.152. Re-measured after the version bump: the template
// comments in the markup below are stripped server-side, and grepping the
// served HTML of /, /pricing, /compare/sentry and /features/alerts for their
// text returns zero, with no comment marker anywhere in the body. Template
// comments are safe here again. Re-check on the next stx bump.
//
// Do NOT write a template comment's opening marker as prose, in this or any
// other file, not even inside a JS line comment like this one and not even in
// backticks. The renderer scans for it textually: an unpaired opening marker
// here opened a comment that ran to end of file, swallowed the closing script
// tag and the entire <nav>, and every marketing page rendered as a bare
// footer. The dev server said so plainly — "<script> 1 opened, 0 closed" —
// which is the fastest way to spot it. Describe the syntax; never quote it.
</script>

<nav class="nav">
  <div class="nav-inner shell">
    <StxLink class="brand" to="/" aria-label="loghq home">
      <span class="brand-mark">l</span>
      <span class="brand-name">loghq</span>
    </StxLink>

    <div class="nav-links" aria-label="Primary navigation">
      <div class="mega">
        <StxLink class="mega-trigger" to="/#features" aria-haspopup="true">Features</StxLink>
        <div class="mega-panel" role="menu" aria-label="Features">
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/features/capture"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Automatic capture</span><span class="text-subtle text-[0.8rem] leading-[1.4]">One init call captures every uncaught error with full context.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/features/stack-traces"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Readable stack traces</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Source maps turn minified frames back into your code.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/features/grouping"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Fingerprint grouping</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Identical errors fold into one issue with a live count.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/features/alerts"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Alerts and triage</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Told when an issue is new or spiking, quiet for the rest.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/features/releases"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Releases and environments</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Tag every event so a regression names its own deploy.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/features/self-host"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Self-hosting</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Open source, on your own Postgres. Data stays with you.</span></StxLink>
        </div>
      </div>

      <div class="mega">
        <StxLink class="mega-trigger" to="/use-cases" aria-haspopup="true">Use cases</StxLink>
        <div class="mega-panel" role="menu" aria-label="Use cases">
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/use-cases"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">All use cases</span><span class="text-subtle text-[0.8rem] leading-[1.4]">How different teams put loghq to work in production.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/use-cases/frontend"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Frontend</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Catch browser errors with source-mapped traces.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/use-cases/backend"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Backend</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Server, edge, and job errors tied to the request.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/use-cases/mobile"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Mobile</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Native crashes grouped by build and release.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/use-cases/on-call"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">On-call and SRE</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Alert on new and spiking issues, not known noise.</span></StxLink>
          <StxLink class="flex flex-col gap-[0.2rem] px-[0.72rem] py-[0.62rem] rounded-[var(--r-sm)] hover:bg-[var(--surface-2)]" role="menuitem" to="/use-cases/agencies"><span class="text-ink text-[0.9rem] font-semibold tracking-[-0.01em]">Agencies</span><span class="text-subtle text-[0.8rem] leading-[1.4]">Every client site as its own isolated project.</span></StxLink>
        </div>
      </div>

      <StxLink to="/pricing">Pricing</StxLink>
      <StxLink to="/docs">Docs</StxLink>
      <a href="https://github.com/stacksjs/loghq">GitHub</a>
    </div>

    <StxLink to="/login" class="nav-login" :show="!isAuthed()">Log in</StxLink>
    {{-- `style="display:none"` is required here and must NOT become a `hidden`
         utility, despite ch.11.5. It is the server-rendered initial state for
         `:show`, and `:show` drives the inline declaration specifically: when
         the expression turns true the runtime CLEARS the style attribute back
         to "" rather than writing `display:block` (verified in the browser —
         an authed page reports style="" on this link). A `hidden` class would
         survive that clearing, so the link would never appear once signed in.
         The default is hidden rather than shown so the link does not flash for
         signed-out visitors during hydration. --}}
    <StxLink to="/dashboard" class="nav-login" :show="isAuthed()" style="display:none">Dashboard</StxLink>
    <StxLink class="btn nav-cta primary sm" :show="!isAuthed()" to="/register">Sign up</StxLink>

    <details class="nav-menu">
      <summary aria-label="Open menu"><span class="burger" aria-hidden="true"></span></summary>
      <div class="nav-menu-panel">
